---
import '@/styles/global.css';

/** Page-level layout: shared head + global stylesheet. Typography comes from
 * the system font stack (no remote font fetch). */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
