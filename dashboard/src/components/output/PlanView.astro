---
import StatusPill from './StatusPill.astro';
import type { OutputSummary } from '@/lib/output/types';

/**
 * Plan view. The body is a markdown checklist (`- [ ]` / `- [x]`); we
 * parse the raw body for those tokens to compute progress, and render the
 * body through the HTML pass so the checkboxes appear as plain text (the
 * dashboard doesn't toggle them — that's a follow-up).
 */
interface Props {
  meta: OutputSummary;
  body: string;
  bodyHtml: string;
}

const { meta, body, bodyHtml } = Astro.props;
const goal = typeof meta.extras['goal'] === 'string' ? meta.extras['goal'] : meta.slug;
const owner = typeof meta.extras['owner'] === 'string' ? meta.extras['owner'] : null;

// Parse the raw body for the canonical checklist markers. Lines like
// `- [ ] step` (open) and `- [x] step` (done) — case-insensitive on the x.
const checklistLines = body
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => /^- \[[ xX]\]/.test(line));
const completed = checklistLines.filter((line) => /^- \[[xX]\]/.test(line)).length;
const total = checklistLines.length;
const percent = total === 0 ? 0 : Math.round((completed / total) * 100);
---

<article class="out-detail">
  <header class="out-head">
    <div class="out-title-row">
      <h1>{goal}</h1>
      <StatusPill status={meta.status} />
    </div>
    <div class="out-meta">
      <code>{meta.path}</code>
      <span class="dot">·</span>
      <span>updated {meta.updated}</span>
      {owner && (
        <>
          <span class="dot">·</span>
          <span>owner: {owner}</span>
        </>
      )}
    </div>
  </header>

  {total > 0 && (
    <div class="plan-progress">
      <div class="progress-meta">
        <span class="progress-text">{completed} of {total} done</span>
        <span class="progress-pct">{percent}%</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style={`width: ${percent}%`}></div>
      </div>
    </div>
  )}

  <div class="prose" set:html={bodyHtml}></div>
</article>

<style>
  .out-detail {
    margin-top: 1.4rem;
  }
  .out-head {
    margin-bottom: 1.2rem;
  }
  .out-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .out-title-row h1 {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    line-height: 1.3;
  }
  .out-meta {
    font-family: ui-monospace, monospace;
    font-size: 11.5px;
    color: var(--ink-muted);
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .out-meta code {
    background: none;
    padding: 0;
    color: var(--ink-faint);
    font-size: 11px;
  }
  .out-meta .dot {
    color: var(--ink-faint);
  }
  .plan-progress {
    margin-bottom: 1.4rem;
    padding: 0.8rem 1rem;
    background: var(--surface-mute);
    border-radius: 3px;
  }
  .progress-meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--ink-muted);
    margin-bottom: 0.45rem;
    letter-spacing: 0.04em;
  }
  .progress-pct {
    font-family: ui-monospace, monospace;
    color: var(--ink);
  }
  .progress-track {
    height: 4px;
    background: var(--surface-deep);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--ink);
    transition: width 0.2s ease;
  }
  /* The plan body wears the canonical `.prose` class — typography lives in
     global.css. Plans are markdown checklists (`- [ ]` / `- [x]`), so strip
     the bullet from the top-level list — the bracket-tokens themselves carry
     the visual marker. */
  .out-detail .prose {
    max-width: 720px;
  }
  .out-detail .prose ul {
    list-style: none;
    padding-left: 0;
  }
  .out-detail .prose li {
    margin: 0.3rem 0;
  }
</style>
