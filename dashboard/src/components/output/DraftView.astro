---
import OutputDetail from './OutputDetail.astro';
import { draftActionsFor, type ReadyCommit } from '@/lib/output/approval';
import type { OutputSummary } from '@/lib/output/types';
import { formatIsoDate, formatIsoTime } from '@/lib/ui/time';

/**
 * Email-envelope view for a `draft` output. Renders the To / Channel /
 * Subject header rows above the body, then the operator actions:
 *
 *  - **Approve** (draft / review) POSTs {status: 'ready'} — an operator-
 *    attributed commit that roles treat as "approved to act on".
 *  - **Mark as sent** (draft / review / ready) POSTs {status: 'sent'} — the
 *    framework does NOT send anything; the operator handles delivery, this
 *    just records that delivery happened.
 *
 * When the status is `ready`, an approval line shows who set it and when,
 * from the git history of the file (`readyCommit`), and flags a `ready` the
 * role set itself.
 */
interface Props {
  meta: OutputSummary;
  bodyHtml: string;
  /** Commit that set `status: ready`; null when unknown or not ready. */
  readyCommit?: ReadyCommit | null;
}

const { meta, bodyHtml, readyCommit = null } = Astro.props;
const recipient = typeof meta.extras['recipient'] === 'string' ? meta.extras['recipient'] : null;
const channel = typeof meta.extras['channel'] === 'string' ? meta.extras['channel'] : null;
const subject = typeof meta.extras['subject'] === 'string' ? meta.extras['subject'] : null;

const { canApprove, canMarkSent, approved } = draftActionsFor(meta.status);
const readyWhen = readyCommit
  ? `${formatIsoDate(readyCommit.date)} ${formatIsoTime(readyCommit.date)}`
  : '';
const updateUrl = `/api/output/${meta.type}/${meta.slug}`;
---

<div data-update-url={updateUrl} class="draft-wrap">
  <OutputDetail
    title={subject ?? meta.slug}
    status={meta.status}
    path={meta.path}
    updated={meta.updated}
    divider={false}
    titleSize="md"
  >
    <dl class="envelope">
      {recipient && (
        <>
          <dt>To</dt>
          <dd>{recipient}</dd>
        </>
      )}
      {channel && (
        <>
          <dt>Via</dt>
          <dd>{channel}</dd>
        </>
      )}
      {subject && (
        <>
          <dt>Subject</dt>
          <dd>{subject}</dd>
        </>
      )}
    </dl>

    <div class="prose" set:html={bodyHtml}></div>

    {approved && (
      <p class:list={['approval', readyCommit && !readyCommit.byOperator && 'not-operator']}>
        {!readyCommit && 'Approved'}
        {readyCommit?.byOperator && (
          <>
            Approved by {readyCommit.authorName} · {readyWhen}
          </>
        )}
        {readyCommit && !readyCommit.byOperator && (
          <>
            Marked ready by the role · {readyWhen} · not operator-approved
          </>
        )}
      </p>
    )}

    {(canApprove || canMarkSent) && (
      <div class="out-actions">
        {canApprove && (
          <button type="button" class="action-btn" data-action="set-status" data-status="ready">
            Approve
          </button>
        )}
        {canMarkSent && (
          <button type="button" class="action-btn" data-action="set-status" data-status="sent">
            Mark as sent
          </button>
        )}
        <span class="action-hint" data-status-msg></span>
      </div>
    )}
  </OutputDetail>
</div>

<script is:inline>
  (function () {
    const wrap = document.currentScript?.previousElementSibling;
    if (!wrap || !(wrap instanceof HTMLElement)) return;
    const buttons = wrap.querySelectorAll('[data-action="set-status"]');
    const msg = wrap.querySelector('[data-status-msg]');
    const url = wrap.dataset['updateUrl'];
    if (!url) return;
    buttons.forEach((button) => {
      if (!(button instanceof HTMLElement)) return;
      const status = button.dataset['status'];
      if (!status) return;
      button.addEventListener('click', async () => {
        if (msg) msg.textContent = 'updating…';
        buttons.forEach((b) => b.setAttribute('disabled', 'disabled'));
        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status }),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.error || `Update failed (${res.status})`);
          }
          window.location.reload();
        } catch (e) {
          if (msg) msg.textContent = e instanceof Error ? e.message : String(e);
          buttons.forEach((b) => b.removeAttribute('disabled'));
        }
      });
    });
  })();
</script>

<style>
  .envelope {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 0.35rem 1rem;
    margin: 0 0 1.4rem;
    padding: 0.9rem 1.1rem;
    background: var(--surface-mute);
    border-radius: 3px;
    font-size: 13.5px;
  }
  .envelope dt {
    color: var(--ink-muted);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }
  .envelope dd {
    margin: 0;
    color: var(--ink);
  }
  /* The draft body wears the canonical `.prose` class — typography lives in
     global.css. The envelope-letter feel comes from the rule-bar on the left
     and a slightly tighter column. */
  .prose {
    max-width: 680px;
    padding: 0.2rem 0 0.2rem 0.4rem;
    border-left: 2px solid var(--rule);
  }
  .approval {
    margin: 1.6rem 0 0;
    font-size: 13px;
    color: var(--ink);
  }
  .approval.not-operator {
    color: var(--ink-muted);
  }
  .out-actions {
    margin-top: 1.6rem;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }
  .action-btn {
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    padding: 0.4rem 0.95rem;
    font-family: inherit;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
  }
  .action-btn:hover:not(:disabled) {
    background: var(--ink);
    color: var(--surface);
  }
  .action-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .action-hint {
    font-size: 12px;
    color: var(--ink-muted);
  }
</style>
