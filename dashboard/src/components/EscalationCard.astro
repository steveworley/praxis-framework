---
import type { EscalationEntry } from '@/lib/escalations-loader';
import { renderMarkdown } from '@/lib/markdown';

/** Single-row escalation card with status/urgency pills and optional inlined
 * proposed-skill draft. Rendered server-side; the toggle uses a tiny inline
 * script for show/hide because hydrating an island for one button is wasteful. */
interface Props {
  escalation: EscalationEntry;
}

const { escalation: e } = Astro.props;
const meta: string[] = [];
if (e.created) meta.push(e.created);
if (e.agent_context) meta.push(`from ${e.agent_context}`);

const bodyHtml = renderMarkdown(e.body);
const draftHtml = e.proposed_skill_body ?? null;
const draftMissing = e.kind === 'proposed_skill' && !e.proposed_skill_body && e.proposed_skill_path;
---

<article class={`escalation-card urgency-${e.urgency} status-${e.status}`} data-status={e.status}>
  <div class="escalation-card-header">
    <span class={`pill ${e.kind}`}>{e.kind}</span>
    {e.urgency !== 'normal' && <span class={`pill urgency-${e.urgency}`}>{e.urgency}</span>}
    <span class={`pill status-${e.status}`}>{e.status}</span>
    <span class="escalation-title">{e.title}</span>
    <span class="escalation-meta">{meta.join(' · ')}</span>
  </div>
  <div class="md-body" set:html={bodyHtml}></div>
  {
    draftHtml && (
      <div class="proposed-draft">
        <div class="proposed-draft-label">
          Proposed agent: <code>{e.proposed_skill_path}</code>
        </div>
        <button class="proposed-draft-toggle" data-pd-target={`pd-${e.slug}`}>Show / hide draft</button>
        <pre id={`pd-${e.slug}`} class="proposed-draft-body" hidden>{draftHtml}</pre>
      </div>
    )
  }
  {
    draftMissing && (
      <div class="proposed-draft">
        <div class="proposed-draft-label">
          Proposed agent: <code>{e.proposed_skill_path}</code>{' '}
          <em style="color: var(--inhibit);">— file not found at that path</em>
        </div>
      </div>
    )
  }
</article>
