---
import type { VoiceTrait } from '@/lib/persona-parser';

/** Voice & Personality anchor card. Renders parsed voice traits or a hint
 * about how to populate the Voice & Personality section of persona.md. */
interface Props {
  voice: VoiceTrait[];
}

const { voice } = Astro.props;
---

<div class="anchor-card">
  <h3>
    Voice <span class="source">agents/persona.md</span>
  </h3>
  <ul>
    {
      voice.length > 0 ? (
        voice.map((v) => (
          <li>
            <strong>{v.label}</strong> &mdash; {v.detail}
          </li>
        ))
      ) : (
        <li>
          No voice rules parsed. Add a "## Voice & Personality" section to <code>agents/persona.md</code> with bulleted entries shaped <code>- **Label** -- detail</code>.
        </li>
      )
    }
  </ul>
</div>
