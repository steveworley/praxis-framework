---
/** Hard inhibitions anchor card — paired visually with VoiceCard. */
interface Props {
  inhibitions: string[];
}

const { inhibitions } = Astro.props;
---

<div class="anchor-card inhibit-card">
  <h3>
    Hard inhibitions <span class="source">agents/persona.md</span>
  </h3>
  <ul>
    {
      inhibitions.length > 0 ? (
        inhibitions.map((i) => <li>{i}</li>)
      ) : (
        <li>No hard inhibitions declared. Add a "## Hard inhibitions" section to <code>agents/persona.md</code>.</li>
      )
    }
  </ul>
</div>
