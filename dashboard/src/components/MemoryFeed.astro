---
import type { MemoryEntry } from '@/lib/memory-loader';

import MemoryCard from './MemoryCard.astro';

/** Section: notebook entries with category filters. */
interface Props {
  entries: MemoryEntry[] | null;
  error: string | null;
}

const { entries, error } = Astro.props;
const list = entries ?? [];
const categoryCounts: Record<string, number> = {};
for (const e of list) {
  categoryCounts[e.category] = (categoryCounts[e.category] ?? 0) + 1;
}
const categoryKeys = Object.keys(categoryCounts).sort();
const filters: Array<{ key: string; label: string }> = [
  { key: 'all', label: `All (${list.length})` },
  ...categoryKeys.map((k) => ({ key: k, label: `${k} (${categoryCounts[k]})` })),
];
---

<div class="section">
  <div class="section-title section-title-row">
    <span>Notebook</span>
    <span class="meta-text">{list.length} {list.length === 1 ? 'entry' : 'entries'}</span>
  </div>
  {error ? (
    <div class="empty-state">Failed to load memory: {error}</div>
  ) : list.length === 0 ? (
    <div class="empty-state">
      Notebook is empty. As the role works, observations about people, accounts, and patterns will land here.
    </div>
  ) : (
    <>
      <div class="filters" data-filter-group="memory">
        {filters.map((f) => (
          <button
            class={`filter-btn${f.key === 'all' ? ' active' : ''}`}
            data-filter={f.key}
            type="button"
          >
            {f.label}
          </button>
        ))}
      </div>
      <div class="memory-feed" data-filter-feed="memory">
        {list.map((entry) => <MemoryCard entry={entry} />)}
      </div>
    </>
  )}
</div>
