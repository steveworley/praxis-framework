---
import type { AgentSummary } from '@/lib/agents-loader';

/** A single row in /role's agents list. Live agents render plain; proposed
 * agents get the tinted background + "awaiting review" tag with a deep-link
 * to /escalations where the actual review happens. */
interface Props {
  agent: AgentSummary;
  proposed?: boolean;
}

const { agent, proposed = false } = Astro.props;
---

<div class:list={['agent-row', proposed && 'proposed']}>
  <span class="file">{agent.file}</span>
  <span class="verb">{agent.verb}</span>
  {proposed ? (
    <span class="verb-tag">awaiting review · <a href="/escalations">open →</a></span>
  ) : (
    <span class="verb-tag">{agent.tag}</span>
  )}
</div>
