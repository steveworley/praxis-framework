---
import type { Persona } from '@/lib/persona-parser';

/** Top-of-page identity card: name, role, email/location/reports-to. */
interface Props {
  persona: Persona;
}

const { persona } = Astro.props;
const ident = persona.identity;
const fullName = ident['full_name'] ?? ident['name'] ?? 'Unnamed role';
const role = ident['role'] ?? '';
---

<div class="hero">
  <div class="hero-name">{fullName}</div>
  <div class="hero-tagline">{role || '—'}</div>
  <div class="hero-meta">
    {ident['email'] && <span><code>{ident['email']}</code></span>}
    {ident['location'] && <span>{ident['location']}</span>}
    {ident['reports_to'] && <span>reports to {ident['reports_to']}</span>}
  </div>
</div>
