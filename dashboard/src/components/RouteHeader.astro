---
import { assembleEscalations } from '@/lib/escalations-loader';
import { getRoleHome } from '@/lib/role-home';
import { listProposedVerbs } from '@/lib/triage';

/**
 * Top brand strip + nav, rendered identically on every route.
 *
 * Two horizontal strips break out of the parent `.container` to full-bleed:
 * 1. A dark `--ink` brand strip showing the pixel-rendered `PRAXIS` logo
 *    (each letter coloured from the palette), a separator, the role name in
 *    mono caps, then the updated-at timestamp and a refresh button.
 * 2. A surface-coloured nav strip with monospace tabs. The current tab gets
 *    a 3px coloured underline keyed to the per-surface accent (peach, pink,
 *    purple, lavender, teal) so each surface's identity carries into the
 *    chrome.
 *
 * Open-count badges (escalations / triage) are loaded inside this component
 * so every page renders them consistently without piping state through
 * props. If either loader fails, the affected badge silently falls back to 0
 * — surfacing loader errors is the caller's concern via its own per-section
 * error handling.
 */
export type RouteName = 'home' | 'chat' | 'escalations' | 'triage' | 'notebook' | 'activity' | 'output' | 'role' | 'capabilities' | 'health';

/**
 * Per-surface accent colour. Drives both the active-tab underline in this
 * component and the default `SectionPill` colour on the migrated surfaces.
 * Keep this table in sync with `docs/future/dashboard-redesign.md` § Tokens.
 */
type SurfaceColour = 'peach' | 'pink' | 'purple' | 'lavender' | 'teal';

const ROUTE_COLOUR: Record<RouteName, SurfaceColour> = {
  home: 'teal',
  chat: 'teal',
  triage: 'pink',
  escalations: 'pink',
  notebook: 'peach',
  output: 'purple',
  activity: 'purple',
  role: 'teal',
  capabilities: 'purple',
  health: 'teal',
};

interface Props {
  current: RouteName;
  personaName?: string;
  updatedAt?: string;
}

const { current, personaName, updatedAt } = Astro.props;

const roleHome = getRoleHome();

const [escalationsRes, proposedRes] = await Promise.allSettled([
  assembleEscalations(roleHome),
  listProposedVerbs(roleHome),
]);

const escalationOpenCount =
  escalationsRes.status === 'fulfilled' ? escalationsRes.value.countsByStatus.open : 0;
const proposedVerbCount =
  proposedRes.status === 'fulfilled' ? proposedRes.value.length : 0;
const triageCount = escalationOpenCount + proposedVerbCount;

const tabs: { key: RouteName; href: string; label: string }[] = [
  { key: 'home', href: '/', label: 'home' },
  { key: 'chat', href: '/chat', label: 'chat' },
  { key: 'triage', href: '/triage', label: 'triage' },
  { key: 'escalations', href: '/escalations', label: 'escalations' },
  { key: 'notebook', href: '/notebook', label: 'notebook' },
  { key: 'output', href: '/output', label: 'output' },
  { key: 'activity', href: '/activity', label: 'activity' },
  { key: 'role', href: '/role', label: 'role' },
  { key: 'capabilities', href: '/capabilities', label: 'capabilities' },
  { key: 'health', href: '/health', label: 'health' },
];

const personaTag = (personaName ?? '').trim().toUpperCase();
---

<div class="brand-strip">
  <span class="px-logo" aria-label="PRAXIS">
    <span>P</span><span>R</span><span>A</span><span>X</span><span>I</span><span>S</span>
  </span>
  {personaTag.length > 0 && (
    <>
      <span class="sep">·</span>
      <span class="role-tag">{personaTag}</span>
    </>
  )}
  <span class="meta">
    {updatedAt && <span>updated {updatedAt}</span>}
    <button type="button" onclick="window.location.reload()">refresh</button>
  </span>
</div>
<div class="nav-wrap">
  <nav class="nav">
    {tabs.map((t) => {
      const isCurrent = t.key === current;
      const colour = ROUTE_COLOUR[t.key];
      return (
        <a class:list={[isCurrent && 'current', isCurrent && `current-${colour}`]} href={t.href}>
          {t.label}
          {t.key === 'escalations' && escalationOpenCount > 0 && (
            <span class="count">{escalationOpenCount}</span>
          )}
          {t.key === 'triage' && triageCount > 0 && (
            <span class="count">{triageCount}</span>
          )}
        </a>
      );
    })}
  </nav>
</div>
