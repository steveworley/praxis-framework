---
import { assembleEscalations } from '@/lib/escalations-loader';
import { getRoleHome } from '@/lib/role-home';
import { listProposedVerbs } from '@/lib/triage';

/** Top app head + nav, rendered identically on every route. The `current`
 * prop drives the active-tab underline; badge counts (escalations / triage)
 * are loaded inside this component so every page renders them consistently
 * without having to pipe state through props. If either loader fails the
 * affected badge silently falls back to 0 — surfacing loader errors is the
 * caller's concern via its own per-section error handling. */
export type RouteName = 'home' | 'chat' | 'escalations' | 'triage' | 'notebook' | 'activity' | 'output' | 'role' | 'capabilities' | 'health';

interface Props {
  current: RouteName;
  personaName?: string;
  updatedAt?: string;
}

const { current, personaName, updatedAt } = Astro.props;

const roleHome = getRoleHome();

const [escalationsRes, proposedRes] = await Promise.allSettled([
  assembleEscalations(roleHome),
  listProposedVerbs(roleHome),
]);

const escalationOpenCount =
  escalationsRes.status === 'fulfilled' ? escalationsRes.value.countsByStatus.open : 0;
const proposedVerbCount =
  proposedRes.status === 'fulfilled' ? proposedRes.value.length : 0;
const triageCount = escalationOpenCount + proposedVerbCount;

const tabs: Array<{ key: RouteName; href: string; label: string }> = [
  { key: 'home', href: '/', label: 'home' },
  { key: 'chat', href: '/chat', label: 'chat' },
  { key: 'triage', href: '/triage', label: 'triage' },
  { key: 'escalations', href: '/escalations', label: 'escalations' },
  { key: 'notebook', href: '/notebook', label: 'notebook' },
  { key: 'output', href: '/output', label: 'output' },
  { key: 'activity', href: '/activity', label: 'activity' },
  { key: 'role', href: '/role', label: 'role' },
  { key: 'capabilities', href: '/capabilities', label: 'capabilities' },
  { key: 'health', href: '/health', label: 'health' },
];
---

<div class="app-head">
  <div>
    <span class="app-brand">
      PRAXIS{personaName && <span class="name">{personaName}</span>}
    </span>
  </div>
  <div class="app-head-meta">
    {updatedAt && <span>updated {updatedAt}</span>}
    <button type="button" onclick="window.location.reload()">refresh</button>
  </div>
</div>
<nav class="app-nav">
  {tabs.map((t) => (
    <a class:list={[t.key === current && 'current']} href={t.href}>
      {t.label}
      {t.key === 'escalations' && escalationOpenCount > 0 && (
        <span class="open-count"> {escalationOpenCount}</span>
      )}
      {t.key === 'triage' && triageCount > 0 && (
        <span class="open-count"> {triageCount}</span>
      )}
    </a>
  ))}
</nav>
