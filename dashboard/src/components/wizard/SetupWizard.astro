---
/** Multi-step wizard for seeding a Praxis role. Single Alpine.js x-data
 * island so the whole flow shares one client state machine. The submit
 * handler POSTs to /api/setup/role and surfaces commit progress before
 * redirecting to / on success.
 *
 * Flow:
 *   1 Welcome → 2 Organisation → 3 Role definition → 4 Path choice
 *   Manual:    5 Voice → 6 Capabilities → 7 Inhibitions → 8 Initial verbs
 *   Research:  5 Handoff (writes brief, polls for draft) → review
 *   Both:      9 Review & edit (editable, seeding inline) → success
 */
---

<div
  class="wizard"
  x-data="setupWizard()"
  x-init="init()"
>
  <div class="wizard-progress">
    <template x-for="i in totalSteps" :key="i">
      <div
        class="wizard-progress-step"
        :class="{ active: i === progressIndex, done: i < progressIndex }"
      ></div>
    </template>
  </div>

  <div class="wizard-card">
    <div class="wizard-step-label" x-text="`Step ${progressIndex} of ${totalSteps}`"></div>

    <!-- Submit error -->
    <template x-if="submitError">
      <div class="error-banner" x-text="submitError"></div>
    </template>

    <!-- Step 1: Welcome -->
    <div x-show="step === 1">
      <h1>Build a Praxis role</h1>
      <p>
        Praxis builds <strong>role-based agents that fit your business</strong> — not agents that grow on their own. Every change to a populated role is gated behind your review.
      </p>
      <p>You'll work through:</p>
      <ol class="welcome-checklist">
        <li><strong>Organisation context</strong> — what your business is and what makes it different</li>
        <li><strong>Role definition</strong> — what role you're trying to fill</li>
        <li><strong>Path</strong> — let an agent research and design it for you, or hand-craft it yourself</li>
        <li><strong>Persona</strong> — voice, capabilities, hard inhibitions</li>
        <li><strong>Review</strong> — edit anything before seeding</li>
      </ol>
      <p>
        Seeding runs as <strong>two visible commits</strong> in this repository:
      </p>
      <ul style="margin: 0 0 1rem 1.2rem; color: var(--ink-soft); font-size: 13px;">
        <li><code>feat: seed role from praxis-framework template</code> — copies + populates the template files.</li>
        <li><code>chore: tidy framework-only files post-seed</code> — removes <code>template/</code>, <code>examples/</code>, the bootstrap script, and any research artefacts.</li>
      </ul>
      <p>
        After seeding, the dashboard switches to the populated role view at <code>/</code> and Claude Code sessions in the repo will load the new persona.
      </p>
    </div>

    <!-- Step 2: Organisation -->
    <div x-show="step === 2">
      <h2>Organisation context</h2>
      <p class="wizard-help">
        The org the role serves. The persona we generate will be shaped by this — sector, size, moats, customer profile all feed into the voice and capabilities downstream.
      </p>
      <div class="example-block">
        <div class="example-label">EXAMPLE</div>
        <div class="example-pair">
          <div class="ex-label">Aurora Health</div>
          <div class="ex-detail">Mid-market clinical telephony platform — sells into hospital networks where reliability and HIPAA posture beat feature breadth.</div>
        </div>
      </div>
      <div class="field">
        <label for="org-name">Organisation name *</label>
        <input id="org-name" type="text" x-model="form.organisation.name" placeholder="Quant" autocomplete="off" />
      </div>
      <div class="field">
        <label for="org-website">Website</label>
        <input id="org-website" type="text" x-model="form.organisation.website" placeholder="https://quantcdn.io" />
      </div>
      <div class="field">
        <label for="org-sector">Sector</label>
        <input id="org-sector" type="text" x-model="form.organisation.sector" placeholder="CDN / edge / hosting" />
      </div>
      <div class="field">
        <label for="org-size">Size</label>
        <select id="org-size" x-model="form.organisation.size">
          <option value="">— select —</option>
          <option value="solo">Solo</option>
          <option value="small">Small (2–20)</option>
          <option value="mid">Mid (21–250)</option>
          <option value="large">Large (251–2000)</option>
          <option value="enterprise">Enterprise (2000+)</option>
        </select>
      </div>
      <div class="field">
        <label for="org-desc">What the org does (1–3 sentences)</label>
        <textarea id="org-desc" rows="3" x-model="form.organisation.description" placeholder="Sovereign CDN and edge platform for security-conscious teams. Public sector and regulated enterprise."></textarea>
      </div>
      <div class="field">
        <label for="org-moats">What makes the org defensibly different</label>
        <textarea id="org-moats" rows="3" x-model="form.organisation.moats" placeholder="IRAP-assessed Australian sovereign hosting. Australian-owned, no US parent. Direct support from engineering."></textarea>
      </div>
      <div class="field">
        <label for="org-customer">Who the role engages with</label>
        <textarea id="org-customer" rows="2" x-model="form.organisation.customer_profile" placeholder="Government and regulated enterprise procurement teams. Technical buyers, mostly."></textarea>
      </div>
      <div class="field-output-hint">
        Saved to <code>persona.md</code> under <code>## Organisation</code>.
      </div>
    </div>

    <!-- Step 3: Role definition -->
    <div x-show="step === 3">
      <h2>Role definition</h2>
      <p class="wizard-help">
        What role are you trying to fill? Don't worry about voice or capabilities yet — that comes later. Right now we just need name, working title, and the role's reason for existing.
      </p>
      <div class="example-block">
        <div class="example-label">EXAMPLE</div>
        <div class="example-pair">
          <div class="ex-label">Sam Parker · BD agent</div>
          <div class="ex-detail">Owns sales-side outreach for Quant — cold campaigns, manual lead intake, weekly account reads on existing customers.</div>
        </div>
      </div>
      <div class="field">
        <label for="role-name">Role name *</label>
        <input id="role-name" type="text" x-model="form.role_definition.role_name" placeholder="Sam Parker" autocomplete="off" />
      </div>
      <div class="field">
        <label for="role-title">Working title</label>
        <input id="role-title" type="text" x-model="form.role_definition.working_title" placeholder="BD agent" />
      </div>
      <div class="field">
        <label for="role-purpose">One-sentence purpose *</label>
        <input
          id="role-purpose"
          type="text"
          x-model="form.role_definition.one_sentence_purpose"
          placeholder="Owns sales-side outreach for Quant."
        />
      </div>
      <div class="field">
        <label for="role-day">Day-to-day (free text)</label>
        <textarea id="role-day" rows="3" x-model="form.role_definition.day_to_day" placeholder="Cold campaigns, manual lead intake, weekly account reads on existing customers."></textarea>
      </div>
      <div class="field-output-hint">
        Saved to <code>persona.md</code> under <code>## Identity</code> and <code>CLAUDE.md</code>.
      </div>
    </div>

    <!-- Step 4: Path choice -->
    <div x-show="step === 4">
      <h2>Choose a path</h2>
      <p class="wizard-help">
        From here you can either let an agent research the org and propose a fitting role, or define the persona yourself. Either way, the next-to-last step is an editable review — nothing seeds without your approval.
      </p>
      <div class="path-grid">
        <button type="button" class="path-card" :class="{ active: form.path === 'research' }" @click="choosePath('research')">
          <div class="path-card-head">Research and design it for me</div>
          <div class="path-card-sub">An agent reads your brief, researches the org, and proposes a role shaped around your moats.</div>
          <div class="path-card-note">You'll review and edit before seeding — nothing ships without your approval.</div>
          <div class="path-card-chip">Beta · uses Claude Code</div>
        </button>
        <button type="button" class="path-card" :class="{ active: form.path === 'manual' }" @click="choosePath('manual')">
          <div class="path-card-head">Define it yourself</div>
          <div class="path-card-sub">Walk through voice, capabilities, and inhibitions yourself.</div>
          <div class="path-card-note">Recommended if you've already drafted a persona elsewhere.</div>
          <div class="path-card-chip">Hand-crafted</div>
        </button>
      </div>
    </div>

    <!-- Step 5 (manual): Voice -->
    <div x-show="step === 5 && form.path === 'manual'">
      <h2>Voice & personality</h2>
      <p class="wizard-help">
        Pair a short trait name with a concrete behaviour that shows what it looks like in practice.
        Aim for things you'd notice in a draft, not aspirational adjectives. 1–8 traits.
      </p>
      <div class="example-block">
        <div class="example-label">EXAMPLE</div>
        <div class="example-pair">
          <div class="ex-label">Warm but not chatty</div>
          <div class="ex-detail">drops articles in casual writing — "heading to lunch" not "I am heading to lunch"</div>
        </div>
      </div>
      <div class="field-row-labels">
        <span>Trait (2–3 words)</span>
        <span>How it shows up in writing</span>
        <span></span>
      </div>
      <template x-for="(trait, idx) in form.voice_traits" :key="idx">
        <div class="field-row">
          <input type="text" x-model="trait.label" placeholder="Warm but not chatty" />
          <input type="text" x-model="trait.detail" placeholder="drops articles, prefers single-sentence opens" />
          <button
            type="button"
            class="icon-btn"
            @click="form.voice_traits.splice(idx, 1)"
            :disabled="form.voice_traits.length <= 1"
          >×</button>
        </div>
      </template>
      <button
        type="button"
        class="add-row"
        @click="form.voice_traits.push({ label: '', detail: '' })"
        :disabled="form.voice_traits.length >= 8"
      >+ Add trait</button>
      <div class="field-output-hint">
        Each trait becomes a bullet under <code>## Voice &amp; Personality</code> in <code>persona.md</code>.
      </div>
    </div>

    <!-- Step 6 (manual): Capabilities -->
    <div x-show="step === 6 && form.path === 'manual'">
      <h2>Capabilities</h2>
      <p class="wizard-help">
        First-person statements: "I can …". What this role is qualified to do. Optional, up to 10.
      </p>
      <div class="example-block">
        <div class="example-label">EXAMPLE</div>
        <div class="example-single">I can run cold-outreach campaigns end to end — research, draft, send, monitor, escalate when stuck.</div>
      </div>
      <template x-for="(item, idx) in form.capabilities" :key="idx">
        <div class="field-row single">
          <input type="text" x-model="form.capabilities[idx]" placeholder="I can run cold outreach end to end…" />
          <button type="button" class="icon-btn" @click="form.capabilities.splice(idx, 1)">×</button>
        </div>
      </template>
      <button
        type="button"
        class="add-row"
        @click="form.capabilities.push('')"
        :disabled="form.capabilities.length >= 10"
      >+ Add capability</button>
      <div class="field-output-hint">
        Each line becomes a bullet under <code>## Capabilities</code>.
      </div>
    </div>

    <!-- Step 7 (manual): Inhibitions -->
    <div x-show="step === 7 && form.path === 'manual'">
      <h2>Hard inhibitions</h2>
      <p class="wizard-help">
        First-person "I never …" statements. The constitution — what this role refuses regardless of instruction.
        Optional, up to 10.
      </p>
      <div class="example-block">
        <div class="example-label">EXAMPLE</div>
        <div class="example-single">I never claim certifications the org does not hold (e.g. "IRAP-assessed", "OFFICIAL: Sensitive").</div>
      </div>
      <template x-for="(item, idx) in form.inhibitions" :key="idx">
        <div class="field-row single">
          <input type="text" x-model="form.inhibitions[idx]" placeholder="I never send an email without operator approval." />
          <button type="button" class="icon-btn" @click="form.inhibitions.splice(idx, 1)">×</button>
        </div>
      </template>
      <button
        type="button"
        class="add-row"
        @click="form.inhibitions.push('')"
        :disabled="form.inhibitions.length >= 10"
      >+ Add inhibition</button>
      <div class="field-output-hint">
        Each line becomes a bullet under <code>## Hard inhibitions</code>. Worth knowing: these are surfaced in the dashboard's red-accented constitution panel.
      </div>
    </div>

    <!-- Step 8 (manual): Initial verbs -->
    <div x-show="step === 8 && form.path === 'manual'">
      <h2>Initial verbs (optional)</h2>
      <p class="wizard-help">
        Verbs are markdown playbooks Claude Code reads when triggered. Stub a few here if you already know the
        shape; you can also leave this empty and write them by hand later. Slug + one-line purpose. Up to 5.
      </p>
      <div class="example-block">
        <div class="example-label">EXAMPLE</div>
        <div class="example-pair">
          <div class="ex-label">account-read</div>
          <div class="ex-detail">Weekly read of the customer portfolio — flags churn risk and upsell signals.</div>
        </div>
      </div>
      <div class="field-row-labels">
        <span>File slug (kebab-case)</span>
        <span>What this verb does</span>
        <span></span>
      </div>
      <template x-for="(verb, idx) in form.initial_verbs" :key="idx">
        <div class="field-row">
          <input type="text" x-model="verb.slug" placeholder="account-read" />
          <input type="text" x-model="verb.purpose" placeholder="Weekly read of the customer portfolio." />
          <button type="button" class="icon-btn" @click="form.initial_verbs.splice(idx, 1)">×</button>
        </div>
      </template>
      <button
        type="button"
        class="add-row"
        @click="form.initial_verbs.push({ slug: '', purpose: '' })"
        :disabled="form.initial_verbs.length >= 5"
      >+ Add verb</button>
      <div class="field-output-hint">
        One markdown file per verb under <code>{'verbs/{slug}.md'}</code>. The dashboard lists these on the <code>/role</code> page once seeded.
      </div>
    </div>

    <!-- Step 5 (research): Handoff & wait -->
    <div x-show="step === 5 && form.path === 'research'">
      <h2>Hand off to Claude Code</h2>
      <p class="wizard-help">
        We've written a research brief into your repo. Open Claude Code in this directory and ask it to follow the brief — it'll research the org and write a persona draft back to <code>.praxis/persona-draft.md</code>. The wizard is watching for the file.
      </p>

      <template x-if="research.error">
        <div class="error-banner" x-text="research.error"></div>
      </template>

      <template x-if="research.brief_path">
        <div>
          <ol class="handoff-steps">
            <li>Open a terminal.</li>
            <li><code>cd</code> into this repo.</li>
            <li>Run <code>claude</code>.</li>
            <li>
              Paste this prompt:
              <div class="handoff-prompt">
                <code x-text="research.prompt"></code>
                <button type="button" class="add-row" @click="copyPrompt()" :disabled="research.copied">
                  <span x-show="!research.copied">Copy</span>
                  <span x-show="research.copied">Copied</span>
                </button>
              </div>
            </li>
            <li>
              Wait for Claude to write <code x-text="research.expected_draft_path"></code>. The wizard will detect it automatically.
            </li>
          </ol>

          <div class="handoff-status">
            <span class="handoff-pulse" :class="{ active: research.polling }"></span>
            <span x-show="!research.draft_loaded">
              Watching for <code x-text="research.expected_draft_path"></code>…
              <span class="handoff-status-meta" x-text="research.last_checked ? `(last checked: ${research.last_checked})` : ''"></span>
            </span>
            <span x-show="research.draft_loaded" class="handoff-status-ok">
              Draft loaded. Moving to review…
            </span>
          </div>

          <div class="handoff-overrides">
            <button type="button" class="add-row" @click="loadDraftNow()" :disabled="research.loading_now">
              <span x-show="!research.loading_now">I've written it, load now</span>
              <span x-show="research.loading_now">Loading…</span>
            </button>
            <button type="button" class="add-row danger" @click="switchToManual()">
              Skip and define manually instead
            </button>
          </div>
        </div>
      </template>

      <template x-if="!research.brief_path && research.preparing">
        <p class="wizard-help">Preparing the research brief…</p>
      </template>
    </div>

    <!-- Step 9: Review & edit -->
    <div x-show="step === 9">
      <h2>Review &amp; edit</h2>
      <p class="wizard-help">
        Confirm everything looks right. Sections are collapsible — open any group to edit before seeding. Two visible commits will be made when you seed.
      </p>

      <div class="review-summary">
        <div><strong x-text="form.organisation.name || '—'"></strong> · <span x-text="form.role_definition.role_name || 'unnamed role'"></span></div>
        <div class="review-summary-meta">
          <span x-text="`${form.voice_traits.filter(t => t.label && t.detail).length} voice traits`"></span> ·
          <span x-text="`${form.capabilities.filter(Boolean).length} capabilities`"></span> ·
          <span x-text="`${form.inhibitions.filter(Boolean).length} inhibitions`"></span> ·
          <span x-text="`${form.initial_verbs.filter(v => v.slug && v.purpose).length} initial verbs`"></span>
        </div>
        <div class="review-summary-jumps">
          <a href="#" @click.prevent="step = 2">edit organisation</a> ·
          <a href="#" @click.prevent="step = 3">edit role</a>
          <template x-if="form.path === 'research'">
            <span> · <a href="#" @click.prevent="reopenHandoff()">re-run research</a></span>
          </template>
        </div>
      </div>

      <details class="review-section" open>
        <summary>Identity</summary>
        <div class="review-section-body">
          <div class="field">
            <label>Email (optional)</label>
            <input type="text" x-model="form.identity.email" placeholder="iris@example.com" />
          </div>
          <div class="field">
            <label>Location (optional)</label>
            <input type="text" x-model="form.identity.location" placeholder="Brisbane, AU" />
          </div>
          <div class="field">
            <label>Reports to (optional)</label>
            <input type="text" x-model="form.identity.reports_to" placeholder="Steve" />
          </div>
        </div>
      </details>

      <details class="review-section" open>
        <summary x-text="`Voice (${form.voice_traits.filter(t => t.label && t.detail).length})`"></summary>
        <div class="review-section-body">
          <div class="field-row-labels">
            <span>Trait</span>
            <span>How it shows up</span>
            <span></span>
          </div>
          <template x-for="(trait, idx) in form.voice_traits" :key="`v-${idx}`">
            <div class="field-row">
              <input type="text" x-model="trait.label" placeholder="Warm but not chatty" />
              <input type="text" x-model="trait.detail" placeholder="drops articles" />
              <button type="button" class="icon-btn" @click="form.voice_traits.splice(idx, 1)" :disabled="form.voice_traits.length <= 1">×</button>
            </div>
          </template>
          <button type="button" class="add-row" @click="form.voice_traits.push({ label: '', detail: '' })" :disabled="form.voice_traits.length >= 8">+ Add trait</button>
        </div>
      </details>

      <details class="review-section">
        <summary x-text="`Capabilities (${form.capabilities.filter(Boolean).length})`"></summary>
        <div class="review-section-body">
          <template x-for="(item, idx) in form.capabilities" :key="`c-${idx}`">
            <div class="field-row single">
              <input type="text" x-model="form.capabilities[idx]" placeholder="I can …" />
              <button type="button" class="icon-btn" @click="form.capabilities.splice(idx, 1)">×</button>
            </div>
          </template>
          <button type="button" class="add-row" @click="form.capabilities.push('')" :disabled="form.capabilities.length >= 10">+ Add capability</button>
        </div>
      </details>

      <details class="review-section">
        <summary x-text="`Hard inhibitions (${form.inhibitions.filter(Boolean).length})`"></summary>
        <div class="review-section-body">
          <template x-for="(item, idx) in form.inhibitions" :key="`i-${idx}`">
            <div class="field-row single">
              <input type="text" x-model="form.inhibitions[idx]" placeholder="I never …" />
              <button type="button" class="icon-btn" @click="form.inhibitions.splice(idx, 1)">×</button>
            </div>
          </template>
          <button type="button" class="add-row" @click="form.inhibitions.push('')" :disabled="form.inhibitions.length >= 10">+ Add inhibition</button>
        </div>
      </details>

      <details class="review-section">
        <summary x-text="`Initial verbs (${form.initial_verbs.filter(v => v.slug && v.purpose).length})`"></summary>
        <div class="review-section-body">
          <div class="field-row-labels">
            <span>Slug</span>
            <span>Purpose</span>
            <span></span>
          </div>
          <template x-for="(verb, idx) in form.initial_verbs" :key="`v-${idx}`">
            <div class="field-row">
              <input type="text" x-model="verb.slug" placeholder="account-read" />
              <input type="text" x-model="verb.purpose" placeholder="Weekly read…" />
              <button type="button" class="icon-btn" @click="form.initial_verbs.splice(idx, 1)">×</button>
            </div>
          </template>
          <button type="button" class="add-row" @click="form.initial_verbs.push({ slug: '', purpose: '' })" :disabled="form.initial_verbs.length >= 5">+ Add verb</button>
        </div>
      </details>

      <template x-if="submitting">
        <div class="commit-progress">
          <div class="commit-step" :class="commit1Status">Commit 1: feat: seed role from praxis-framework template</div>
          <div class="commit-step" :class="commit2Status">Commit 2: chore: tidy framework-only files post-seed</div>
        </div>
      </template>
    </div>

    <div class="wizard-actions">
      <button type="button" class="btn" @click="prev()" :disabled="!canGoBack || submitting" x-text="backLabel"></button>
      <template x-if="!isReviewStep">
        <button type="button" class="btn btn-primary" @click="next()" :disabled="!canAdvance" x-show="step !== 4 && !(step === 5 && form.path === 'research')">Continue</button>
      </template>
      <template x-if="isReviewStep">
        <button type="button" class="btn btn-primary" @click="submit()" :disabled="submitting || !canSubmit">
          <span x-show="!submitting">Seed this role</span>
          <span x-show="submitting">Seeding…</span>
        </button>
      </template>
    </div>
  </div>
</div>

<script is:inline src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
<script is:inline>
  function setupWizard() {
    return {
      step: 1,
      submitting: false,
      submitError: '',
      commit1Status: 'pending',
      commit2Status: 'pending',
      pollHandle: null,
      form: {
        path: 'unset',
        organisation: {
          name: '',
          website: '',
          sector: '',
          size: '',
          description: '',
          moats: '',
          customer_profile: '',
        },
        role_definition: {
          role_name: '',
          working_title: '',
          one_sentence_purpose: '',
          day_to_day: '',
        },
        identity: { email: '', location: '', reports_to: '' },
        voice_traits: [{ label: '', detail: '' }],
        capabilities: [''],
        inhibitions: [''],
        initial_verbs: [],
      },
      research: {
        brief_path: '',
        prompt: '',
        expected_draft_path: '',
        polling: false,
        last_checked: '',
        draft_loaded: false,
        preparing: false,
        copied: false,
        loading_now: false,
        error: '',
      },
      init() {
        this.$watch('step', (next) => {
          // Entering research handoff: prepare brief, start polling.
          if (next === 5 && this.form.path === 'research') {
            this.prepareHandoff();
            this.startPolling();
          } else {
            this.stopPolling();
          }
        });
      },

      // ---- progress -----------------------------------------------------
      get totalSteps() {
        return this.form.path === 'research' ? 9 : 10;
      },
      get progressIndex() {
        // Map current step to a progress-bar segment that grows monotonically.
        // Manual: 1..10. Research: 1..4 → 1..4, 5(handoff) → 5, 9(review) → 8, submit → 9.
        if (this.form.path === 'research') {
          if (this.step <= 4) return this.step;
          if (this.step === 5) return 5; // handoff
          if (this.step === 9) return this.submitting ? 9 : 8;
          return 1;
        }
        // Manual: review = 9, submitting bumps to 10.
        if (this.step === 9) return this.submitting ? 10 : 9;
        return this.step;
      },
      get isReviewStep() {
        return this.step === 9;
      },

      // ---- navigation ---------------------------------------------------
      get canGoBack() {
        return this.step > 1 && !this.submitting;
      },
      get backLabel() {
        return this.step === 1 ? 'Back' : 'Back';
      },
      get canAdvance() {
        if (this.step === 1) return true;
        if (this.step === 2) {
          return this.form.organisation.name.trim().length > 0;
        }
        if (this.step === 3) {
          return (
            this.form.role_definition.role_name.trim().length > 0 &&
            this.form.role_definition.one_sentence_purpose.trim().length > 0
          );
        }
        if (this.step === 4) {
          return this.form.path === 'research' || this.form.path === 'manual';
        }
        if (this.step === 5 && this.form.path === 'manual') {
          return this.form.voice_traits.some(
            (t) => t.label.trim().length > 0 && t.detail.trim().length > 0,
          );
        }
        if (this.step === 5 && this.form.path === 'research') {
          // Advance happens automatically when the draft loads.
          return false;
        }
        if (this.step === 6 || this.step === 7 || this.step === 8) return true;
        return true;
      },
      get canSubmit() {
        return (
          this.form.organisation.name.trim().length > 0 &&
          this.form.role_definition.role_name.trim().length > 0 &&
          this.form.role_definition.one_sentence_purpose.trim().length > 0 &&
          this.form.voice_traits.some((t) => t.label.trim() && t.detail.trim())
        );
      },
      next() {
        if (!this.canAdvance) return;
        if (this.step === 4) {
          // Path card click handles advance; this branch is defensive.
          if (this.form.path === 'manual') this.step = 5;
          else if (this.form.path === 'research') this.step = 5;
          return;
        }
        if (this.step === 8 && this.form.path === 'manual') {
          this.step = 9;
          return;
        }
        if (this.step === 9) return;
        this.step += 1;
      },
      prev() {
        if (this.submitting || this.step <= 1) return;
        if (this.step === 9) {
          // Review → previous step depends on path.
          this.step = this.form.path === 'research' ? 5 : 8;
          return;
        }
        if (this.step === 5 && this.form.path === 'research') {
          this.stopPolling();
          this.step = 4;
          return;
        }
        this.step -= 1;
      },
      choosePath(which) {
        this.form.path = which;
        this.step = 5;
      },
      switchToManual() {
        this.stopPolling();
        this.form.path = 'manual';
        this.step = 5;
      },
      reopenHandoff() {
        if (this.form.path !== 'research') {
          this.form.path = 'research';
        }
        this.step = 5;
      },

      // ---- research handoff --------------------------------------------
      async prepareHandoff() {
        this.research.error = '';
        this.research.preparing = true;
        try {
          const res = await fetch('/api/setup/research', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              organisation: this.cleanOrganisation(),
              role_definition: this.cleanRoleDefinition(),
            }),
          });
          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            throw new Error(body.error || `Research handoff failed (HTTP ${res.status})`);
          }
          const body = await res.json();
          if (body.kind === 'handoff') {
            this.research.brief_path = body.brief_path;
            this.research.prompt = body.prompt;
            this.research.expected_draft_path = body.expected_draft_path;
          } else if (body.kind === 'draft') {
            // Future ClaudeApiEngine path — populate immediately.
            this.applyPersonaDraft(body.persona);
            this.research.draft_loaded = true;
            this.step = 9;
          }
        } catch (e) {
          this.research.error = e.message || String(e);
        } finally {
          this.research.preparing = false;
        }
      },
      startPolling() {
        this.stopPolling();
        this.research.polling = true;
        this.pollHandle = setInterval(() => this.pollDraft(), 5000);
        // Fire one immediately so the operator sees fresh status quickly.
        this.pollDraft();
      },
      stopPolling() {
        if (this.pollHandle) {
          clearInterval(this.pollHandle);
          this.pollHandle = null;
        }
        this.research.polling = false;
      },
      async pollDraft() {
        try {
          const res = await fetch('/api/setup/load-draft');
          const body = await res.json();
          this.research.last_checked = new Date().toLocaleTimeString();
          if (body.kind === 'ready') {
            this.applyPersonaDraft(body.persona);
            this.research.draft_loaded = true;
            this.stopPolling();
            this.step = 9;
          } else if (body.kind === 'error') {
            this.research.error = body.message || 'Draft parse error';
          } else {
            this.research.error = '';
          }
        } catch (e) {
          this.research.error = e.message || String(e);
        }
      },
      async loadDraftNow() {
        this.research.loading_now = true;
        try {
          await this.pollDraft();
        } finally {
          this.research.loading_now = false;
        }
      },
      copyPrompt() {
        if (!this.research.prompt) return;
        const onSuccess = () => {
          this.research.copied = true;
          setTimeout(() => { this.research.copied = false; }, 1500);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(this.research.prompt).then(onSuccess).catch(() => {});
          return;
        }
        // Fallback for non-secure contexts.
        const ta = document.createElement('textarea');
        ta.value = this.research.prompt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); onSuccess(); } catch (_) {}
        document.body.removeChild(ta);
      },
      applyPersonaDraft(persona) {
        if (!persona) return;
        if (persona.identity) {
          this.form.identity.email = persona.identity.email || '';
          this.form.identity.location = persona.identity.location || '';
          this.form.identity.reports_to = persona.identity.reports_to || '';
          if (persona.identity.full_name && !this.form.role_definition.role_name) {
            this.form.role_definition.role_name = persona.identity.full_name;
          }
          if (persona.identity.role && !this.form.role_definition.working_title) {
            this.form.role_definition.working_title = persona.identity.role;
          }
        }
        if (Array.isArray(persona.voice) && persona.voice.length > 0) {
          // The persona-parser emits the new {trait, qualifiers} shape; the
          // wizard's form still uses the legacy {label, detail} pair shape
          // for now (no curated trait cloud in the dashboard yet). Map the
          // first qualifier into `detail` so the form round-trips. A later
          // dashboard pass will replace this UX with a trait-cloud picker
          // matching the CLI's voice flow.
          this.form.voice_traits = persona.voice.map((t) => ({
            label: t.trait || '',
            detail: Array.isArray(t.qualifiers) ? (t.qualifiers[0] || '') : '',
          }));
        }
        if (Array.isArray(persona.capabilities) && persona.capabilities.length > 0) {
          this.form.capabilities = persona.capabilities.slice();
        }
        if (Array.isArray(persona.inhibitions) && persona.inhibitions.length > 0) {
          this.form.inhibitions = persona.inhibitions.slice();
        }
        if (Array.isArray(persona.initial_verbs) && persona.initial_verbs.length > 0) {
          // The persona-parser emits the new {slug, description: string[]}
          // shape; the wizard's form still holds {slug, purpose: string}
          // pending a future bullet-list UX. Collapse description bullets
          // into the single purpose line so the form round-trips. A later
          // dashboard pass will give this section a textarea-or-bullet UI
          // matching the CLI's two-stage flow.
          this.form.initial_verbs = persona.initial_verbs.map((v) => {
            const desc = Array.isArray(v.description) ? v.description : [];
            return {
              slug: v.slug || '',
              purpose: desc.join(' '),
            };
          });
        }
      },

      // ---- payload ------------------------------------------------------
      cleanOrganisation() {
        const o = this.form.organisation;
        const out = { name: o.name.trim() };
        if (o.website && o.website.trim()) out.website = o.website.trim();
        if (o.sector && o.sector.trim()) out.sector = o.sector.trim();
        if (o.size && o.size.trim()) out.size = o.size.trim();
        if (o.description && o.description.trim()) out.description = o.description.trim();
        if (o.moats && o.moats.trim()) out.moats = o.moats.trim();
        if (o.customer_profile && o.customer_profile.trim()) out.customer_profile = o.customer_profile.trim();
        return out;
      },
      cleanRoleDefinition() {
        const r = this.form.role_definition;
        const out = {
          role_name: r.role_name.trim(),
          one_sentence_purpose: r.one_sentence_purpose.trim(),
        };
        if (r.working_title && r.working_title.trim()) out.working_title = r.working_title.trim();
        if (r.day_to_day && r.day_to_day.trim()) out.day_to_day = r.day_to_day.trim();
        return out;
      },
      buildPayload() {
        return {
          organisation: this.cleanOrganisation(),
          role_definition: this.cleanRoleDefinition(),
          identity: {
            email: this.form.identity.email.trim() || undefined,
            location: this.form.identity.location.trim() || undefined,
            reports_to: this.form.identity.reports_to.trim() || undefined,
          },
          // Adapt the wizard's legacy {label, detail} pair shape into the new
          // {trait, qualifiers} schema the seed package expects. `label`
          // becomes the canonical trait token (lowercased so it matches the
          // shared trait library); `detail`, if present, becomes the single
          // qualifier. A future dashboard refresh will source `trait` from a
          // curated cloud rather than free text.
          voice_traits: this.form.voice_traits
            .map((t) => {
              const label = t.label.trim().toLowerCase();
              const detail = t.detail.trim();
              return {
                trait: label,
                qualifiers: detail.length > 0 ? [detail] : [],
              };
            })
            .filter((t) => t.trait.length > 0),
          capabilities: this.form.capabilities.map((s) => s.trim()).filter(Boolean),
          inhibitions: this.form.inhibitions.map((s) => s.trim()).filter(Boolean),
          // The wizard's form still uses {slug, purpose: string} for the
          // legacy single-line UX. Adapt to the seed package's new
          // {slug, description: string[]} shape on submit — purpose
          // becomes the single bullet (or no bullet if it's blank).
          initial_verbs: this.form.initial_verbs
            .map((v) => {
              const slug = v.slug.trim();
              const purpose = v.purpose.trim();
              return {
                slug,
                description: purpose.length > 0 ? [purpose] : [],
              };
            })
            .filter((v) => v.slug.length > 0),
        };
      },
      async submit() {
        this.submitError = '';
        this.submitting = true;
        this.commit1Status = 'active';
        this.commit2Status = 'pending';
        try {
          const res = await fetch('/api/setup/role', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.buildPayload()),
          });
          if (!res.ok) {
            let msg = 'Seed failed (HTTP ' + res.status + ')';
            try {
              const err = await res.json();
              if (err && err.error) msg = err.error;
            } catch (_) {}
            throw new Error(msg);
          }
          const body = await res.json();
          this.commit1Status = 'done';
          this.commit2Status = 'done';
          // Brief pause so the operator sees both ticks before redirect.
          setTimeout(() => {
            window.location.href = body.redirect || '/';
          }, 600);
        } catch (e) {
          this.submitError = e.message || String(e);
          this.commit1Status = 'pending';
          this.commit2Status = 'pending';
          this.submitting = false;
        }
      },
    };
  }
</script>

