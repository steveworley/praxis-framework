---
/** Multi-step wizard for seeding a Praxis role. Single Alpine.js x-data
 * island so the whole flow shares one client state machine. The submit
 * handler POSTs to /api/setup/role and surfaces commit progress before
 * redirecting to / on success.
 *
 * Flow:
 *   1 Welcome → 2 Organisation → 3 Role definition → 4 Path choice
 *   Manual:    5 Voice → 6 Capabilities → 7 Accountabilities →
 *              8 Success criteria → 9 Inhibitions → 10 Initial verbs
 *   Research:  5 Handoff (writes brief, polls for draft) → review
 *   Both:      11 Review & edit (editable, seeding inline) → success
 *
 * ----------------------------------------------------------------------
 * Design — character-sheet, anticipatory mood.
 *
 * Each step gets its own one-line Fraunces display title + Source Serif 4
 * italic subtitle, and its own accent colour. The accent surfaces in:
 *   - the step indicator's pixel-font label colour,
 *   - the progress rule fill,
 *   - the primary CTA's offset block-shadow,
 *   - the input focus block-shadow.
 *
 * Accent map (per step, falls back to teal):
 *   1–3 (basics)              → teal     identity / runtime
 *   4   (path choice)         → purple   deciding the route
 *   5m  (voice)               → peach    voice / memory
 *   5r  (research handoff)    → purple   research / capability
 *   6   (capabilities)        → purple   capability
 *   7   (accountabilities)    → pink     accountability
 *   8   (success criteria)    → lavender measure
 *   9   (inhibitions)         → oxblood  hard limit
 *  10   (initial verbs)       → teal     verbs (playbooks)
 *  11   (review & seed)       → pink     commitment
 *
 * The accent is set via the `--accent` CSS custom property on the
 * `.setup-stage` wrapper, computed by `accentForStep()` and reactive to
 * the current step. Every styled affordance reads from `var(--accent)` so
 * we don't repeat a switch in CSS.
 */
---

<div class="setup-stage" x-data="setupWizard()" x-init="init()" :style="`--accent: ${accent}; --accent-soft: ${accentSoft};`">
  <!-- Step indicator + progress rule. Hidden on the welcome step so the
       welcome reads as the cover sheet, not as "step 1 of 11". -->
  <div class="setup-step-meta" x-show="step > 1">
    <div class="setup-step-label" x-text="stepLabel"></div>
    <div class="setup-progress" role="progressbar" :aria-valuenow="progressIndex" :aria-valuemin="1" :aria-valuemax="totalSteps">
      <div class="setup-progress-fill" :style="`width: ${(progressIndex / totalSteps) * 100}%`"></div>
    </div>
  </div>

  <!-- Submit error -->
  <template x-if="submitError">
    <div class="setup-error" x-text="submitError"></div>
  </template>

  <!-- Field-level validation issues from a 422 response -->
  <template x-if="submitIssues.length">
    <ul class="setup-error-issues">
      <template x-for="(issue, i) in submitIssues" :key="i">
        <li><strong x-text="issue.label"></strong><span x-text="issue.message"></span></li>
      </template>
    </ul>
  </template>

  <!-- ============================================================== -->
  <!-- Step 1: Welcome                                                  -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 1">
    <div class="setup-step-label setup-step-label--cover">PRAXIS · ROLE SETUP</div>
    <h1 class="setup-title">Building a Praxis role.</h1>
    <p class="setup-subtitle">
      A short, deliberate walk — six considered choices that decide how this
      role sounds, what they can do, and what they refuse.
    </p>

    <div class="setup-welcome-prose">
      <p>
        Praxis builds <strong>role-based agents that fit your business</strong>
        — not agents that grow on their own. Every change to a populated role
        is gated behind your review.
      </p>
      <p>You'll work through:</p>
      <ol class="setup-checklist">
        <li><strong>Organisation context</strong> — what your business is and what makes it different.</li>
        <li><strong>Role definition</strong> — what role you're trying to fill.</li>
        <li><strong>Path</strong> — let an agent research and design it for you, or hand-craft it yourself.</li>
        <li><strong>Position description</strong> — voice, capabilities, accountabilities, success criteria, hard inhibitions.</li>
        <li><strong>Review</strong> — edit anything before seeding.</li>
      </ol>
      <p>Seeding runs as <strong>two visible commits</strong> in this repository:</p>
      <ul class="setup-commit-list">
        <li><code>feat: seed role from praxis-framework template</code> — copies + populates the template files.</li>
        <li><code>chore: tidy framework-only files post-seed</code> — removes <code>template/</code>, <code>examples/</code>, the bootstrap script, and any research artefacts.</li>
      </ul>
      <p>
        After seeding, the dashboard switches to the populated role view at
        <code>/</code> and Claude Code sessions in the repo will load the new
        persona.
      </p>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 2: Organisation                                             -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 2">
    <h1 class="setup-title">Who do they work for?</h1>
    <p class="setup-subtitle">
      The org shapes everything downstream — sector, size, moats, customer
      profile all feed into the voice and capabilities you'll define next.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-pair">
        <div class="ex-label">Aurora Health</div>
        <div class="ex-detail">
          Mid-market clinical telephony platform — sells into hospital networks
          where reliability and HIPAA posture beat feature breadth.
        </div>
      </div>
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="org-name">
        Organisation name<span class="setup-required">·</span>
      </label>
      <p class="setup-field-help">The name your team uses for the org day-to-day.</p>
      <input class="setup-input" id="org-name" type="text" x-model="form.organisation.name" placeholder="Quant" autocomplete="off" />
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="org-website">Website</label>
      <p class="setup-field-help">Optional. Used by the research agent as a starting point.</p>
      <input class="setup-input" id="org-website" type="text" x-model="form.organisation.website" placeholder="https://quantcdn.io" />
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="org-sector">Sector</label>
      <p class="setup-field-help">Short — one or two terms the industry would recognise.</p>
      <input class="setup-input" id="org-sector" type="text" x-model="form.organisation.sector" placeholder="CDN / edge / hosting" />
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="org-size">Size</label>
      <p class="setup-field-help">Headcount band — helps the persona pitch sound right for the scale.</p>
      <select class="setup-input setup-input--select" id="org-size" x-model="form.organisation.size">
        <option value="">— select —</option>
        <option value="solo">Solo</option>
        <option value="small">Small (2–20)</option>
        <option value="mid">Mid (21–250)</option>
        <option value="large">Large (251–2000)</option>
        <option value="enterprise">Enterprise (2000+)</option>
      </select>
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="org-desc">What the org does</label>
      <p class="setup-field-help">One to three sentences — what the org sells, who it sells to.</p>
      <textarea class="setup-input setup-input--prose" id="org-desc" rows="3" x-model="form.organisation.description" placeholder="Sovereign CDN and edge platform for security-conscious teams. Public sector and regulated enterprise."></textarea>
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="org-moats">Defensibly different</label>
      <p class="setup-field-help">The moats — what makes the org hard to replace.</p>
      <textarea class="setup-input setup-input--prose" id="org-moats" rows="3" x-model="form.organisation.moats" placeholder="IRAP-assessed Australian sovereign hosting. Australian-owned, no US parent. Direct support from engineering."></textarea>
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="org-customer">Customer profile</label>
      <p class="setup-field-help">Who the role talks to — buyer shape and posture.</p>
      <textarea class="setup-input setup-input--prose" id="org-customer" rows="2" x-model="form.organisation.customer_profile" placeholder="Government and regulated enterprise procurement teams. Technical buyers, mostly."></textarea>
    </div>

    <div class="setup-field-output">
      Saved to <code>persona.md</code> under <code>## Organisation</code>.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 3: Role definition                                          -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 3">
    <h1 class="setup-title">Who is this role?</h1>
    <p class="setup-subtitle">
      Name them. State why they exist. Voice and capabilities come later — for
      now, the working title and the one-sentence reason for being.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-pair">
        <div class="ex-label">Sam Parker · BD agent</div>
        <div class="ex-detail">
          Owns sales-side outreach for Quant — cold campaigns, manual lead intake,
          weekly account reads on existing customers.
        </div>
      </div>
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="role-name">
        Role name<span class="setup-required">·</span>
      </label>
      <p class="setup-field-help">A human name. Personas read better with one.</p>
      <input class="setup-input" id="role-name" type="text" x-model="form.role_definition.role_name" placeholder="Sam Parker" autocomplete="off" />
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="role-title">Working title</label>
      <p class="setup-field-help">What appears in the role's signature line.</p>
      <input class="setup-input" id="role-title" type="text" x-model="form.role_definition.working_title" placeholder="BD agent" />
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="role-purpose">
        One-sentence purpose<span class="setup-required">·</span>
      </label>
      <p class="setup-field-help">Why this role exists. Verb-led, plain language.</p>
      <input class="setup-input" id="role-purpose" type="text" x-model="form.role_definition.one_sentence_purpose" placeholder="Owns sales-side outreach for Quant." />
    </div>

    <div class="setup-field">
      <label class="setup-field-label" for="role-day">Day-to-day</label>
      <p class="setup-field-help">A loose paragraph on what their week looks like.</p>
      <textarea class="setup-input setup-input--prose" id="role-day" rows="3" x-model="form.role_definition.day_to_day" placeholder="Cold campaigns, manual lead intake, weekly account reads on existing customers."></textarea>
    </div>

    <div class="setup-field-output">
      Saved to <code>persona.md</code> under <code>## Identity</code> and
      <code>CLAUDE.md</code>.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 4: Path choice                                              -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 4">
    <h1 class="setup-title">How do we get there?</h1>
    <p class="setup-subtitle">
      Either let an agent research the org and propose a fitting role, or
      define the persona yourself. Either way, the last step is an editable
      review — nothing seeds without your approval.
    </p>

    <div class="setup-paths">
      <button
        type="button"
        class="setup-path"
        :class="{ active: form.path === 'research' }"
        @click="choosePath('research')"
      >
        <div class="setup-path-marker">01</div>
        <div class="setup-path-body">
          <div class="setup-path-head">Research and design it for me</div>
          <div class="setup-path-sub">
            An agent reads your brief, researches the org, and proposes a role
            shaped around your moats.
          </div>
          <div class="setup-path-note">
            You'll review and edit before seeding — nothing ships without your
            approval.
          </div>
          <div class="setup-path-chip">Beta · uses Claude Code</div>
        </div>
      </button>

      <button
        type="button"
        class="setup-path"
        :class="{ active: form.path === 'manual' }"
        @click="choosePath('manual')"
      >
        <div class="setup-path-marker">02</div>
        <div class="setup-path-body">
          <div class="setup-path-head">Define it yourself</div>
          <div class="setup-path-sub">
            Walk through voice, capabilities, and inhibitions yourself.
          </div>
          <div class="setup-path-note">
            Recommended if you've already drafted a persona elsewhere.
          </div>
          <div class="setup-path-chip">Hand-crafted</div>
        </div>
      </button>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 5 (manual): Voice                                           -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 5 && form.path === 'manual'">
    <h1 class="setup-title">How do they sound?</h1>
    <p class="setup-subtitle">
      Pair a short trait name with a concrete behaviour that shows what it
      looks like in practice. Aim for things you'd notice in a draft, not
      aspirational adjectives. One to eight traits.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-pair">
        <div class="ex-label">Warm but not chatty</div>
        <div class="ex-detail">drops articles in casual writing — "heading to lunch" not "I am heading to lunch"</div>
      </div>
    </div>

    <div class="setup-rows">
      <template x-for="(trait, idx) in form.voice_traits" :key="idx">
        <div class="setup-row">
          <div class="setup-row-num" x-text="String(idx + 1).padStart(2, '0')"></div>
          <div class="setup-row-fields setup-row-fields--pair">
            <input class="setup-input setup-input--inline" type="text" x-model="trait.label" placeholder="Warm but not chatty" />
            <input class="setup-input setup-input--inline" type="text" x-model="trait.detail" placeholder="drops articles, prefers single-sentence opens" />
          </div>
          <button
            type="button"
            class="setup-row-remove"
            aria-label="Remove trait"
            @click="form.voice_traits.splice(idx, 1)"
            :disabled="form.voice_traits.length <= 1"
          >×</button>
        </div>
      </template>
    </div>

    <button
      type="button"
      class="setup-add-row"
      @click="form.voice_traits.push({ label: '', detail: '' })"
      :disabled="form.voice_traits.length >= 8"
    >+ Add trait</button>

    <div class="setup-field-output">
      Each trait becomes a bullet under <code>## Voice &amp; Personality</code>
      in <code>persona.md</code>.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 5 (research): Handoff & wait                                -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 5 && form.path === 'research'">
    <h1 class="setup-title">Hand off to Claude Code.</h1>
    <p class="setup-subtitle">
      A research brief has been written into your repo. Open Claude Code in
      this directory and ask it to follow the brief — it'll research the org
      and write a persona draft back to <code>.praxis/persona-draft.md</code>.
      The wizard is watching for the file.
    </p>

    <template x-if="research.error">
      <div class="setup-error" x-text="research.error"></div>
    </template>

    <template x-if="research.brief_path">
      <div>
        <ol class="setup-handoff-steps">
          <li>Open a terminal.</li>
          <li><code>cd</code> into this repo.</li>
          <li>Run <code>claude</code>.</li>
          <li>
            Paste this prompt:
            <div class="setup-handoff-prompt">
              <code x-text="research.prompt"></code>
              <button
                type="button"
                class="setup-add-row"
                @click="copyPrompt()"
                :disabled="research.copied"
              >
                <span x-show="!research.copied">Copy</span>
                <span x-show="research.copied">Copied</span>
              </button>
            </div>
          </li>
          <li>
            Wait for Claude to write <code x-text="research.expected_draft_path"></code>.
            The wizard will detect it automatically.
          </li>
        </ol>

        <div class="setup-handoff-status">
          <span class="setup-handoff-pulse" :class="{ active: research.polling }"></span>
          <span x-show="!research.draft_loaded">
            Watching for <code x-text="research.expected_draft_path"></code>…
            <span class="setup-handoff-meta" x-text="research.last_checked ? `(last checked: ${research.last_checked})` : ''"></span>
          </span>
          <span x-show="research.draft_loaded" class="setup-handoff-ok">
            Draft loaded. Moving to review…
          </span>
        </div>

        <div class="setup-handoff-overrides">
          <button
            type="button"
            class="setup-add-row"
            @click="loadDraftNow()"
            :disabled="research.loading_now"
          >
            <span x-show="!research.loading_now">I've written it, load now</span>
            <span x-show="research.loading_now">Loading…</span>
          </button>
          <button
            type="button"
            class="setup-add-row setup-add-row--danger"
            @click="switchToManual()"
          >Skip and define manually instead</button>
        </div>
      </div>
    </template>

    <template x-if="!research.brief_path && research.preparing">
      <p class="setup-subtitle">Preparing the research brief…</p>
    </template>
  </div>

  <!-- ============================================================== -->
  <!-- Step 6 (manual): Capabilities                                    -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 6 && form.path === 'manual'">
    <h1 class="setup-title">What can they do?</h1>
    <p class="setup-subtitle">
      First-person statements — "I can …". What this role is qualified to do.
      Optional, up to ten.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-single">
        I can run cold-outreach campaigns end to end — research, draft, send,
        monitor, escalate when stuck.
      </div>
    </div>

    <div class="setup-rows">
      <template x-for="(item, idx) in form.capabilities" :key="idx">
        <div class="setup-row">
          <div class="setup-row-num" x-text="String(idx + 1).padStart(2, '0')"></div>
          <div class="setup-row-fields">
            <input class="setup-input setup-input--inline" type="text" x-model="form.capabilities[idx]" placeholder="I can run cold outreach end to end…" />
          </div>
          <button
            type="button"
            class="setup-row-remove"
            aria-label="Remove capability"
            @click="form.capabilities.splice(idx, 1)"
          >×</button>
        </div>
      </template>
    </div>

    <button
      type="button"
      class="setup-add-row"
      @click="form.capabilities.push('')"
      :disabled="form.capabilities.length >= 10"
    >+ Add capability</button>

    <div class="setup-field-output">
      Each line becomes a bullet under <code>## Capabilities</code>.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 7 (manual): Accountabilities                                -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 7 && form.path === 'manual'">
    <h1 class="setup-title">What do they own?</h1>
    <p class="setup-subtitle">
      First-person "I'm responsible for …" bullets. What the role drives
      toward, not what it can do. Bridges capabilities and success criteria.
      Optional, up to eight.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-single">
        I'm responsible for the quality of cold outreach drafts before they
        reach the operator.
      </div>
    </div>

    <div class="setup-rows">
      <template x-for="(item, idx) in form.accountabilities" :key="idx">
        <div class="setup-row">
          <div class="setup-row-num" x-text="String(idx + 1).padStart(2, '0')"></div>
          <div class="setup-row-fields">
            <input class="setup-input setup-input--inline" type="text" x-model="form.accountabilities[idx]" placeholder="I'm responsible for …" />
          </div>
          <button
            type="button"
            class="setup-row-remove"
            aria-label="Remove accountability"
            @click="form.accountabilities.splice(idx, 1)"
          >×</button>
        </div>
      </template>
    </div>

    <button
      type="button"
      class="setup-add-row"
      @click="form.accountabilities.push('')"
      :disabled="form.accountabilities.length >= 8"
    >+ Add accountability</button>

    <div class="setup-field-output">
      Each line becomes a bullet under <code>## Accountabilities</code>.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 8 (manual): Success criteria                                -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 8 && form.path === 'manual'">
    <h1 class="setup-title">How will they be measured?</h1>
    <p class="setup-subtitle">
      Observable, falsifiable outcomes — "drafts land in ≤2 review cycles",
      not "be helpful". The role uses these for end-of-run self-assessment.
      Optional, up to ten.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-single">
        Weekly account reads surface ≥1 actionable signal per watched account.
      </div>
    </div>

    <div class="setup-rows">
      <template x-for="(item, idx) in form.success_criteria" :key="idx">
        <div class="setup-row">
          <div class="setup-row-num" x-text="String(idx + 1).padStart(2, '0')"></div>
          <div class="setup-row-fields">
            <input class="setup-input setup-input--inline" type="text" x-model="form.success_criteria[idx]" placeholder="Drafts land in ≤2 review cycles." />
          </div>
          <button
            type="button"
            class="setup-row-remove"
            aria-label="Remove criterion"
            @click="form.success_criteria.splice(idx, 1)"
          >×</button>
        </div>
      </template>
    </div>

    <button
      type="button"
      class="setup-add-row"
      @click="form.success_criteria.push('')"
      :disabled="form.success_criteria.length >= 10"
    >+ Add criterion</button>

    <div class="setup-field-output">
      Each line becomes a bullet under <code>## Success criteria</code>. The
      role checks itself against these at end-of-run and writes a
      self-assessment memory entry.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 9 (manual): Inhibitions                                     -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 9 && form.path === 'manual'">
    <h1 class="setup-title">What do they never do?</h1>
    <p class="setup-subtitle">
      First-person "I never …" statements. The constitution — what this role
      refuses regardless of instruction. Optional, up to ten.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-single">
        I never claim certifications the org does not hold (e.g.
        "IRAP-assessed", "OFFICIAL: Sensitive").
      </div>
    </div>

    <div class="setup-rows">
      <template x-for="(item, idx) in form.inhibitions" :key="idx">
        <div class="setup-row setup-row--oxblood">
          <div class="setup-row-num" x-text="String(idx + 1).padStart(2, '0')"></div>
          <div class="setup-row-fields">
            <input class="setup-input setup-input--inline" type="text" x-model="form.inhibitions[idx]" placeholder="I never send an email without operator approval." />
          </div>
          <button
            type="button"
            class="setup-row-remove"
            aria-label="Remove inhibition"
            @click="form.inhibitions.splice(idx, 1)"
          >×</button>
        </div>
      </template>
    </div>

    <button
      type="button"
      class="setup-add-row"
      @click="form.inhibitions.push('')"
      :disabled="form.inhibitions.length >= 10"
    >+ Add inhibition</button>

    <div class="setup-field-output">
      Each line becomes a bullet under <code>## Hard inhibitions</code>. Worth
      knowing: these are surfaced in the dashboard's red-accented constitution
      panel.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- Step 10 (manual): Initial verbs                                  -->
  <!-- ============================================================== -->
  <div class="setup-step" x-show="step === 10 && form.path === 'manual'">
    <h1 class="setup-title">What playbooks do they ship with?</h1>
    <p class="setup-subtitle">
      Verbs are markdown playbooks Claude Code reads when triggered. Stub a
      few here if you already know the shape; you can also leave this empty
      and write them by hand later. Slug plus a one-line purpose. Up to five.
    </p>

    <div class="setup-example">
      <div class="setup-example-label">EXAMPLE</div>
      <div class="setup-example-pair">
