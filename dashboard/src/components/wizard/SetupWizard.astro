              <div class="setup-row-fields setup-row-fields--pair">
                <input class="setup-input setup-input--inline setup-input--mono" type="text" x-model="verb.slug" placeholder="account-read" />
                <input class="setup-input setup-input--inline" type="text" x-model="verb.purpose" placeholder="Weekly read…" />
