---
import type { VoiceTrait } from '@/lib/persona-parser';

/** A pane on /role's "Position description" group. Three shapes share this
 * component:
 * - `voice`: voice traits (canonical trait + zero-or-more qualifiers)
 * - `constitution`: hard inhibitions, rendered with a red rule + tinted bg
 *   and an ⊘ prefix on each item
 * - `list`: a plain bullet list (capabilities, accountabilities, success
 *   criteria). No qualifier sub-bullets, no special styling. */
type VoiceVariant = { variant: 'voice'; items: VoiceTrait[] };
type InhibitionsVariant = { variant: 'constitution'; items: string[] };
type ListVariant = { variant: 'list'; items: string[] };

type Props = {
  heading: string;
  source: string;
  empty: string;
} & (VoiceVariant | InhibitionsVariant | ListVariant);

const props = Astro.props;
const { heading, source, empty, variant, items } = props;
---

<div class:list={['persona-pane', variant === 'constitution' && 'constitution']}>
  <h5>{heading} <span class="src">{source}</span></h5>
  <ul>
    {items.length === 0 ? (
      <li>{empty}</li>
    ) : variant === 'voice' ? (
      (items as VoiceTrait[]).map((v) => (
        <li>
          <strong>{v.trait}</strong>
          {v.qualifiers.length > 0 ? <em>{v.qualifiers.join('; ')}</em> : null}
        </li>
      ))
    ) : (
      (items as string[]).map((line) => <li>{line}</li>)
    )}
  </ul>
</div>
