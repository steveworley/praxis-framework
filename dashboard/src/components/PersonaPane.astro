---
import type { VoiceTrait } from '@/lib/persona-parser';

/** A pane on /role's "Constitution" group. Two shapes share this component:
 * voice traits (canonical trait + zero-or-more qualifiers) and hard inhibitions
 * (single-line each). The `constitution` variant flips the visual treatment to
 * red-rule + tinted bg with an ⊘ prefix on each item — used for inhibitions. */
type VoiceVariant = { variant: 'voice'; items: VoiceTrait[] };
type InhibitionsVariant = { variant: 'constitution'; items: string[] };

type Props = {
  heading: string;
  source: string;
  empty: string;
} & (VoiceVariant | InhibitionsVariant);

const props = Astro.props;
const { heading, source, empty, variant, items } = props;
---

<div class:list={['persona-pane', variant === 'constitution' && 'constitution']}>
  <h5>{heading} <span class="src">{source}</span></h5>
  <ul>
    {items.length === 0 ? (
      <li>{empty}</li>
    ) : variant === 'voice' ? (
      (items as VoiceTrait[]).map((v) => (
        <li>
          <strong>{v.trait}</strong>
          {v.qualifiers.length > 0 ? <em>{v.qualifiers.join('; ')}</em> : null}
        </li>
      ))
    ) : (
      (items as string[]).map((line) => <li>{line}</li>)
    )}
  </ul>
</div>
