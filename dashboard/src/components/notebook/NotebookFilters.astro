---
import FilterChips, {
  type ChipOption,
} from '@/components/shared/FilterChips.astro';
import { buildChipHref } from '@/lib/ui/filter-href';

/**
 * The three filter rows on /notebook (category × age × visibility). Now
 * composes the shared `FilterChips` shell so the chip shape stays in sync
 * across journal-shaped surfaces.
 *
 * The page-side API is unchanged: it still passes `categories`, `ages`,
 * `visibilities` and `active`, and the component handles href construction
 * via the shared `buildChipHref` helper. Defaults (cat=all, age=any,
 * vis=live) are encoded here because they're notebook-specific.
 */
export interface FilterOption {
  key: string;
  label: string;
  count: number | null;
}

interface Props {
  categories: FilterOption[];
  ages: FilterOption[];
  visibilities: FilterOption[];
  active: { cat: string; age: string; vis: string };
}

const { categories, ages, visibilities, active } = Astro.props;

const DEFAULTS = { cat: 'all', age: 'any', vis: 'live' };

function toChipOptions(
  group: 'cat' | 'age' | 'vis',
  opts: FilterOption[],
): ChipOption[] {
  return opts.map((o) => ({
    value: o.key,
    label: o.label,
    count: o.count ?? undefined,
    href: buildChipHref({
      pathname: '/notebook',
      current: active,
      group,
      value: o.key,
      defaults: DEFAULTS,
    }),
  }));
}
---

<section class="nb-filters">
  <FilterChips
    label="category"
    current={active.cat}
    options={toChipOptions('cat', categories)}
  />
  <FilterChips
    label="age"
    current={active.age}
    options={toChipOptions('age', ages)}
  />
  <FilterChips
    label="visibility"
    current={active.vis}
    options={toChipOptions('vis', visibilities)}
  />
</section>
