---
import ActivityEntry from '@/components/activity/ActivityEntry.astro';
import StatsStrip from '@/components/notebook/StatsStrip.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import FilterChips, {
  type ChipOption,
} from '@/components/shared/FilterChips.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assembleActivity, type ActivityEntry as ActivityEntryType } from '@/lib/activity-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { bucketByDay, recentActivityCount } from '@/lib/recent-stats';
import { detectMode, getLogGlob, getRoleHome, nowIso } from '@/lib/role-home';
import { buildChipHref } from '@/lib/ui/filter-href';

/**
 * /activity — journal-shaped event feed. Day-grouped, latest first. Each
 * day starts with a hairline rule + italic label ("Thu, 14 May · 11
 * entries"); inside the group, events render as gutter-rail rows via
 * `ActivityEntry`.
 *
 * Filter state: `?action=<kind>` query param (chip nav, no JS for paint).
 * Defaults to `all`.
 */

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const logGlob = getLogGlob();
const [personaRes, activityRes] = await Promise.allSettled([
  parsePersona(roleHome),
  assembleActivity(roleHome, logGlob, 200),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const activity: ActivityEntryType[] = activityRes.status === 'fulfilled' ? activityRes.value : [];
const activityError = activityRes.status === 'rejected' ? String(activityRes.reason) : null;

const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
const updatedAt = nowIso();

const actionCounts: Record<string, number> = {};
for (const e of activity) {
  const action = typeof e.action === 'string' && e.action.length > 0 ? e.action : 'other';
  actionCounts[action] = (actionCounts[action] ?? 0) + 1;
}
const actionKeys = Object.keys(actionCounts).sort();

const rawAction = Astro.url.searchParams.get('action') ?? 'all';
const KNOWN_ACTIONS = new Set(['all', ...actionKeys]);
const activeAction = KNOWN_ACTIONS.has(rawAction) ? rawAction : 'all';

const filteredActivity = activity.filter((e) => {
  if (activeAction === 'all') return true;
  const a = typeof e.action === 'string' && e.action.length > 0 ? e.action : 'other';
  return a === activeAction;
});

const buckets = bucketByDay(filteredActivity);
const todayCount = recentActivityCount(activity, 1);
const weekCount = recentActivityCount(activity, 7);
const decisions7d = recentActivityCount(
  activity.filter((e) => e.action === 'decision'),
  7,
);
const toolCalls7d = recentActivityCount(
  activity.filter((e) => e.action === 'tool_call'),
  7,
);

const ACT_DEFAULTS = { action: 'all' };

function kindChips(): ChipOption[] {
  const opts: Array<Omit<ChipOption, 'href'>> = [
    { value: 'all', label: 'all', count: activity.length },
    ...actionKeys.map((k) => ({
      value: k,
      label: k === 'decision' ? 'decisions' : k,
      count: actionCounts[k] ?? 0,
    })),
  ];
  return opts.map((o) => ({
    ...o,
    href: buildChipHref({
      pathname: '/activity',
      current: { action: activeAction },
      group: 'action',
      value: o.value,
      defaults: ACT_DEFAULTS,
    }),
  }));
}

function personaShort(p: Persona | null): string {
  const ident = p?.identity ?? {};
  const full = (ident['full_name'] ?? ident['name'] ?? '').trim();
  const idx = full.indexOf(' ');
  return idx < 0 ? (full || 'The role') : full.slice(0, idx);
}
const subject = personaShort(persona);
const title = persona ? `What ${subject} has been doing` : "What I've been doing";
const sub = persona
  ? `${subject}'s working trace — tool calls, decisions, verb runs — latest first.`
  : "The role's working trace — tool calls, decisions, verb runs — latest first.";
---

<BaseLayout title={fullName ? `Activity · ${fullName}` : 'Activity · Praxis'}>
  <main class="container">
    <RouteHeader
      current="activity"
      personaName={fullName}
      updatedAt={updatedAt}
    />

    <section class="nb-hero">
      <div class="hero-left">
        <div class="pill purple">ACTIVITY</div>
        <h1>{title}</h1>
        <div class="sub">{sub}</div>
      </div>
      <StatsStrip
        colour="purple"
        stats={[
          { label: 'today', value: todayCount, accent: true },
          { label: 'this week', value: weekCount },
          { label: 'decisions 7d', value: decisions7d },
          { label: 'tool calls 7d', value: toolCalls7d },
        ]}
      />
    </section>

    {activityError ? (
      <div class="nb-empty">Failed to load activity: {activityError}</div>
    ) : activity.length === 0 ? (
      <div class="nb-empty">No activity logged yet.</div>
    ) : (
      <>
        <section class="nb-filters">
          <FilterChips label="kind" current={activeAction} options={kindChips()} />
        </section>

        {buckets.length === 0 ? (
          <div class="nb-empty">No activity matches the current filter.</div>
        ) : (
          <section class="entries activity-entries">
            {buckets.map((bucket) => (
              <Fragment>
                <div class="day-header">
                  <span class="day-label">{bucket.label}</span>
                  <span class="day-count">
                    {bucket.items.length} {bucket.items.length === 1 ? 'entry' : 'entries'}
                  </span>
                </div>
                {bucket.items.map((entry) => <ActivityEntry entry={entry} />)}
              </Fragment>
            ))}
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>

<style>
  .nb-hero .hero-left .pill.purple {
    background: var(--purple);
    color: var(--surface);
  }

  /* Day-header rule. Sits between groups of activity entries — italic
     Source Serif 4 label, hairline rule, mono count caption. */
  .day-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    padding: 1.4rem 0 0.4rem;
    margin-top: 0.6rem;
    border-top: 2px solid var(--ink);
  }
  .day-header:first-of-type {
    margin-top: 0;
    border-top: none;
  }
  .day-label {
    font-family: var(--display);
    font-style: italic;
    font-weight: 500;
    font-size: 16px;
    color: var(--ink-soft);
  }
  .day-count {
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  /* The activity entry shell already pads itself; remove the default top
     rule on the first entry of each day group so the day-header carries the
     visual break. */
  .activity-entries :global(.entry.activity-entry) {
    border-top: 1px solid var(--rule);
  }
</style>
