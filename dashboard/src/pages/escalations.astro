---
import EscalationEntry from '@/components/escalations/EscalationEntry.astro';
import StatsStrip from '@/components/notebook/StatsStrip.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import FilterChips, {
  type ChipOption,
} from '@/components/shared/FilterChips.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assembleEscalations, type EscalationEntry as EscalationEntryType, type EscalationsResult } from '@/lib/escalations-loader';
import { loadHealth } from '@/lib/health-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import { buildChipHref } from '@/lib/ui/filter-href';
import { daysSince } from '@/lib/ui/time';

/**
 * /escalations — journal-shaped triage + audit surface. Replaces the
 * flat-card layout from PR #51 with the gutter+body shell shared with
 * /notebook, /output and /activity.
 *
 * Filter state lives in `?status=&kind=` query params (anchor-chip
 * navigation, no JS required for paint). The `?status=open` default from
 * PR #51 still applies — landing on /escalations after a notification
 * narrows to the open queue automatically.
 *
 * Action affordances on open entries (Accept / Decline / review draft →)
 * are rendered inline by `EscalationActions` mounted from
 * `EscalationEntry`; their `/api/triage/*` contracts are unchanged.
 */

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, escalationsRes, healthRes] = await Promise.allSettled([
  parsePersona(roleHome),
  assembleEscalations(roleHome),
  loadHealth(roleHome),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const escalations: EscalationsResult | null =
  escalationsRes.status === 'fulfilled' ? escalationsRes.value : null;
const escalationError =
  escalationsRes.status === 'rejected' ? String(escalationsRes.reason) : null;
const health = healthRes.status === 'fulfilled' ? healthRes.value : null;

const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
const updatedAt = nowIso();

const entries: EscalationEntryType[] = escalations?.entries ?? [];
const counts = escalations?.countsByStatus ?? { open: 0, resolved: 0, accepted: 0, declined: 0 };

// Resolved within the last 7 days — quick "have I been triaging?" signal.
const resolved7d = entries.filter((e) => {
  if (e.status !== 'resolved' && e.status !== 'accepted' && e.status !== 'declined') return false;
  const d = daysSince(e.created);
  return d !== null && d <= 7;
}).length;

const medianTtt = health?.escalations.median_time_to_triage_days ?? null;
const medianTttDisplay = (() => {
  if (medianTtt === null) return '—';
  if (medianTtt < 1) {
    // Sub-day medians arrive as fractional days; show as hours rounded down
    // (1h floor so a 5-minute triage doesn't read as "0h").
    const hours = Math.max(1, Math.round(medianTtt * 24));
    return `${hours}h`;
  }
  return `${Math.round(medianTtt)}d`;
})();

const kindCounts: Record<string, number> = {};
for (const e of entries) {
  kindCounts[e.kind] = (kindCounts[e.kind] ?? 0) + 1;
}

const KNOWN_STATUSES = new Set(['all', 'open', 'triaged', 'resolved', 'accepted', 'declined']);
const KNOWN_KINDS = new Set(['all', 'help', 'improvement', 'proposed_skill', 'criterion_drift']);
const rawStatus = Astro.url.searchParams.get('status');
const rawKind = Astro.url.searchParams.get('kind');
const activeStatus = rawStatus && KNOWN_STATUSES.has(rawStatus) ? rawStatus : 'open';
const activeKind = rawKind && KNOWN_KINDS.has(rawKind) ? rawKind : 'all';

// `triaged` is a meta-status meaning "accepted OR declined" — the operator's
// take-down queue. It rolls up the two terminal states without `resolved`.
function statusMatches(entry: EscalationEntryType, axis: string): boolean {
  if (axis === 'all') return true;
  if (axis === 'triaged') return entry.status === 'accepted' || entry.status === 'declined';
  return entry.status === axis;
}

const filteredEntries = entries.filter((e) => {
  if (!statusMatches(e, activeStatus)) return false;
  if (activeKind !== 'all' && e.kind !== activeKind) return false;
  return true;
});

const ESC_DEFAULTS = { status: 'open', kind: 'all' };
const escCurrent = { status: activeStatus, kind: activeKind };

function statusChips(): ChipOption[] {
  const opts = [
    { value: 'all', label: 'all', count: entries.length },
    { value: 'open', label: 'open', count: counts.open },
    { value: 'triaged', label: 'triaged', count: counts.accepted + counts.declined },
    { value: 'resolved', label: 'resolved', count: counts.resolved },
    { value: 'accepted', label: 'accepted', count: counts.accepted },
    { value: 'declined', label: 'declined', count: counts.declined },
  ];
  return opts.map((o) => ({
    ...o,
    href: buildChipHref({
      pathname: '/escalations',
      current: escCurrent,
      group: 'status',
      value: o.value,
      defaults: ESC_DEFAULTS,
    }),
  }));
}

function kindChips(): ChipOption[] {
  const opts: Array<Omit<ChipOption, 'href'>> = [
    { value: 'all', label: 'all' },
    { value: 'help', label: 'help', count: kindCounts['help'] ?? 0 },
    { value: 'improvement', label: 'improvement', count: kindCounts['improvement'] ?? 0 },
    { value: 'proposed_skill', label: 'proposed_skill', count: kindCounts['proposed_skill'] ?? 0 },
    { value: 'criterion_drift', label: 'criterion_drift', count: kindCounts['criterion_drift'] ?? 0 },
  ];
  return opts.map((o) => ({
    ...o,
    href: buildChipHref({
      pathname: '/escalations',
      current: escCurrent,
      group: 'kind',
      value: o.value,
      defaults: ESC_DEFAULTS,
    }),
  }));
}

function personaShort(p: Persona | null): string {
  const ident = p?.identity ?? {};
  const full = (ident['full_name'] ?? ident['name'] ?? '').trim();
  const idx = full.indexOf(' ');
  return idx < 0 ? (full || 'the role') : full.slice(0, idx);
}

const personaSubject = personaShort(persona);
const title = persona ? `What ${personaSubject} has flagged` : "What I've flagged";
const sub = persona
  ? `Help requests, process improvements, proposed skills, and criterion drift — ${personaSubject}'s open audit trail.`
  : 'Help requests, process improvements, proposed skills, and criterion drift — the role\'s open audit trail.';
---

<BaseLayout title={fullName ? `Escalations · ${fullName}` : 'Escalations · Praxis'}>
  <main class="container">
    <RouteHeader
      current="escalations"
      personaName={fullName}
      updatedAt={updatedAt}
    />

    <section class="nb-hero">
      <div class="hero-left">
        <div class="pill pink">ESCALATIONS</div>
        <h1>{title}</h1>
        <div class="sub">{sub}</div>
      </div>
      <StatsStrip
        colour="pink"
        stats={[
          { label: 'open', value: counts.open, accent: true },
          { label: 'filed', value: entries.length },
          { label: 'median ttt (28d)', value: medianTttDisplay },
          { label: 'resolved 7d', value: resolved7d },
        ]}
      />
    </section>

    {escalationError ? (
      <div class="nb-empty">Failed to load escalations: {escalationError}</div>
    ) : entries.length === 0 ? (
      <div class="nb-empty">
        Nothing flagged. Anything {personaSubject} can't resolve will land here.
      </div>
    ) : (
      <>
        <section class="nb-filters">
          <FilterChips label="status" current={activeStatus} options={statusChips()} />
          <FilterChips label="kind" current={activeKind} options={kindChips()} />
        </section>

        {filteredEntries.length === 0 ? (
          <div class="nb-empty">
            Nothing matches these filters.{' '}
            <a href="/escalations" class="clear-filters">clear filters →</a>
          </div>
        ) : (
          <section class="entries">
            {filteredEntries.map((e) => <EscalationEntry escalation={e} />)}
          </section>
        )}
      </>
    )}
  </main>

  <script is:inline src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</BaseLayout>

<style>
  /* Section-pill colour override for the escalations surface. The base
     `.nb-hero .hero-left .pill` rule in global.css paints peach by default. */
  .nb-hero .hero-left .pill.pink {
    background: var(--pink);
    color: var(--ink);
  }
</style>
