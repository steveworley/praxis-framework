---
/**
 * Legacy /triage route — redirects to /escalations?status=open. The triage
 * queue is now merged into /escalations, where each open card carries its
 * own action affordances (accept / decline / review-draft). The sub-routes
 * under /triage/draft/* and the action handlers under /api/triage/* keep
 * their current paths; operators reach the draft surface via the
 * `review draft →` link on proposed_skill escalation cards.
 */
export const prerender = false;
return Astro.redirect('/escalations?status=open');
---
