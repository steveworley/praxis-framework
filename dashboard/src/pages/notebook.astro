---
import NotebookEntry from '@/components/notebook/NotebookEntry.astro';
import NotebookFilters, {
  type FilterOption,
} from '@/components/notebook/NotebookFilters.astro';
import StatsStrip from '@/components/notebook/StatsStrip.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assembleMemory, type MemoryEntry } from '@/lib/memory-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { recentMemoryCount } from '@/lib/recent-stats';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import { daysSince } from '@/lib/ui/time';

/**
 * /notebook — journal-shaped redesign. Three sections:
 *
 *   1. Hero: peach pill + 48px Fraunces title + italic sub + 4-stat strip.
 *   2. Filters: category × age × visibility (anchor-chip navigation, no JS).
 *      The active filter state is encoded in `?cat=&age=&vis=` query params.
 *   3. Entries: 14em gutter (category pill + date + slug) + body. Hairline
 *      rule between entries; no card chrome.
 *
 * Filtering is server-side via query params — `?cat=conversations` returns a
 * page where only conversation entries pass through the filter. The page-
 * level script that powered the previous filter chips is gone; the new chips
 * are anchors and progressive-enhancement-friendly.
 */

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, memoryRes] = await Promise.allSettled([
  parsePersona(roleHome),
  assembleMemory(roleHome),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const memoryEntries: MemoryEntry[] = memoryRes.status === 'fulfilled' ? memoryRes.value : [];
const memoryError = memoryRes.status === 'rejected' ? String(memoryRes.reason) : null;

const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
const updatedAt = nowIso();

const liveEntries = memoryEntries.filter((e) => !e.archived);
const archivedEntries = memoryEntries.filter((e) => e.archived);

const categoryCounts: Record<string, number> = {};
for (const e of liveEntries) {
  categoryCounts[e.category] = (categoryCounts[e.category] ?? 0) + 1;
}
const categoryKeys = Object.keys(categoryCounts).sort();

// Filter parsing — accept any value but normalise to the known keyset; an
// unknown filter falls through to the "show everything" default for that
// axis so a stale link doesn't paint an empty page.
const KNOWN_CATS = new Set(['all', ...categoryKeys]);
const KNOWN_AGES = new Set(['any', 'week', 'month', 'stale']);
const KNOWN_VIS = new Set(['live', 'archived', 'both']);

const rawCat = Astro.url.searchParams.get('cat') ?? 'all';
const rawAge = Astro.url.searchParams.get('age') ?? 'any';
const rawVis = Astro.url.searchParams.get('vis') ?? 'live';

const activeCat = KNOWN_CATS.has(rawCat) ? rawCat : 'all';
const activeAge = KNOWN_AGES.has(rawAge) ? rawAge : 'any';
const activeVis = KNOWN_VIS.has(rawVis) ? rawVis : 'live';

const ageCounts = { week: 0, month: 0, stale: 0 };
for (const e of liveEntries) {
  const days = daysSince(e.updated ?? e.created);
  if (days === null) continue;
  if (days <= 7) ageCounts.week += 1;
  if (days <= 30) ageCounts.month += 1;
  if (days >= 60) ageCounts.stale += 1;
}

const categoryFilters: FilterOption[] = [
  { key: 'all', label: 'all', count: liveEntries.length },
  ...categoryKeys.map((k) => ({ key: k, label: k, count: categoryCounts[k] ?? 0 })),
];
const ageFilters: FilterOption[] = [
  { key: 'any', label: 'any age', count: null },
  { key: 'week', label: '≤7d', count: ageCounts.week },
  { key: 'month', label: '≤30d', count: ageCounts.month },
  { key: 'stale', label: '60d+ stale', count: ageCounts.stale },
];
const visibilityFilters: FilterOption[] = [
  { key: 'live', label: 'live', count: liveEntries.length },
  { key: 'archived', label: 'archived', count: archivedEntries.length },
  { key: 'both', label: 'both', count: memoryEntries.length },
];

// Apply filters server-side. The entries surfaced are whatever survives all
// three filters ANDed together.
function ageMatches(entry: MemoryEntry, axis: string): boolean {
  if (axis === 'any') return true;
  const days = daysSince(entry.updated ?? entry.created);
  if (days === null) return false;
  if (axis === 'week') return days <= 7;
  if (axis === 'month') return days <= 30;
  if (axis === 'stale') return days >= 60;
  return true;
}
function visMatches(entry: MemoryEntry, axis: string): boolean {
  if (axis === 'both') return true;
  if (axis === 'archived') return entry.archived;
  return !entry.archived; // 'live'
}

const filteredEntries = memoryEntries.filter((e) => {
  if (activeCat !== 'all' && e.category !== activeCat) return false;
  if (!ageMatches(e, activeAge)) return false;
  if (!visMatches(e, activeVis)) return false;
  return true;
});

// Stats strip values
const thisWeek = recentMemoryCount(liveEntries, 7);
const total = liveEntries.length;
const sinceLastDays = (() => {
  const latest = liveEntries[0]?.updated ?? liveEntries[0]?.created;
  const d = daysSince(latest);
  if (d === null) return '—';
  if (d <= 0) return 'today';
  if (d === 1) return '1d';
  return `${d}d`;
})();

const sub = persona
  ? `${personaShort(persona)}'s persona-shaped memory feed — entries the role wrote, sorted by recency.`
  : 'Persona-shaped memory feed — entries the role wrote, sorted by recency.';

function personaShort(p: Persona | null): string {
  const ident = p?.identity ?? {};
  const full = (ident['full_name'] ?? ident['name'] ?? '').trim();
  const idx = full.indexOf(' ');
  return idx < 0 ? (full || 'the role') : full.slice(0, idx);
}

const title = persona ? `What ${personaShort(persona)} has noticed` : "What I've remembered";
---

<BaseLayout title={fullName ? `Notebook · ${fullName}` : 'Notebook · Praxis'}>
  <main class="container">
    <RouteHeader
      current="notebook"
      personaName={fullName}
      updatedAt={updatedAt}
    />

    <section class="nb-hero">
      <div class="hero-left">
        <div class="pill">NOTEBOOK</div>
        <h1>{title}</h1>
        <div class="sub">{sub}</div>
      </div>
      <StatsStrip
        colour="peach"
        stats={[
          { label: 'this week', value: thisWeek > 0 ? `+${thisWeek}` : '0', accent: true },
          { label: 'total', value: total },
          { label: 'since last', value: sinceLastDays },
          { label: 'archived', value: archivedEntries.length },
        ]}
      />
    </section>

    {memoryError ? (
      <div class="nb-empty">Failed to load notebook: {memoryError}</div>
    ) : memoryEntries.length === 0 ? (
      <div class="nb-empty">
        Nothing in memory yet. As {personaShort(persona)} writes, entries will surface here.
      </div>
    ) : (
      <>
        <NotebookFilters
          categories={categoryFilters}
          ages={ageFilters}
          visibilities={visibilityFilters}
          active={{ cat: activeCat, age: activeAge, vis: activeVis }}
        />

        {filteredEntries.length === 0 ? (
          <div class="nb-empty">
            Nothing matches these filters.{' '}
            <a href="/notebook" class="clear-filters">clear filters →</a>
          </div>
        ) : (
          <section class="entries">
            {filteredEntries.map((entry) => <NotebookEntry entry={entry} />)}
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>
