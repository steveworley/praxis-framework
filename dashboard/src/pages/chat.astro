---
import ChatComposer from '@/components/chat/ChatComposer.astro';
import GreetingHero from '@/components/chat/GreetingHero.astro';
import PendingChip from '@/components/chat/PendingChip.astro';
import RecentThread from '@/components/chat/RecentThread.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hasApiKey } from '@/lib/chat/anthropic.js';
import { listThreads, type ThreadSummary } from '@/lib/chat/conversation.js';
import { buildGreeting } from '@/lib/chat/greeting.js';
import { personaNameFrom } from '@/lib/chat/persona-name.js';
import { buildSystemPrompt } from '@/lib/chat/system-prompt.js';
import { estimateTokens } from '@/lib/chat/tokens.js';
import { assembleEscalations } from '@/lib/escalations-loader.js';
import { assembleMemory } from '@/lib/memory-loader.js';
import { parsePersona } from '@/lib/persona-parser.js';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home.js';

/**
 * /chat — chat-as-home. Greeting hero + pending chips + recent threads +
 * sticky composer. Honours the existing conversation flow (`praxisChat()`
 * Alpine island wiring through `/api/chat/*`) — when there's an active
 * thread the transcript appears between the hero and the composer.
 *
 * Disabled state: when `ANTHROPIC_API_KEY` is absent we still render the
 * greeting + composer chrome, but the composer textarea is disabled and the
 * hint explains how to enable. Recent threads still surface from disk
 * because they're just `memory/conversations/` files — the user can still
 * read prior conversations even when sending is off.
 */

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, threadsRes, systemPromptRes, escalationsRes, memoryRes] =
  await Promise.allSettled([
    parsePersona(roleHome),
    listThreads(roleHome),
    buildSystemPrompt(roleHome),
    assembleEscalations(roleHome),
    assembleMemory(roleHome),
  ]);

const persona = personaRes.status === 'fulfilled' ? personaRes.value : null;
const threads: ThreadSummary[] = threadsRes.status === 'fulfilled' ? threadsRes.value : [];

const systemPromptText =
  systemPromptRes.status === 'fulfilled' ? systemPromptRes.value : '';
const systemPromptTokens = estimateTokens(systemPromptText);

const personaName = personaNameFrom(persona);
const initialThreadId =
  (Astro.url.searchParams.get('thread') ?? '').trim() || '';
const apiKeyConfigured = await hasApiKey();
const updatedAt = nowIso();

// Greeting input. Counts come from the escalations loader; `localHour` is the
// dashboard process's local hour (the dashboard runs alongside the role, so
// the server clock is the right one to greet by — there's no "operator
// timezone" abstraction yet).
const escalations = escalationsRes.status === 'fulfilled' ? escalationsRes.value : null;
const escalationOpenCount = escalations?.countsByStatus.open ?? 0;

// Count escalations by kind so we can render colour-coded chips ("IMPROVEMENT 2"
// etc.). Only open ones — closed escalations aren't "on the desk".
const openKindCounts: Record<string, number> = {};
for (const e of escalations?.entries ?? []) {
  if (e.status !== 'open') continue;
  openKindCounts[e.kind] = (openKindCounts[e.kind] ?? 0) + 1;
}

// `PRAXIS_OPERATOR_NAME` lets the host harness inject the operator's name
// without hardcoding "Steve" in the dashboard.
const operatorName = (process.env['PRAXIS_OPERATOR_NAME'] ?? '').trim() || undefined;

const greeting = buildGreeting({
  personaShort: personaName.short,
  localHour: new Date().getHours(),
  escalationOpenCount,
  ...(operatorName ? { operatorName } : {}),
});

// Recent threads — pull the 5 most-recent `conversations` memory entries.
// These are the markdown files chat conversations land in as they happen, so
// the list reads as "your last few conversations" without needing a separate
// loader.
const memoryEntries = memoryRes.status === 'fulfilled' ? memoryRes.value : [];
const recentConversationEntries = memoryEntries
  .filter((e) => e.category === 'conversations' && !e.archived)
  .slice(0, 5);

const bootstrap = {
  threads,
  initialThreadId,
  apiKeyConfigured,
  personaName,
  systemPromptTokens,
  contextWindowTokens: 200_000,
  banner50kThreshold: 50_000,
};

// Build the chip set: one chip per kind that has at least one open card,
// plus the catch-all "open escalations" chip when there's any open at all.
// Kinds map to the colour-coded variants in the mockup. Only `proposed_skill`
// uses purple — everything else (improvement / help / criterion_drift) is pink
// because they're all read on `/escalations`.
const KIND_LABELS: Record<string, string> = {
  improvement: 'improvement',
  help: 'help',
  proposed_skill: 'proposed skill',
  criterion_drift: 'criterion drift',
};
const PURPLE_KINDS = new Set(['proposed_skill']);
const kindChips = Object.entries(openKindCounts)
  .filter(([, count]) => count > 0)
  .sort((a, b) => b[1] - a[1])
  .map(([kind, count]) => ({
    kind,
    count,
    label: KIND_LABELS[kind] ?? kind,
    variant: (PURPLE_KINDS.has(kind) ? 'purple' : 'pink') as 'pink' | 'purple',
    // `/escalations` doesn't yet support a `kind` query param (Phase 2 step 4
    // will add it). Until then every chip lands on the open filter.
    href: '/escalations?status=open',
  }));
const hasPending = kindChips.length > 0;
---

<BaseLayout title={persona ? `Chat · ${personaName.full}` : 'Chat · Praxis'}>
  <main class="container">
    <RouteHeader
      current="chat"
      personaName={persona ? personaName.full : ''}
      updatedAt={updatedAt}
    />

    <div class="chat-stage" x-data="praxisChat()" x-init="init()">
      {/* Hero block — only shown when no thread is active. Once the operator
          starts a conversation it gives way to the transcript above the
          composer. The transcript is conditionally rendered by Alpine
          ("when activeThreadId" via x-show below); the static hero is
          rendered server-side and hidden client-side when a thread is
          loaded — that keeps a meaningful first paint for unauthenticated /
          API-key-less visits. */}
      <div x-show="!activeThreadId" x-cloak>
        <GreetingHero greeting={greeting} />

        {hasPending && (
          <div class="pending-row">
            <span class="label-pre">on your desk</span>
            {kindChips.map((chip) => (
              <PendingChip
                count={chip.count}
                label={chip.label}
                href={chip.href}
                variant={chip.variant}
              />
            ))}
          </div>
        )}

        <section class="threads" style="margin-top: 2rem;">
          <header class="threads-head">
            <span class="h">recent threads</span>
            <a class="a" href="/notebook?cat=conversations">all threads →</a>
          </header>
          {recentConversationEntries.length === 0 ? (
            <div class="thread-empty">
              No threads yet — anything {personaName.short} writes back will appear here.
            </div>
          ) : (
            recentConversationEntries.map((entry) => <RecentThread entry={entry} />)
          )}
        </section>
      </div>

      {/* Chat transcript — only when there's an active thread. The Alpine
          island manages turns, sending, summarising, etc. — markup mirrors
          the previous /chat surface but uses the new chat-stage classes. */}
      <div class="chat-transcript" x-show="activeThreadId" x-ref="transcript" x-cloak>
        <div class="chat-error" x-show="error" x-text="error"></div>

        <template x-if="loadingTurns">
          <div class="chat-empty-hint">Loading…</div>
        </template>
        <template x-for="(turn, idx) in turns" :key="`${activeThreadId}-${idx}`">
          <article class="chat-turn" :class="`role-${turn.role}`">
            <header class="chat-turn-head">
              <span
                class="chat-turn-role"
                x-text="turn.role === 'summary' ? summaryHeading(turn) : (turn.role === 'user' ? 'YOU' : personaShort.toUpperCase())"
              ></span>
              <span class="chat-turn-time" x-text="formatTimestamp(turn.timestamp)"></span>
            </header>
            <div class="prose" x-html="turn.content_html"></div>
          </article>
        </template>
        <template x-if="pendingAssistant">
          <article class="chat-turn role-assistant chat-turn-pending" aria-busy="true" aria-label="awaiting response">
            <header class="chat-turn-head">
              <span class="chat-turn-role" x-text="personaShort.toUpperCase()"></span>
              <span class="chat-turn-time">thinking…</span>
            </header>
            {/* Shimmer placeholder — four pill rows with alternating widths
                that read as in-flight prose. The sweep animation lives in
                .chat-shimmer-pill below. */}
            <div class="chat-shimmer">
              <span class="chat-shimmer-pill" style="width: 82%;"></span>
              <span class="chat-shimmer-pill" style="width: 66%;"></span>
              <span class="chat-shimmer-pill" style="width: 91%;"></span>
              <span class="chat-shimmer-pill" style="width: 48%;"></span>
            </div>
          </article>
        </template>
      </div>

      <ChatComposer apiKeyConfigured={apiKeyConfigured} personaShort={personaName.short} />
    </div>
  </main>

  <style is:global>
    /* x-cloak: hide elements until Alpine evaluates the show/if condition,
       avoiding a flash of both hero + transcript on first paint. */
    [x-cloak] { display: none !important; }
  </style>

  <script
    is:inline
    define:vars={{ bootstrap }}
  >
    window.__praxisChatBootstrap = bootstrap;
  </script>
  <script is:inline src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script is:inline>
    function praxisChat() {
      const boot = window.__praxisChatBootstrap || { threads: [], initialThreadId: '', personaName: null };
      const persona = boot.personaName || { full: 'the role', short: 'the role', identifier: '' };
      return {
        threads: boot.threads || [],
        activeThreadId: boot.initialThreadId || '',
        activeTitle: '',
        activeUpdated: '',
        personaFull: persona.full,
        personaShort: persona.short,
        personaTitle: persona.title || '',
        turns: [],
        composer: '',
        attachments: [],
        sending: false,
        pendingAssistant: false,
        loadingTurns: false,
        error: '',
        systemPromptTokens: boot.systemPromptTokens || 0,
        contextWindowTokens: boot.contextWindowTokens || 200000,

        init() {
          const initialThread = this.threads.find((t) => t.thread_id === this.activeThreadId);
          if (initialThread) {
            this.activeTitle = initialThread.title;
            this.activeUpdated = initialThread.updated;
            this.loadActiveThread();
          }
        },

        get canSend() {
          return !this.sending && this.composer.trim().length > 0;
        },

        async loadActiveThread() {
          if (!this.activeThreadId) {
            this.turns = [];
            return;
          }
          this.loadingTurns = true;
          this.error = '';
          try {
            const res = await fetch(`/api/chat/threads/${encodeURIComponent(this.activeThreadId)}`);
            if (!res.ok) throw new Error(`Thread fetch failed (${res.status})`);
            const body = await res.json();
            this.activeTitle = body.thread.title;
            this.activeUpdated = body.thread.updated;
            this.turns = body.turns || [];
          } catch (e) {
            this.error = `Could not load conversation: ${e instanceof Error ? e.message : String(e)}`;
            this.turns = [];
          } finally {
            this.loadingTurns = false;
          }
        },

        async refreshThreadList() {
          try {
            const res = await fetch('/api/chat/threads');
            if (!res.ok) return;
            const body = await res.json();
            this.threads = body.threads || [];
          } catch (_) {
            /* keep stale list */
          }
        },

        async send() {
          const content = this.composer.trim();
          if (!content || this.sending) return;
          this.sending = true;
          this.error = '';

          if (!this.activeThreadId) {
            try {
              const res = await fetch('/api/chat/threads', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ first_message: content }),
              });
              if (!res.ok) {
                const errBody = await res.json().catch(() => ({}));
                throw new Error(errBody.error || `Could not create thread (${res.status})`);
              }
              const body = await res.json();
              this.activeThreadId = body.thread_id;
              this.activeTitle = body.title;
              this.composer = '';
              this.updateUrl();
              const now = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
              this.turns = [{ role: 'user', timestamp: now, content, content_html: this.escapeAsHtml(content) }];
              this.pendingAssistant = true;
              await this.runMessage(content);
            } catch (e) {
              this.error = e instanceof Error ? e.message : String(e);
              this.sending = false;
              this.pendingAssistant = false;
            }
            return;
          }

          const optimisticNow = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
          this.turns.push({ role: 'user', timestamp: optimisticNow, content, content_html: this.escapeAsHtml(content) });
          this.composer = '';
          this.pendingAssistant = true;
          await this.runMessage(content);
        },

        async runMessage(content) {
          try {
            const body = { thread_id: this.activeThreadId, content };
            const res = await fetch('/api/chat/message', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!res.ok) {
              const errBody = await res.json().catch(() => ({}));
              throw new Error(errBody.error || `Send failed (${res.status})`);
            }
            const replyBody = await res.json();
            const assistantTurn = {
              role: 'assistant',
              timestamp: replyBody.timestamp || new Date().toISOString(),
              content: replyBody.content,
              content_html: replyBody.content_html || this.escapeAsHtml(replyBody.content || ''),
            };
            this.turns.push(assistantTurn);
            await this.refreshThreadList();
          } catch (e) {
            this.error = e instanceof Error ? e.message : String(e);
          } finally {
            this.sending = false;
            this.pendingAssistant = false;
          }
        },

        updateUrl() {
          const url = new URL(window.location.href);
          if (this.activeThreadId) {
            url.searchParams.set('thread', this.activeThreadId);
          } else {
            url.searchParams.delete('thread');
          }
          window.history.replaceState({}, '', url.toString());
        },

        escapeAsHtml(text) {
          if (!text) return '';
          const escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
          return `<p>${escaped.replace(/\n/g, '<br>')}</p>`;
        },

        summaryHeading(turn) {
          if (!turn || typeof turn !== 'object') return 'Summary';
          const range = turn.summaryRange;
          if (range && range.from && range.to) {
            return `SUMMARY · turns ${range.from}–${range.to}`;
          }
          return 'SUMMARY';
        },

        formatTimestamp(iso) {
          if (!iso) return '';
          const d = new Date(iso);
          if (Number.isNaN(d.getTime())) return iso;
          return d.toLocaleString(undefined, {
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });
        },
      };
    }
  </script>
</BaseLayout>
