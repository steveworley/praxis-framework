---
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hasApiKey } from '@/lib/chat/anthropic.js';
import { listThreads, type ThreadSummary } from '@/lib/chat/conversation.js';
import { personaNameFrom } from '@/lib/chat/persona-name.js';
import { assembleEscalations } from '@/lib/escalations-loader.js';
import { parsePersona } from '@/lib/persona-parser.js';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home.js';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, threadsRes, escalationsRes] = await Promise.allSettled([
  parsePersona(roleHome),
  listThreads(roleHome),
  assembleEscalations(roleHome),
]);

const persona = personaRes.status === 'fulfilled' ? personaRes.value : null;
const threads: ThreadSummary[] = threadsRes.status === 'fulfilled' ? threadsRes.value : [];
const openCount =
  escalationsRes.status === 'fulfilled' ? escalationsRes.value.countsByStatus.open : 0;

const personaName = personaNameFrom(persona);
const initialThreadId =
  (Astro.url.searchParams.get('thread') ?? '').trim() || threads[0]?.thread_id || '';
const apiKeyConfigured = hasApiKey();
const updatedAt = nowIso();

const bootstrap = {
  threads,
  initialThreadId,
  apiKeyConfigured,
  personaName,
};
---

<BaseLayout title={persona ? `Chat · ${personaName.full}` : 'Chat · Praxis'}>
  <main class="container">
    <RouteHeader
      current="chat"
      personaName={persona ? personaName.full : ''}
      escalationOpenCount={openCount}
      updatedAt={updatedAt}
    />

    {!apiKeyConfigured ? (
      <div class="chat-shell-missing">
        <div class="empty">
          <h2>Chat is disabled</h2>
          <p>
            The chat surface requires <code>ANTHROPIC_API_KEY</code> to be set in the
            dashboard's environment. Set it and restart the dashboard to enable
            conversations with {personaName.full}.
          </p>
          <p>
            Optionally set <code>PRAXIS_CHAT_MODEL</code> to override the default
            (<code>claude-sonnet-4-6</code>).
          </p>
        </div>
      </div>
    ) : (
      <div class="chat-shell" x-data="praxisChat()" x-init="init()">
        <aside class="chat-sidebar">
          <button type="button" class="btn new-chat" @click="newChat()">
            + New conversation
          </button>
          <div class="thread-list">
            <template x-if="threads.length === 0">
              <div class="empty-sub">No conversations yet.</div>
            </template>
            <template x-for="thread in threads" :key="thread.thread_id">
              <div
                class="thread-row"
                :class="{ active: thread.thread_id === activeThreadId }"
                @click="selectThread(thread.thread_id)"
              >
                <div class="thread-row-main">
                  <div class="thread-title" x-text="thread.title"></div>
                  <div class="thread-meta">
                    <span x-text="relativeTime(thread.updated)"></span>
                    <span class="dot">·</span>
                    <span x-text="`${thread.message_count} msg`"></span>
                  </div>
                </div>
                <button
                  type="button"
                  class="icon-btn"
                  title="Delete conversation"
                  @click.stop="deleteThread(thread.thread_id)"
                >×</button>
              </div>
            </template>
          </div>
        </aside>

        <section class="chat-main">
          <div class="chat-pane">
            <div class="chat-pane-head">
              <div class="chat-pane-title" x-text="activeThreadId ? (activeTitle || 'New conversation') : 'New conversation'"></div>
              <div class="chat-pane-meta">
                <span x-text="activeThreadId && activeUpdated ? `updated ${relativeTime(activeUpdated)}` : ''"></span>
                <button
                  type="button"
                  class="reflect-btn"
                  :disabled="!activeThreadId || sending || reflecting || turns.length === 0"
                  @click="reflect()"
                  :title="`Ask ${personaShort} to reflect on this conversation`"
                >
                  <span x-show="!reflecting">Reflect</span>
                  <span x-show="reflecting">Reflecting…</span>
                </button>
              </div>
            </div>

            <div class="chat-error" x-show="error" x-text="error"></div>

            <div class="chat-transcript" x-ref="transcript">
              <template x-if="!activeThreadId">
                <div class="chat-empty-hint">
                  <p class="chat-empty-lede">
                    A correspondence with <strong x-text="personaFull"></strong>.
                  </p>
                  <p class="chat-empty-sub">
                    Each exchange is saved as markdown under <code>memory/conversations/</code>,
                    <span x-text="`like every other entry in ${personaShort}'s notebook.`"></span>
                  </p>
                </div>
              </template>
              <template x-if="activeThreadId && loadingTurns">
                <div class="empty-sub">Loading…</div>
              </template>
              <template x-for="(turn, idx) in turns" :key="`${activeThreadId}-${idx}`">
                <article class="chat-turn" :class="`role-${turn.role}`">
                  <header class="chat-turn-head">
                    <span class="chat-turn-role" x-text="turn.role === 'user' ? 'You' : personaShort"></span>
                    <span class="chat-turn-time" x-text="formatTimestamp(turn.timestamp)"></span>
                  </header>
                  <template x-if="Array.isArray(turn.toolCalls) && turn.toolCalls.length > 0">
                    <ul class="chat-tool-calls">
                      <template x-for="(tc, j) in turn.toolCalls" :key="j">
                        <li class="chat-tool-call" :class="{ 'is-error': !tc.result || !tc.result.ok }">
                          <span class="chat-tool-arrow">→</span>
                          <span class="chat-tool-text" x-text="renderToolCall(tc)"></span>
                          <template x-if="toolCallSha(tc)">
                            <span class="chat-tool-sha" :title="'commit ' + toolCallSha(tc)" x-text="toolCallShortSha(tc)"></span>
                          </template>
                        </li>
                      </template>
                    </ul>
                  </template>
                  <div class="chat-turn-body" x-html="turn.content_html"></div>
                </article>
              </template>
              <template x-if="pendingAssistant">
                <article class="chat-turn role-assistant pending">
                  <header class="chat-turn-head">
                    <span class="chat-turn-role" x-text="personaShort"></span>
                    <span class="chat-turn-time">thinking…</span>
                  </header>
                  <div class="chat-turn-body"><span class="dot-pulse">·  ·  ·</span></div>
                </article>
              </template>
              <template x-if="reflecting">
                <article class="chat-turn role-assistant pending">
                  <header class="chat-turn-head">
                    <span class="chat-turn-role" x-text="personaShort"></span>
                    <span class="chat-turn-time">reflecting…</span>
                  </header>
                  <div class="chat-turn-body"><span class="dot-pulse">·  ·  ·</span></div>
                </article>
              </template>
            </div>

            <div class="chat-composer">
              <template x-if="attachments.length > 0">
                <div class="chat-attachments">
                  <template x-for="(att, idx) in attachments" :key="att.path">
                    <span class="chat-attachment">
                      <span x-text="att.filename"></span>
                      <button type="button" class="icon-btn small" @click="attachments.splice(idx, 1)">×</button>
                    </span>
                  </template>
                </div>
              </template>
              <div class="chat-composer-row">
                <textarea
                  x-model="composer"
                  x-ref="composer"
                  :placeholder="`Message ${personaShort}…`"
                  @keydown.cmd.enter="send()"
                  @keydown.ctrl.enter="send()"
                  rows="1"
                ></textarea>
                <div class="chat-composer-actions">
                  <label class="composer-attach">
                    <input type="file" hidden @change="onPickFile($event)" />
                    Attach
                  </label>
                  <button
                    type="button"
                    class="btn btn-primary composer-send"
                    :disabled="!canSend"
                    @click="send()"
                  >
                    <span x-show="!sending">Send</span>
                    <span x-show="sending">Sending…</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    )}
  </main>

  <style>
    /* /chat — an editorial correspondence aesthetic. Each turn is a
       paragraph-flush "letter": a speaker label heading, a muted timestamp,
       prose body — no bubbles, no cards, generous vertical rhythm. */
    .chat-shell {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 2rem;
      align-items: start;
      margin-top: 1.2rem;
      min-height: calc(100vh - 220px);
    }
    .chat-shell-missing {
      margin-top: 2rem;
    }

    /* ---- sidebar -------------------------------------------------------- */
    .chat-sidebar {
      border-right: 1px solid var(--rule);
      padding-right: 1.25rem;
      position: sticky;
      top: 1.5rem;
    }
    .new-chat {
      width: 100%;
      margin-bottom: 1.25rem;
      font-size: 13px;
      padding: 0.5rem 0.9rem;
    }
    .thread-list {
      display: flex;
      flex-direction: column;
    }
    .thread-row {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 0.4rem;
      padding: 0.6rem 0.7rem 0.6rem 0.85rem;
      cursor: pointer;
      border-left: 2px solid transparent;
      border-radius: 0;
    }
    .thread-row:hover .thread-title {
      color: var(--link);
    }
    .thread-row.active {
      border-left-color: var(--ink);
    }
    .thread-row.active .thread-title {
      font-weight: 600;
      color: var(--ink);
    }
    .thread-row-main {
      min-width: 0;
    }
    .thread-title {
      font-size: 13.5px;
      font-weight: 500;
      color: var(--ink-soft);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.35;
    }
    .thread-meta {
      font-size: 11px;
      color: var(--ink-faint);
      font-family: ui-monospace, monospace;
      margin-top: 0.2rem;
    }
    .thread-meta .dot {
      margin: 0 0.3rem;
    }

    /* The shared sidebar/composer × button. Scoped override of the
       global `.icon-btn` (which is a bordered 32×32 square in global.css)
       — here it's a quiet inline glyph that becomes danger-coloured on hover. */
    .chat-sidebar .icon-btn,
    .chat-attachment .icon-btn {
      background: none;
      border: none;
      width: auto;
      height: auto;
      cursor: pointer;
      color: var(--ink-faint);
      font-size: 16px;
      line-height: 1;
      padding: 0.1rem 0.3rem;
      border-radius: 2px;
    }
    .chat-sidebar .icon-btn:hover,
    .chat-attachment .icon-btn:hover {
      color: var(--danger);
      background: var(--surface-mute);
    }
    .chat-attachment .icon-btn.small {
      font-size: 14px;
    }

    /* ---- pane ----------------------------------------------------------- */
    .chat-main {
      min-width: 0;
    }
    .chat-pane {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 220px);
      min-height: 480px;
    }
    .chat-pane-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 0 0 0.6rem;
      border-bottom: 1px solid var(--rule);
      gap: 0.6rem;
    }
    .chat-pane-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
      letter-spacing: -0.005em;
    }
    .chat-pane-meta {
      font-size: 11px;
      color: var(--ink-muted);
      font-family: ui-monospace, monospace;
    }
    .chat-error {
      background: #fbe2dc;
      color: var(--danger);
      padding: 0.7rem 1.1rem;
      font-size: 13px;
      border-bottom: 1px solid var(--rule);
    }

    /* ---- transcript: block flow, not flex, so children sit at the top
            and stack via margin. No "flex-end empty space" failure mode. -- */
    .chat-transcript {
      flex: 1;
      overflow-y: auto;
      padding: 1.4rem 0.5rem 1.6rem;
    }
    .chat-empty-hint {
      padding: 1.5rem 0;
      max-width: 540px;
    }
    .chat-empty-lede {
      font-size: 16px;
      color: var(--ink);
      margin-bottom: 0.6rem;
      line-height: 1.5;
    }
    .chat-empty-sub {
      font-size: 13.5px;
      color: var(--ink-muted);
      line-height: 1.6;
    }

    /* Both speakers share the same shape — distinguished by label only. */
    .chat-turn {
      display: block;
      max-width: 680px;
      margin: 0;
      padding: 0;
    }
    .chat-turn + .chat-turn {
      margin-top: 2.2rem;
    }
    .chat-turn-head {
      display: flex;
      gap: 0.7rem;
      align-items: baseline;
      margin-bottom: 0.5rem;
    }
    .chat-turn-role {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .role-assistant .chat-turn-role {
      color: var(--info);
    }
    .chat-turn-time {
      font-size: 11px;
      color: var(--ink-faint);
      font-family: ui-monospace, monospace;
    }
    .chat-turn-body {
      font-size: 14.5px;
      color: var(--ink);
      line-height: 1.65;
    }
    .chat-turn-body p {
      margin-bottom: 0.7rem;
    }
    .chat-turn-body p:last-child {
      margin-bottom: 0;
    }
    .chat-turn-body ul,
    .chat-turn-body ol {
      margin: 0.4rem 0 0.8rem 1.5rem;
    }
    .chat-turn-body li {
      margin-bottom: 0.2rem;
    }
    .chat-turn-body li > ul,
    .chat-turn-body li > ol {
      margin: 0.2rem 0 0.3rem 1.2rem;
    }
    .chat-turn-body h1,
    .chat-turn-body h2,
    .chat-turn-body h3,
    .chat-turn-body h4,
    .chat-turn-body h5,
    .chat-turn-body h6 {
      font-size: 13.5px;
      font-weight: 600;
      margin: 1rem 0 0.4rem;
      color: var(--ink);
    }
    .chat-turn-body hr {
      border: none;
      border-top: 1px solid var(--rule);
      margin: 1.1rem 0;
    }
    .chat-turn-body blockquote {
      margin: 0.6rem 0 0.8rem;
      padding: 0.1rem 0 0.1rem 0.9rem;
      border-left: 2px solid var(--rule-strong);
      color: var(--ink-soft);
    }
    .chat-turn-body blockquote p:last-child {
      margin-bottom: 0;
    }
    .chat-turn-body blockquote blockquote {
      margin-top: 0.4rem;
      color: var(--ink-muted);
    }
    .chat-turn-body table {
      border-collapse: collapse;
      margin: 0.7rem 0 0.9rem;
      font-size: 13.5px;
      width: 100%;
    }
    .chat-turn-body thead {
      border-bottom: 1px solid var(--rule-strong);
    }
    .chat-turn-body th,
    .chat-turn-body td {
      text-align: left;
      padding: 0.35rem 0.7rem 0.35rem 0;
      vertical-align: top;
    }
    .chat-turn-body th {
      font-weight: 600;
      color: var(--ink);
    }
    .chat-turn-body tbody tr {
      border-top: 1px solid var(--rule);
    }
    .chat-turn-body tbody tr:first-child {
      border-top: none;
    }
    .chat-turn-body pre {
      margin: 0.7rem 0 0.9rem;
      padding: 0.7rem 0.9rem;
      background: var(--surface-mute);
      border: 1px solid var(--rule);
      border-radius: 3px;
      overflow-x: auto;
      font-size: 12.5px;
      line-height: 1.55;
    }
    .chat-turn-body pre code {
      background: none;
      padding: 0;
      font-size: inherit;
      color: var(--ink);
    }
    .chat-turn-body code {
      font-family: ui-monospace, 'SF Mono', Menlo, monospace;
      font-size: 0.9em;
      background: var(--surface-mute);
      padding: 1px 5px;
      border-radius: 3px;
      color: var(--ink-soft);
    }
    .chat-turn-body del,
    .chat-turn-body s {
      color: var(--ink-muted);
    }
    .chat-turn.pending .chat-turn-body {
      color: var(--ink-muted);
    }
    .dot-pulse {
      letter-spacing: 0.4em;
    }

    /* ---- composer: single row, textarea grows, actions sit right -------- */
    .chat-composer {
      border-top: 1px solid var(--rule);
      padding: 0.85rem 0 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .chat-composer-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.7rem;
      align-items: end;
    }
    .chat-composer textarea {
      resize: none;
      min-height: 42px;
      max-height: 220px;
      width: 100%;
      padding: 0.6rem 0.8rem;
      font-family: inherit;
      font-size: 14px;
      line-height: 1.5;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--surface);
      color: var(--ink);
    }
    .chat-composer textarea:focus {
      outline: none;
      border-color: var(--rule-strong);
    }
    .chat-composer-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .composer-attach {
      font-size: 12.5px;
      color: var(--ink-muted);
      cursor: pointer;
      padding: 0.4rem 0.5rem;
      border-radius: 3px;
    }
    .composer-attach:hover {
      color: var(--link);
    }
    .composer-send {
      padding: 0.5rem 1.1rem;
      font-size: 13px;
    }
    .chat-attachments {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .chat-attachment {
      display: inline-flex;
      gap: 0.3rem;
      align-items: center;
      background: var(--surface-mute);
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: 0.25rem 0.6rem;
      font-size: 12px;
      color: var(--ink-soft);
      font-family: ui-monospace, monospace;
    }
    .empty-sub {
      color: var(--ink-muted);
      font-size: 13px;
      padding: 0.6rem 0;
    }

    /* ---- reflect button + tool calls ----------------------------------- */
    .chat-pane-meta {
      display: flex;
      gap: 0.8rem;
      align-items: baseline;
    }
    .reflect-btn {
      background: none;
      border: 1px solid var(--rule);
      border-radius: 3px;
      padding: 0.2rem 0.55rem;
      font-size: 11px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--ink-soft);
      cursor: pointer;
      font-family: inherit;
    }
    .reflect-btn:hover:not(:disabled) {
      color: var(--ink);
      border-color: var(--rule-strong);
      background: var(--surface-mute);
    }
    .reflect-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .chat-tool-calls {
      list-style: none;
      margin: 0 0 0.7rem 0;
      padding: 0.4rem 0.7rem;
      border-left: 2px solid var(--rule);
      background: var(--surface-mute);
      border-radius: 0 3px 3px 0;
    }
    .chat-tool-call {
      display: flex;
      gap: 0.45rem;
      align-items: baseline;
      font-size: 12.5px;
      line-height: 1.5;
      color: var(--ink-muted);
      font-family: ui-monospace, monospace;
    }
    .chat-tool-call + .chat-tool-call {
      margin-top: 0.2rem;
    }
    .chat-tool-call.is-error {
      color: var(--warn, var(--danger));
    }
    .chat-tool-arrow {
      flex-shrink: 0;
      color: var(--ink-faint);
    }
    .chat-tool-call.is-error .chat-tool-arrow {
      color: var(--warn, var(--danger));
    }
    .chat-tool-text {
      word-break: break-word;
    }
    .chat-tool-sha {
      flex-shrink: 0;
      margin-left: 0.45rem;
      padding: 1px 6px;
      border-radius: 3px;
      background: var(--rule);
      color: var(--ink-faint);
      font-size: 11.5px;
      font-family: ui-monospace, monospace;
      letter-spacing: 0.02em;
    }

    @media (max-width: 900px) {
      .chat-shell {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      .chat-sidebar {
        border-right: none;
        padding-right: 0;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 1rem;
        position: static;
      }
      .chat-pane {
        height: auto;
        min-height: 520px;
      }
      .chat-turn {
        max-width: 100%;
      }
      .chat-composer-row {
        grid-template-columns: 1fr;
      }
      .chat-composer-actions {
        justify-content: flex-end;
      }
    }
  </style>

  <script
    is:inline
    define:vars={{ bootstrap }}
  >
    window.__praxisChatBootstrap = bootstrap;
  </script>
  {/* Markdown is rendered server-side: the API routes return each turn with a
      pre-rendered `content_html` field, and the Alpine transcript binds via
      `x-html="turn.content_html"`. No markdown renderer ships to the client. */}
  <script is:inline src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script is:inline>
    function praxisChat() {
      const boot = window.__praxisChatBootstrap || { threads: [], initialThreadId: '', personaName: null };
      const persona = boot.personaName || { full: 'the role', short: 'the role', identifier: '' };
      return {
        threads: boot.threads || [],
        activeThreadId: boot.initialThreadId || '',
        activeTitle: '',
        activeUpdated: '',
        personaFull: persona.full,
        personaShort: persona.short,
        personaTitle: persona.title || '',
        turns: [],
        composer: '',
        attachments: [],
        sending: false,
        pendingAssistant: false,
        reflecting: false,
        loadingTurns: false,
        error: '',

        init() {
          const initialThread = this.threads.find((t) => t.thread_id === this.activeThreadId);
          if (initialThread) {
            this.activeTitle = initialThread.title;
            this.activeUpdated = initialThread.updated;
            this.loadActiveThread();
          }
        },

        get canSend() {
          return !this.sending && this.composer.trim().length > 0;
        },

        async loadActiveThread() {
          if (!this.activeThreadId) {
            this.turns = [];
            return;
          }
          this.loadingTurns = true;
          this.error = '';
          try {
            const res = await fetch(`/api/chat/threads/${encodeURIComponent(this.activeThreadId)}`);
            if (!res.ok) throw new Error(`Thread fetch failed (${res.status})`);
            const body = await res.json();
            this.activeTitle = body.thread.title;
            this.activeUpdated = body.thread.updated;
            this.turns = body.turns || [];
            this.$nextTick(() => this.scrollTranscriptToBottom());
          } catch (e) {
            this.error = `Could not load conversation: ${e instanceof Error ? e.message : String(e)}`;
            this.turns = [];
          } finally {
            this.loadingTurns = false;
          }
        },

        async refreshThreadList() {
          try {
            const res = await fetch('/api/chat/threads');
            if (!res.ok) return;
            const body = await res.json();
            this.threads = body.threads || [];
          } catch (_) {
            /* keep stale list */
          }
        },

        async selectThread(id) {
          if (id === this.activeThreadId) return;
          this.activeThreadId = id;
          this.composer = '';
          this.attachments = [];
          this.error = '';
          this.updateUrl();
          await this.loadActiveThread();
        },

        async newChat() {
          this.activeThreadId = '';
          this.activeTitle = '';
          this.activeUpdated = '';
          this.turns = [];
          this.composer = '';
          this.attachments = [];
          this.error = '';
          this.updateUrl();
          this.$nextTick(() => {
            if (this.$refs.composer) this.$refs.composer.focus();
          });
        },

        async deleteThread(id) {
          if (!confirm('Delete this conversation?')) return;
          try {
            const res = await fetch(`/api/chat/threads/${encodeURIComponent(id)}`, {
              method: 'DELETE',
            });
            if (!res.ok) throw new Error(`Delete failed (${res.status})`);
            this.threads = this.threads.filter((t) => t.thread_id !== id);
            if (id === this.activeThreadId) {
              await this.newChat();
            }
          } catch (e) {
            this.error = `Delete failed: ${e instanceof Error ? e.message : String(e)}`;
          }
        },

        async send() {
          const content = this.composer.trim();
          if (!content || this.sending) return;
          this.sending = true;
          this.error = '';

          // If no active thread, create one with this content as the first message.
          if (!this.activeThreadId) {
            try {
              const res = await fetch('/api/chat/threads', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ first_message: content }),
              });
              if (!res.ok) {
                const errBody = await res.json().catch(() => ({}));
                throw new Error(errBody.error || `Could not create thread (${res.status})`);
              }
              const body = await res.json();
              this.activeThreadId = body.thread_id;
              this.activeTitle = body.title;
              this.composer = '';
              this.updateUrl();
              // Show the user turn immediately while the assistant call is in flight.
              // The body's `content_html` is generated locally with a plain-text
              // escape so we never paint markdown syntax; the canonical
              // server-rendered HTML replaces it after the assistant reply lands.
              const now = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
              this.turns = [{ role: 'user', timestamp: now, content, content_html: this.escapeAsHtml(content) }];
              this.pendingAssistant = true;
              this.$nextTick(() => this.scrollTranscriptToBottom());
              await this.runMessage(content);
            } catch (e) {
              this.error = e instanceof Error ? e.message : String(e);
              this.sending = false;
              this.pendingAssistant = false;
            }
            return;
          }

          // Existing thread — optimistically push user turn, fire request.
          const optimisticNow = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
          this.turns.push({ role: 'user', timestamp: optimisticNow, content, content_html: this.escapeAsHtml(content) });
          this.composer = '';
          this.pendingAssistant = true;
          this.$nextTick(() => this.scrollTranscriptToBottom());
          await this.runMessage(content);
        },

        async runMessage(content) {
          try {
            const body = { thread_id: this.activeThreadId, content };
            if (this.attachments.length > 0) {
              body.attachments = this.attachments.map((a) => a.path);
            }
            const res = await fetch('/api/chat/message', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!res.ok) {
              const errBody = await res.json().catch(() => ({}));
              throw new Error(errBody.error || `Send failed (${res.status})`);
            }
            const replyBody = await res.json();
            const assistantTurn = {
              role: 'assistant',
              timestamp: replyBody.timestamp || new Date().toISOString(),
              content: replyBody.content,
              content_html: replyBody.content_html || this.escapeAsHtml(replyBody.content || ''),
            };
            if (Array.isArray(replyBody.toolCalls) && replyBody.toolCalls.length > 0) {
              assistantTurn.toolCalls = replyBody.toolCalls;
            }
            this.turns.push(assistantTurn);
            this.attachments = [];
            await this.refreshThreadList();
            const refreshed = this.threads.find((t) => t.thread_id === this.activeThreadId);
            if (refreshed) {
              this.activeTitle = refreshed.title;
              this.activeUpdated = refreshed.updated;
            }
            this.$nextTick(() => this.scrollTranscriptToBottom());
          } catch (e) {
            this.error = e instanceof Error ? e.message : String(e);
          } finally {
            this.sending = false;
            this.pendingAssistant = false;
          }
        },

        async reflect() {
          if (!this.activeThreadId || this.reflecting || this.sending) return;
          if (this.turns.length === 0) return;
          this.reflecting = true;
          this.error = '';
          this.$nextTick(() => this.scrollTranscriptToBottom());
          try {
            const res = await fetch('/api/chat/reflect', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ thread_id: this.activeThreadId }),
            });
            if (!res.ok) {
              const errBody = await res.json().catch(() => ({}));
              throw new Error(errBody.error || `Reflect failed (${res.status})`);
            }
            const replyBody = await res.json();
            const turn = {
              role: 'assistant',
              timestamp: replyBody.timestamp || new Date().toISOString(),
              content: replyBody.content,
              content_html: replyBody.content_html || this.escapeAsHtml(replyBody.content || ''),
            };
            if (Array.isArray(replyBody.toolCalls) && replyBody.toolCalls.length > 0) {
              turn.toolCalls = replyBody.toolCalls;
            }
            this.turns.push(turn);
            await this.refreshThreadList();
            const refreshed = this.threads.find((t) => t.thread_id === this.activeThreadId);
            if (refreshed) {
              this.activeTitle = refreshed.title;
              this.activeUpdated = refreshed.updated;
            }
            this.$nextTick(() => this.scrollTranscriptToBottom());
          } catch (e) {
            this.error = e instanceof Error ? e.message : String(e);
          } finally {
            this.reflecting = false;
          }
        },

        async onPickFile(event) {
          const file = event.target.files && event.target.files[0];
          if (!file) return;
          if (!this.activeThreadId) {
            // Need a thread first — create a placeholder so the upload can land.
            try {
              const res = await fetch('/api/chat/threads', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ first_message: `Uploaded ${file.name}` }),
              });
              if (!res.ok) throw new Error('Could not create thread');
              const body = await res.json();
              this.activeThreadId = body.thread_id;
              this.activeTitle = body.title;
              this.updateUrl();
              await this.loadActiveThread();
              await this.refreshThreadList();
            } catch (e) {
              this.error = e instanceof Error ? e.message : String(e);
              event.target.value = '';
              return;
            }
          }

          try {
            const form = new FormData();
            form.set('thread_id', this.activeThreadId);
            form.set('file', file);
            const res = await fetch('/api/chat/upload', { method: 'POST', body: form });
            if (!res.ok) {
              const errBody = await res.json().catch(() => ({}));
              throw new Error(errBody.error || `Upload failed (${res.status})`);
            }
            const body = await res.json();
            this.attachments.push({ path: body.path, filename: body.filename, size: body.size });
          } catch (e) {
            this.error = e instanceof Error ? e.message : String(e);
          } finally {
            event.target.value = '';
          }
        },

        updateUrl() {
          const url = new URL(window.location.href);
          if (this.activeThreadId) {
            url.searchParams.set('thread', this.activeThreadId);
          } else {
            url.searchParams.delete('thread');
          }
          window.history.replaceState({}, '', url.toString());
        },

        scrollTranscriptToBottom() {
          const el = this.$refs.transcript;
          if (el) el.scrollTop = el.scrollHeight;
        },

        // ---- formatting helpers -------------------------------------------

        renderToolCall(tc) {
          // Each tool call renders as a one-liner. Success uses the
          // executor's `summary`; failures lead with the tool name + error.
          // The trailing ` · <short-sha>` segment the tool appends on a
          // successful audit commit is rendered separately in its own span,
          // so strip it here to avoid duplication.
          if (!tc || typeof tc !== 'object') return '';
          const result = tc.result || {};
          if (result.ok) {
            const summary = result.summary || '';
            const stripped = summary.replace(/\s+·\s+[0-9a-f]{7,}\s*$/, '');
            if (stripped) return stripped;
            const path = result.data && result.data.path;
            if (path) return `${tc.name}: ${path}`;
            return tc.name;
          }
          const err = result.error || 'failed';
          return `${tc.name} refused — ${err}`;
        },
        toolCallSha(tc) {
          if (!tc || typeof tc !== 'object') return '';
          const data = tc.result && tc.result.data;
          if (!data) return '';
          return data.commit_sha || '';
        },
        toolCallShortSha(tc) {
          if (!tc || typeof tc !== 'object') return '';
          const data = tc.result && tc.result.data;
          if (!data) return '';
          if (data.commit_short_sha) return data.commit_short_sha;
          if (data.commit_sha) return data.commit_sha.slice(0, 7);
          return '';
        },

        escapeAsHtml(text) {
          // Plain-text → safe HTML for optimistic user turns. The server-rendered
          // `content_html` (produced by the shared markdown-it pipeline) is the
          // canonical path for everything else; this helper only runs for the
          // brief window between "user pressed send" and "assistant reply lands".
          if (!text) return '';
          const escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
          return `<p>${escaped.replace(/\n/g, '<br>')}</p>`;
        },

        relativeTime(iso) {
          if (!iso) return '';
          const then = new Date(iso).getTime();
          if (Number.isNaN(then)) return iso;
          const diff = Date.now() - then;
          const min = Math.round(diff / 60000);
          if (min < 1) return 'just now';
          if (min < 60) return `${min}m ago`;
          const hr = Math.round(min / 60);
          if (hr < 24) return `${hr}h ago`;
          const days = Math.round(hr / 24);
          if (days < 7) return `${days}d ago`;
          return iso.slice(0, 10);
        },

        formatTimestamp(iso) {
          if (!iso) return '';
          const d = new Date(iso);
          if (Number.isNaN(d.getTime())) return iso;
          return d.toLocaleString(undefined, {
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });
        },
      };
    }
  </script>
</BaseLayout>
