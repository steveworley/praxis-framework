---
import Breadcrumb from '@/components/Breadcrumb.astro';
import EmptyState from '@/components/EmptyState.astro';
import FilePath from '@/components/FilePath.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { personaNameFrom } from '@/lib/chat/persona-name';
import { renderMarkdown } from '@/lib/markdown';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import { loadVerb, type VerbFrontmatter } from '@/lib/verbs-loader';

/**
 * /verbs/[slug] — readable detail page for a single live verb. Loads via
 * `loadVerb` directly (no extra HTTP hop) and renders the markdown body
 * server-side with the canonical `.prose` typography. The frontmatter ribbon
 * shows only fields that are present, non-empty, and not the `<unset>`
 * placeholder the seed writes — fresh verbs render clean.
 *
 * Proposed verbs live on /triage with their own affordances; this surface is
 * for live verbs only.
 */

export const prerender = false;

const slugParam = String(Astro.params['slug'] ?? '');

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

let detail: Awaited<ReturnType<typeof loadVerb>> = null;
let invalidSlug = false;
try {
  detail = await loadVerb(roleHome, slugParam);
} catch {
  invalidSlug = true;
}

const personaRes = await parsePersona(roleHome).catch(() => null);
const persona: Persona | null = personaRes ?? null;
const personaName = personaNameFrom(persona);
const updatedAt = nowIso();

const bodyHtml = detail ? renderMarkdown(detail.body) : '';

/**
 * A row in the metadata ribbon. The list is built once from frontmatter so
 * the template can iterate without per-field conditional clutter.
 */
interface Row {
  key: string;
  label: string;
  value: string;
}

function visibleString(value: string | undefined): string | null {
  if (value === undefined) return null;
  const trimmed = value.trim();
  if (trimmed.length === 0 || trimmed === '<unset>') return null;
  return trimmed;
}

function visibleList(value: string[] | undefined): string[] {
  if (!value || value.length === 0) return [];
  return value.filter((v) => {
    const t = v.trim();
    return t.length > 0 && t !== '<unset>';
  });
}

function buildRibbon(fm: VerbFrontmatter): Row[] {
  const rows: Row[] = [];
  const pushScalar = (key: string, label: string, raw: string | undefined): void => {
    const v = visibleString(raw);
    if (v !== null) rows.push({ key, label, value: v });
  };
  const pushList = (key: string, label: string, raw: string[] | undefined): void => {
    const items = visibleList(raw);
    if (items.length > 0) rows.push({ key, label, value: items.join(', ') });
  };

  pushScalar('verb', 'verb-tag', fm.verb);
  pushScalar('when_to_run', 'when to run', fm.when_to_run);
  pushList('inputs', 'inputs', fm.inputs);
  pushList('outputs', 'outputs', fm.outputs);
  pushScalar('description', 'description', fm.description);
  pushScalar('proposed_by', 'proposed by', fm.proposed_by);
  pushScalar('created', 'created', fm.created);
  pushScalar('accepted_at', 'accepted', fm.accepted_at);
  pushScalar('status', 'status', fm.status);
  return rows;
}

const ribbon: Row[] = detail ? buildRibbon(detail.frontmatter) : [];

const pageTitle = detail ? `${detail.label} · Verb · Praxis` : 'Verb · Praxis';
---

<BaseLayout title={pageTitle}>
  <main class="container">
    <RouteHeader
      current="role"
      personaName={persona ? personaName.full : ''}
      updatedAt={updatedAt}
    />

    <Breadcrumb
      crumbs={[
        { label: 'role', href: '/role' },
        { label: 'verbs', href: '/role#verbs' },
        { label: slugParam },
      ]}
    />

    {invalidSlug && (
      <EmptyState>Invalid verb slug: <code>{slugParam}</code>. Verb names use kebab-case (lowercase, digits, hyphens).</EmptyState>
    )}
    {!invalidSlug && !detail && (
      <EmptyState>
        No verb at <code>verbs/{slugParam}.md</code>. Live verbs are listed on <a href="/role#verbs">/role</a>.
      </EmptyState>
    )}

    {detail && (
      <article class="verb-detail">
        <header class="verb-head">
          <h1>{detail.label}</h1>
          <div class="verb-meta">
            <FilePath path={detail.file} />
            <span class="dot">·</span>
            <span class="tag">{detail.tag}</span>
          </div>
        </header>

        {ribbon.length > 0 && (
          <dl class="verb-ribbon">
            {ribbon.map((row) => (
              <>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </>
            ))}
          </dl>
        )}

        <div class="prose" set:html={bodyHtml}></div>
      </article>
    )}
  </main>
</BaseLayout>

<style>
  .verb-detail {
    margin-top: 1.4rem;
  }
  .verb-head {
    margin-bottom: 1.2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .verb-head h1 {
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.4rem;
    font-size: 22px;
    line-height: 1.3;
    text-transform: capitalize;
  }
  .verb-meta {
    font-family: ui-monospace, monospace;
    font-size: 11.5px;
    color: var(--ink-muted);
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .verb-meta .dot {
    color: var(--ink-faint);
  }
  .verb-meta .tag {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    font-size: 10.5px;
  }
  .verb-ribbon {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0.35rem 1rem;
    margin: 0 0 1.6rem;
    padding: 0.9rem 1rem;
    background: var(--surface-mute);
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-size: 12.5px;
  }
  .verb-ribbon dt {
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 10.5px;
    align-self: baseline;
    padding-top: 0.15rem;
  }
  .verb-ribbon dd {
    color: var(--ink);
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    word-break: break-word;
  }
  .prose {
    max-width: 720px;
  }
  @media (max-width: 720px) {
    .verb-ribbon {
      grid-template-columns: 1fr;
      gap: 0.1rem 0;
    }
    .verb-ribbon dd {
      margin-bottom: 0.4rem;
    }
  }
</style>
