---
import Banner from '@/components/Banner.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { personaNameFrom } from '@/lib/chat/persona-name';
import { renderMarkdown } from '@/lib/markdown';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import {
  loadEscalation,
  TriageNotFoundError,
  type EscalationDetail,
} from '@/lib/triage';

/**
 * /triage/draft/[id] — operator's proposal-review surface for co-authoring
 * constitutional changes.
 *
 * The model is the drafter: it reads the role's files, picks which one(s) to
 * change, and proposes a multi-file diff set. The operator's job here is to
 * review each proposed file's diff (optionally editing inline or dropping it
 * from the apply set), then click Apply to land everything as one
 * operator-attributed commit with a `Co-Authored-By: Praxis Role` trailer.
 *
 * State machine: idle → drafting → drafted → applying → applied. From
 * `drafted` the operator can also Re-draft (sending an optional hint back to
 * the model) or Discard back to `idle`.
 *
 * The page bypasses the chat-side autonomy gate by design — the operator is
 * the actor here, the model is just a drafting assistant. Every apply commits
 * as the operator with `Co-Authored-By: Praxis Role` so the audit story is
 * still legible.
 */

export const prerender = false;

const idParam = String(Astro.params['id'] ?? '');

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

let escalation: EscalationDetail | null = null;
let escalationError: string | null = null;
try {
  escalation = await loadEscalation(roleHome, idParam);
} catch (error: unknown) {
  if (error instanceof TriageNotFoundError) {
    escalationError = `No escalation with id '${idParam}' exists.`;
  } else {
    escalationError = error instanceof Error ? error.message : String(error);
  }
}

const personaRes = await parsePersona(roleHome).catch(() => null);
const persona: Persona | null = personaRes ?? null;
const personaName = personaNameFrom(persona);
const updatedAt = nowIso();

const escalationBodyHtml = escalation
  ? renderMarkdown(stripDuplicateTitleH1(escalation.body, escalation.title))
  : '';

function stripDuplicateTitleH1(body: string, title: string): string {
  const titleNorm = title.trim().toLowerCase();
  if (!titleNorm) return body;
  const match = /^\s*#\s+(.+?)\s*$/m.exec(body);
  if (match && match[1].trim().toLowerCase() === titleNorm) {
    return body.replace(match[0], '').replace(/^\s*\n/, '');
  }
  return body;
}

const bootstrap = {
  escalationId: escalation?.id ?? idParam,
  personaName,
};
---

<BaseLayout title={escalation ? `Draft proposal · ${escalation.title}` : 'Draft proposal · Praxis'}>
  <main class="container">
    <RouteHeader
      current="triage"
      personaName={persona ? personaName.full : ''}
      updatedAt={updatedAt}
    />

    <Breadcrumb
      crumbs={[
        { label: 'triage', href: '/triage' },
        { label: 'draft proposal' },
        { label: escalation?.id ?? idParam },
      ]}
    />

    {escalationError && (
      <Banner variant="error">{escalationError} <a href="/triage">Back to triage</a></Banner>
    )}

    {escalation && (
      <div
        class="draft-shell"
        x-data="praxisProposalReview()"
        x-init="init()"
      >
        <p class="page-lede large">
          <span x-text="`The role asked for this; you've accepted. ${personaShort} drafts the specific file changes, you review the diffs, then apply.`"></span>
        </p>

        <template x-if="bannerError">
          <Banner variant="error"><span x-text="bannerError"></span></Banner>
        </template>
        <template x-if="bannerWarning">
          <Banner variant="warning"><span x-text="bannerWarning"></span></Banner>
        </template>
        <template x-if="bannerSuccess">
          <Banner variant="success"><span x-text="bannerSuccess"></span></Banner>
        </template>

        <section class="esc-section">
          <h2 class="section-title">Escalation</h2>
          <article class="esc-card">
            <div class="esc-meta">
              <span class="kind-label">{(escalation.kind ?? '').toUpperCase()}</span>
              <span class="esc-created">{escalation.created ?? ''}</span>
              {escalation.urgency === 'high' && <span class="urg-high">high urgency</span>}
            </div>
            <h3 class="esc-title">{escalation.title}</h3>
            <div class="prose esc-body" set:html={escalationBodyHtml}></div>
          </article>
        </section>

        <section class="proposal-section">
          <h2 class="section-title">
            Proposal
            <template x-if="state === 'drafted' && proposals.length > 0">
              <span class="section-counter" x-text="`${proposals.length} ${proposals.length === 1 ? 'file' : 'files'}`"></span>
            </template>
          </h2>

          <template x-if="state === 'idle'">
            <div class="empty-pane">
              <p>
                <span x-text="`Click below to have ${personaShort} draft a proposal. ${personaShort} will read the role's files and decide which one(s) to change.`"></span>
              </p>
              <button type="button" class="action-btn primary" @click="draft()">
                <span x-text="`Have ${personaShort} draft a proposal`"></span>
              </button>
            </div>
          </template>

          <template x-if="state === 'drafting'">
            <div class="empty-pane">
              <p>
                <span x-text="`Drafting via ${personaShort}. This usually takes 10–30 seconds…`"></span>
              </p>
              <div class="spinner-row">
                <span class="spinner"></span>
              </div>
            </div>
          </template>

          <template x-if="state === 'drafted' || state === 'applying'">
            <div class="proposal-pane">
              <template x-if="summary">
                <div class="proposal-summary" x-text="summary"></div>
              </template>

              <template x-if="proposals.length === 0">
                <div class="empty-pane">
                  All proposed files were dropped. Re-draft to start over.
                </div>
              </template>

              <template x-for="(p, idx) in proposals" :key="p.path">
                <article class="proposal-card">
                  <header class="proposal-head">
                    <div class="proposal-id">
                      <span class="kind-badge" :class="`kind-${p.kind}`" x-text="kindLabel(p.kind)"></span>
                      <code class="file-path" x-text="p.path"></code>
                    </div>
                    <button
                      type="button"
                      class="drop-btn"
                      title="Drop this file from the proposal"
                      @click="dropProposal(idx)"
                    >&times;</button>
                  </header>

                  <p class="rationale" x-text="p.rationale"></p>

                  <div class="proposal-tabs">
                    <button
                      type="button"
                      class="tab-btn"
                      :class="{ active: (viewMode[p.path] || 'diff') === 'diff' }"
                      @click="setViewMode(p.path, 'diff')"
                    >Diff</button>
                    <button
                      type="button"
                      class="tab-btn"
                      :class="{ active: viewMode[p.path] === 'edit' }"
                      @click="setViewMode(p.path, 'edit')"
                    >Edit inline</button>
                  </div>

                  <template x-if="(viewMode[p.path] || 'diff') === 'diff'">
                    <div class="diff-view" x-html="renderDiff(p.diff_unified)"></div>
                  </template>

                  <template x-if="viewMode[p.path] === 'edit'">
                    <textarea
                      class="edit-textarea"
                      rows="20"
                      x-model="editedContent[p.path]"
                      spellcheck="false"
                    ></textarea>
                  </template>
                </article>
              </template>

              <div class="hint-block" x-show="proposals.length > 0 || state === 'drafted'">
                <label class="hint-label">
                  <span class="hint-title">
                    <span x-text="`Anything else to tell ${personaShort} for a re-draft?`"></span>
                  </span>
                  <span class="hint-help">Optional. Used only if you click Re-draft.</span>
                  <textarea
                    x-model="hint"
                    rows="3"
                    placeholder="Keep the existing greeting line; tighten the tone calibration."
                  ></textarea>
                </label>
              </div>

              <div class="apply-row">
                <button
                  type="button"
                  class="action-btn primary"
                  :disabled="proposals.length === 0 || applying"
                  @click="apply()"
                >
                  <span x-show="!applying" x-text="`Apply all (${proposals.length} ${proposals.length === 1 ? 'file' : 'files'})`"></span>
                  <span x-show="applying">Applying…</span>
                </button>
                <button
                  type="button"
                  class="action-btn"
                  :disabled="applying"
                  @click="draft()"
                >Re-draft</button>
                <button
                  type="button"
                  class="action-btn ghost"
                  :disabled="applying"
                  @click="discard()"
                >Discard</button>
              </div>
            </div>
          </template>

          <template x-if="state === 'applied'">
            <div class="applied-block">
              <p>
                Applied as commit <code x-text="applied.commit_short_sha || '(no sha)'"></code>
                · <span x-text="`${applied.files_changed?.length || 0} file${(applied.files_changed?.length || 0) === 1 ? '' : 's'} changed`"></span>.
                Redirecting to triage…
              </p>
            </div>
          </template>
        </section>
      </div>
    )}
  </main>

  <style>
    /* /triage/draft/[id] — single-pane proposal-review surface. Escalation
       context at top, a list of proposal cards (one per file the model
       wants to change), an optional re-draft hint, and an apply/re-draft/
       discard action row. Diff colours match /chat / /triage tinted
       backgrounds (no flashy chrome — the goal is to read the change). */
    .draft-shell {
      margin-top: 1rem;
    }
    .section-title {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink);
      margin-bottom: 0.9rem;
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
    }
    .section-counter {
      font-family: ui-monospace, monospace;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0;
      text-transform: none;
      color: var(--ink-muted);
    }
    .esc-section,
    .proposal-section {
      margin-bottom: 2rem;
    }

    .esc-card {
      padding: 1rem 1.1rem;
      background: var(--surface-mute);
      border-radius: 3px;
    }
    .esc-meta {
      display: flex;
      gap: 0.6rem;
      align-items: baseline;
      font-family: ui-monospace, monospace;
      font-size: 11.5px;
      color: var(--ink-muted);
      margin-bottom: 0.5rem;
    }
    .kind-label {
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 1px 5px;
      border-radius: 2px;
      background: #fbeed4;
      color: var(--warn);
    }
    .esc-created {
      color: var(--ink-faint);
    }
    .urg-high {
      color: var(--danger);
      font-weight: 600;
    }
    .esc-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    .esc-body {
      font-size: 13px;
    }

    .empty-pane {
      padding: 1.5rem 0;
      font-size: 13.5px;
      color: var(--ink-muted);
    }
    .empty-pane p {
      margin-bottom: 0.8rem;
    }

    .spinner-row {
      margin-top: 0.5rem;
    }
    .spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid var(--rule);
      border-top-color: var(--ink-muted);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .proposal-summary {
      padding: 0.7rem 0.9rem;
      background: var(--surface-mute);
      border-left: 3px solid var(--info);
      border-radius: 2px;
      font-size: 13px;
      color: var(--ink-soft);
      margin-bottom: 1.2rem;
      font-style: italic;
    }

    .proposal-card {
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--surface);
      padding: 1rem 1.1rem 1.1rem;
      margin-bottom: 1rem;
    }
    .proposal-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 0.4rem;
    }
    .proposal-id {
      display: flex;
      gap: 0.55rem;
      align-items: baseline;
      flex-wrap: wrap;
    }
    .kind-badge {
      font-family: ui-monospace, monospace;
      font-size: 10.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 1px 5px;
      border-radius: 2px;
      background: var(--surface-mute);
      color: var(--ink-muted);
    }
    .kind-badge.kind-persona {
      background: #e6e2f4;
      color: var(--info);
    }
    .kind-badge.kind-claude-md {
      background: #e0ebf3;
      color: #1a5680;
    }
    .kind-badge.kind-verb {
      background: #e6f4ea;
      color: #0e5a25;
    }
    .kind-badge.kind-lib {
      background: #fbeed4;
      color: var(--warn);
    }
    .file-path {
      font-family: ui-monospace, monospace;
      font-size: 12px;
      background: none;
      padding: 0;
      color: var(--ink);
    }
    .drop-btn {
      background: none;
      border: none;
      color: var(--ink-faint);
      font-size: 18px;
      line-height: 1;
      padding: 0 0.3rem;
      cursor: pointer;
    }
    .drop-btn:hover {
      color: var(--danger);
    }
    .rationale {
      font-size: 12.5px;
      color: var(--ink-muted);
      font-style: italic;
      margin-bottom: 0.7rem;
    }

    .proposal-tabs {
      display: flex;
      gap: 0.4rem;
      border-bottom: 1px solid var(--rule);
      margin-bottom: 0.6rem;
    }
    .tab-btn {
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      padding: 0.35rem 0.55rem;
      font-family: inherit;
      font-size: 12.5px;
      color: var(--ink-muted);
      cursor: pointer;
    }
    .tab-btn:hover {
      color: var(--ink);
    }
    .tab-btn.active {
      color: var(--ink);
      border-bottom-color: var(--ink);
    }

    .diff-view {
      font-family: ui-monospace, 'SF Mono', Menlo, monospace;
      font-size: 12px;
      line-height: 1.55;
      background: var(--surface-mute);
      border-radius: 3px;
      padding: 0.55rem 0;
      max-height: 480px;
      overflow: auto;
    }
    :global(.diff-view .diff-line) {
      display: block;
      padding: 0 0.9rem;
      white-space: pre;
    }
    :global(.diff-view .diff-line.added) {
      background: #e6f4ea;
      color: #0e5a25;
    }
    :global(.diff-view .diff-line.removed) {
      background: #fbe2dc;
      color: #8a1f12;
    }
    :global(.diff-view .diff-line.hunk) {
      color: var(--info);
      background: var(--surface-deep);
      font-weight: 500;
    }
    :global(.diff-view .diff-line.meta) {
      color: var(--ink-faint);
    }

    .edit-textarea {
      width: 100%;
      font-family: ui-monospace, 'SF Mono', Menlo, monospace;
      font-size: 12.5px;
      line-height: 1.55;
      padding: 0.7rem 0.9rem;
      border: 1px solid var(--rule);
      border-radius: 3px;
      background: var(--surface);
      color: var(--ink);
      resize: vertical;
      min-height: 320px;
    }
    .edit-textarea:focus {
      outline: none;
      border-color: var(--rule-strong);
    }

    .hint-block {
      margin-top: 1.2rem;
      margin-bottom: 0.8rem;
    }
    .hint-label {
      display: block;
    }
    .hint-title {
      display: block;
      font-size: 12px;
      color: var(--ink-muted);
      margin-bottom: 0.2rem;
      font-weight: 500;
    }
    .hint-help {
      display: block;
      font-size: 11.5px;
      color: var(--ink-faint);
      margin-bottom: 0.45rem;
    }
    .hint-block textarea {
      width: 100%;
      font-family: inherit;
      font-size: 13.5px;
      line-height: 1.5;
      padding: 0.55rem 0.7rem;
      border: 1px solid var(--rule);
      border-radius: 3px;
      background: var(--surface);
      color: var(--ink);
      resize: vertical;
    }
    .hint-block textarea:focus {
      outline: none;
      border-color: var(--rule-strong);
    }

    .apply-row {
      display: flex;
      gap: 0.55rem;
      flex-wrap: wrap;
      align-items: baseline;
      margin-top: 0.8rem;
    }
    .action-btn {
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 3px;
      padding: 0.4rem 0.95rem;
      font-family: inherit;
      font-size: 12.5px;
      color: var(--ink-soft);
      cursor: pointer;
    }
    .action-btn:hover:not(:disabled) {
      border-color: var(--rule-strong);
      color: var(--ink);
    }
    .action-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .action-btn.primary {
      border-color: var(--ink-soft);
      color: var(--ink);
      font-weight: 500;
    }
    .action-btn.primary:hover:not(:disabled) {
      background: var(--ink);
      color: var(--surface);
    }
    .action-btn.ghost {
      border-color: transparent;
      color: var(--ink-muted);
    }
    .action-btn.ghost:hover {
      color: var(--ink);
    }

    .applied-block {
      padding: 1rem 0;
      font-size: 13.5px;
      color: var(--ink-soft);
    }
    .applied-block code {
      font-size: 12px;
    }
  </style>

  <script
    is:inline
    define:vars={{ bootstrap }}
  >
    window.__praxisProposalBootstrap = bootstrap;
  </script>
  <script is:inline src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script is:inline>
    function praxisProposalReview() {
      const boot = window.__praxisProposalBootstrap || { escalationId: '', personaName: null };
      const persona = boot.personaName || { full: 'the role', short: 'the role' };
      return {
        escalationId: boot.escalationId,
        personaShort: persona.short,
        personaFull: persona.full,

        // Lifecycle: idle | drafting | drafted | applying | applied.
        state: 'idle',
        // Hint text for the re-draft path.
        hint: '',
        // proposals: array of { path, current_content, proposed_content,
        //   diff_unified, rationale, kind }.
        proposals: [],
        // viewMode[path]: 'diff' | 'edit' — defaults to 'diff' when absent.
        viewMode: {},
        // editedContent[path]: operator's inline edit (stays empty until
        // the operator switches to the 'edit' tab and types).
        editedContent: {},
        // Summary text from the model (one paragraph).
        summary: '',
        // Set after a successful apply.
        applied: null,
        applying: false,

        bannerError: '',
        bannerWarning: '',
        bannerSuccess: '',

        init() {
          this.state = 'idle';
        },

        kindLabel(kind) {
          if (kind === 'persona') return 'persona';
          if (kind === 'claude-md') return 'CLAUDE.md';
          if (kind === 'verb') return 'verb';
          if (kind === 'lib') return 'lib';
          return kind || '';
        },

        setViewMode(path, mode) {
          this.viewMode[path] = mode;
          // When switching to 'edit' the first time, seed the textarea with
          // the current proposed_content so the operator can edit from it.
          if (mode === 'edit' && this.editedContent[path] === undefined) {
            const p = this.proposals.find((q) => q.path === path);
            if (p) this.editedContent[path] = p.proposed_content;
          }
        },

        async draft() {
          this.bannerError = '';
          this.bannerWarning = '';
          this.bannerSuccess = '';
          this.state = 'drafting';
          try {
            const body = { escalation_id: this.escalationId };
            if (this.hint && this.hint.trim().length > 0) {
              body.hint = this.hint.trim();
            }
            const res = await fetch('/api/triage/propose', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.error || `Propose failed (${res.status})`);
            }
            const body2 = await res.json();
            this.proposals = body2.proposals || [];
            this.summary = body2.summary || '';
            this.viewMode = {};
            this.editedContent = {};
            if (body2.truncated) {
              this.bannerWarning = `${this.personaShort} hit the iteration cap — the proposal may be incomplete.`;
            }
            this.state = 'drafted';
          } catch (e) {
            this.bannerError = e instanceof Error ? e.message : String(e);
            // Keep any previous proposals on screen — partial regression
            // hurts less than wiping. Fall back to idle if there were none.
            this.state = this.proposals.length > 0 ? 'drafted' : 'idle';
          }
        },

        dropProposal(idx) {
          this.proposals.splice(idx, 1);
        },

        discard() {
          this.proposals = [];
          this.summary = '';
          this.viewMode = {};
          this.editedContent = {};
          this.hint = '';
          this.state = 'idle';
        },

        async apply() {
          if (this.proposals.length === 0 || this.applying) return;
          this.bannerError = '';
          this.bannerWarning = '';
          this.applying = true;
          this.state = 'applying';
          try {
            const payload = {
              escalation_id: this.escalationId,
              proposals: this.proposals.map((p) => ({
                path: p.path,
                proposed_content:
                  this.viewMode[p.path] === 'edit' && this.editedContent[p.path] !== undefined
                    ? this.editedContent[p.path]
                    : p.proposed_content,
              })),
            };
            const res = await fetch('/api/triage/apply', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.error || `Apply failed (${res.status})`);
            }
            const body = await res.json();
            this.applied = body;
            if (body.commit_warning) this.bannerWarning = body.commit_warning;
            this.bannerSuccess = `Applied as commit ${body.commit_short_sha || '(no sha)'} · ${(body.files_changed || []).length} file${(body.files_changed || []).length === 1 ? '' : 's'} changed.`;
            this.state = 'applied';
            // Give the operator a beat to see the success banner before
            // bouncing back to the triage queue.
            setTimeout(() => {
              window.location.href = '/triage';
            }, 1500);
          } catch (e) {
            this.bannerError = e instanceof Error ? e.message : String(e);
            this.state = 'drafted';
          } finally {
            this.applying = false;
          }
        },

        /**
         * Render a unified-diff string as colored per-line spans. Inlined
         * here so the Alpine template can call it via x-html without a
         * round-trip; mirrors the logic of lib/ui/diff.ts (kept in sync by
         * convention — this is a small enough surface that we accept the
         * duplication rather than wire an ESM helper into a CDN-loaded
         * Alpine context).
         */
        renderDiff(diffText) {
          if (!diffText) return '';
          const escape = (s) =>
            s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
          const lines = diffText.split('\n');
          const parts = [];
          for (const raw of lines) {
            let cls = 'diff-line';
            if (raw.startsWith('@@')) cls += ' hunk';
            else if (raw.startsWith('+++') || raw.startsWith('---') || raw.startsWith('Index:') || raw.startsWith('===')) cls += ' meta';
            else if (raw.startsWith('+')) cls += ' added';
            else if (raw.startsWith('-')) cls += ' removed';
            parts.push(`<span class="${cls}">${escape(raw || ' ')}</span>`);
          }
          return parts.join('');
        },
      };
    }
  </script>
</BaseLayout>
