    .crit {
      display: grid;
      grid-template-columns: 2.3em 1fr 7em 6.5em;
      gap: 1.1rem;
      padding: 1rem 0;
      border-top: 1px solid var(--rule);
      align-items: center;
    }
    .crit:last-child {
      border-bottom: 1px solid var(--rule);
