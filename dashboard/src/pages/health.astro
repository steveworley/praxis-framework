---
import EmptyState from '@/components/EmptyState.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import SectionPill from '@/components/SectionPill.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assembleActivity, type ActivityEntry } from '@/lib/activity-loader';
import { type AutonomousEdit, recentAutonomousEdits } from '@/lib/autonomy-loader';
import { bucketByWeek, type HealthReport, loadHealth } from '@/lib/health-loader';
import { assembleMcpWarnings, type McpWarnings } from '@/lib/health/mcp-warnings';
import { assembleMemory, type MemoryEntry } from '@/lib/memory-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getLogGlob, getRoleHome, nowIso } from '@/lib/role-home';
import {
  getLatestSelfAssessmentsByCriterion,
  type CriterionStatusValue,
} from '@/lib/self-assessment-parser';

/**
 * /health — character-sheet redesign (Phase 2 step 3).
 *
 * Body shape, top to bottom:
 *   1. MCP "Configuration drift" panel (PR #53) — conditional, urgent first.
 *   2. Hero: teal `VITAL SIGNS` pill + 44px Fraunces title + italic sub +
 *      window-meta strip in mono dim.
 *   3. 2×2 vital-signs grid: memory (peach) · escalations (pink) · activity
 *      (purple) · autonomous edits (lavender). Each panel: SectionPill +
 *      headline Fraunces number + pixel sparkline + 4-row mono breakdown.
 *   4. Full-width "Success criteria" panel (lavender): one row per declared
 *      criterion with status pip, prose, optional trend strip, status badge.
 *
 * Data is reused from the existing loaders (`loadHealth` plus side calls to
 * `assembleActivity`, `assembleMemory`, `recentAutonomousEdits`) — no new
 * loader shapes. Weekly histograms for activity + autonomy are derived inline
 * with `bucketByWeek` since the existing health loader returns flat 30-day
 * totals for those two surfaces.
 */

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

// Same author email the health-loader's autonomy block matches against — kept
// in sync so the page's weekly histogram aligns with `health.autonomy.role_commits`.
const ROLE_AUTHOR_EMAIL = 'role@praxis.local';
const WEEK_COUNT = 4;
const ACTIVITY_FETCH_LIMIT = 5000;

const [
  personaRes,
  healthRes,
  mcpWarningsRes,
  memoryRes,
  activityRes,
  editsRes,
] = await Promise.allSettled([
  parsePersona(roleHome),
  loadHealth(roleHome),
  assembleMcpWarnings(roleHome),
  assembleMemory(roleHome),
  assembleActivity(roleHome, getLogGlob(), ACTIVITY_FETCH_LIMIT),
  recentAutonomousEdits(roleHome, {
    role_email: ROLE_AUTHOR_EMAIL,
    limit: 500,
    since_days: 30,
  }),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const health: HealthReport | null = healthRes.status === 'fulfilled' ? healthRes.value : null;
const healthError = healthRes.status === 'rejected' ? String(healthRes.reason) : null;
const mcpWarnings: McpWarnings =
  mcpWarningsRes.status === 'fulfilled'
    ? mcpWarningsRes.value
    : { missingDeclared: [], unreachable: [] };
const hasMcpWarnings =
  mcpWarnings.missingDeclared.length > 0 || mcpWarnings.unreachable.length > 0;
const memoryEntries: MemoryEntry[] =
  memoryRes.status === 'fulfilled' ? memoryRes.value : [];
const activityEntries: ActivityEntry[] =
  activityRes.status === 'fulfilled' ? activityRes.value : [];
const recentEdits: AutonomousEdit[] = editsRes.status === 'fulfilled' ? editsRes.value : [];

const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
const updatedAt = nowIso();
const now = Date.now();

/**
 * 5-level block-glyph sparkline. Each bucket is one character so a 4-bucket
 * sparkline reads as "▂▄▆█" — the visual hooks into the per-panel colour via
 * CSS and the Departure Mono pixel font. Empty buckets render as a thin `▁`
 * to keep the strip aligned (zero-width spaces would break the grid).
 */
const SPARK_GLYPHS = ['▁', '▂', '▄', '▆', '█'] as const;
function renderSparkline(counts: number[]): string {
  const max = counts.reduce((m, n) => (n > m ? n : m), 0);
  if (max === 0) return SPARK_GLYPHS[0]!.repeat(counts.length);
  return counts
    .map((n) => {
      if (n === 0) return SPARK_GLYPHS[0]!;
      const ratio = n / max;
      // ratio ∈ (0, 1] → idx in [1, 4]
      const idx = Math.min(SPARK_GLYPHS.length - 1, Math.max(1, Math.ceil(ratio * 4)));
      return SPARK_GLYPHS[idx]!;
    })
    .join('');
}

/** Compact whole-number formatter — keeps panel headlines compact when counts
 *  cross the 4-digit mark (e.g. tool-call totals over 1k). */
function compact(n: number): string {
  if (n < 1000) return String(n);
  return `${(n / 1000).toFixed(n < 10_000 ? 1 : 0)}k`;
}

function formatDays(d: number | null): string {
  if (d === null) return '—';
  if (d < 1) {
    const hours = Math.round(d * 24);
    return hours <= 0 ? '<1h' : `${hours}h`;
  }
  return `${d.toFixed(1)}d`;
}

// --- Memory panel --------------------------------------------------------------
// Headline = total live memory entries. Sparkline = writes/week over 4 weeks.
// Breakdown rows: this week · last week · 4-week median · longest gap (days).
const memoryWeeklyCounts = health?.memory.weekly.map((b) => b.count) ?? [];
const memorySpark = renderSparkline(memoryWeeklyCounts);
const memoryThisWeek = memoryWeeklyCounts[memoryWeeklyCounts.length - 1] ?? 0;
const memoryLastWeek = memoryWeeklyCounts[memoryWeeklyCounts.length - 2] ?? 0;
function median(values: number[]): number {
  if (values.length === 0) return 0;
  const sorted = [...values].sort((a, b) => a - b);
  const mid = Math.floor(sorted.length / 2);
  if (sorted.length % 2 === 1) return sorted[mid] ?? 0;
  return ((sorted[mid - 1] ?? 0) + (sorted[mid] ?? 0)) / 2;
}
const memoryWeeklyMedian = median(memoryWeeklyCounts);
/** Longest gap in days between consecutive memory writes within the last 28
 *  days. Reads as "the role went N days without writing" — a stale-cadence
 *  signal complementing the headline count. */
function longestGapDays(entries: MemoryEntry[], windowDays: number, ref: number): number {
  const windowStart = ref - windowDays * 24 * 60 * 60 * 1000;
  const stamps = entries
    .map((e) => Date.parse(e.updated ?? e.created ?? ''))
    .filter((t) => Number.isFinite(t) && t >= windowStart && t <= ref)
    .sort((a, b) => a - b);
  if (stamps.length === 0) return windowDays;
  let maxGap = (stamps[0]! - windowStart) / (24 * 60 * 60 * 1000);
  for (let i = 1; i < stamps.length; i++) {
    const gap = (stamps[i]! - stamps[i - 1]!) / (24 * 60 * 60 * 1000);
    if (gap > maxGap) maxGap = gap;
  }
  const trailing = (ref - stamps[stamps.length - 1]!) / (24 * 60 * 60 * 1000);
  if (trailing > maxGap) maxGap = trailing;
  return maxGap;
}
const memoryLongestGap = longestGapDays(memoryEntries, 28, now);

// --- Escalations panel ---------------------------------------------------------
// Headline = total filed lifetime. Sparkline = filed/week over 4 weeks.
// Breakdown: open · median time-to-triage (28d) · filed last week · resolved
// last week. Each breakdown value derives from the existing health report.
const escFiledCounts = health?.escalations.weekly_filed.map((b) => b.count) ?? [];
const escResolvedCounts = health?.escalations.weekly_resolved.map((b) => b.count) ?? [];
const escSpark = renderSparkline(escFiledCounts);
const escFiledLastWeek = escFiledCounts[escFiledCounts.length - 1] ?? 0;
const escResolvedLastWeek = escResolvedCounts[escResolvedCounts.length - 1] ?? 0;

// --- Activity panel ------------------------------------------------------------
// Headline = total tool calls in last 30d (== `health.activity.total`).
// Sparkline = weekly bucket of activity timestamps over the 4 weeks ending
// now — we go back to the raw entries since the loader only surfaces the
// flat 30-day total + per-tool breakdown.
// Breakdown rows: decisions · tool_call · verb_started · verb_completed (30d).
function actionCount(name: string): number {
  if (!health) return 0;
  return health.activity.by_tool.find((t) => t.tool === name)?.count ?? 0;
}
const activityWeekly = bucketByWeek(
  activityEntries.map((e) => e.timestamp ?? null),
  now,
  WEEK_COUNT,
);
const activitySpark = renderSparkline(activityWeekly.map((b) => b.count));
const activityTotal = health?.activity.total ?? 0;

// --- Autonomous edits panel ----------------------------------------------------
// Headline = total role-authored commits in last 30d (== `health.autonomy.role_commits`).
// Sparkline = commits/week over 4 weeks (derived from `recentAutonomousEdits`).
// Breakdown: surfaces touched · edits to lib/ · memory/ · verbs/.
const autonomyWeekly = bucketByWeek(
  recentEdits.map((c) => c.date || null),
  now,
  WEEK_COUNT,
);
const autonomySpark = renderSparkline(autonomyWeekly.map((b) => b.count));
const autonomyTotal = health?.autonomy.role_commits ?? recentEdits.length;
function editsTouching(prefix: string): number {
  return recentEdits.filter((edit) => edit.files.some((f) => f.startsWith(prefix))).length;
}
const surfacesTouched = (() => {
  const seen = new Set<string>();
  for (const edit of recentEdits) {
    for (const f of edit.files) {
      // Top-level surface = first path segment (lib, memory, verbs, output, …).
      const segment = f.split('/')[0];
      if (segment) seen.add(segment);
    }
  }
  return seen.size;
})();

// --- Criteria panel ------------------------------------------------------------
// One row per declared success criterion. Latest status drives the pip + badge
// colour; trend strip shows the last 4 statuses oldest→newest, or hides when
// no history exists. We compute the strip independent of `health.criteria` so
// `trend_length` can be controlled here without a loader-shape change.
const declaredCriteria = persona?.success_criteria ?? [];
const byCriterion = getLatestSelfAssessmentsByCriterion(memoryEntries);
const TREND_LENGTH = 4;
const criteriaRows = declaredCriteria.map((criterion) => {
  const history = byCriterion.get(criterion) ?? [];
  const latest = history[0] ?? null;
  const trend = history.slice(0, TREND_LENGTH).map((h) => h.status).reverse();
  return { criterion, latest, trend };
});
const assessedCount = criteriaRows.filter((c) => c.latest !== null).length;

interface PipShape {
  glyph: string;
  cls: 'green' | 'amber' | 'red' | 'unsure';
}
function pipFor(status: CriterionStatusValue | null): PipShape {
  if (status === 'green') return { glyph: '●', cls: 'green' };
  if (status === 'amber') return { glyph: '◐', cls: 'amber' };
  if (status === 'red') return { glyph: '○', cls: 'red' };
  return { glyph: '◌', cls: 'unsure' };
}
function statusLabel(status: CriterionStatusValue | null): string {
  if (status === null) return 'UNSURE';
  if (status === 'green') return 'GOOD';
  if (status === 'amber') return 'WARN';
  if (status === 'red') return 'DANGER';
  return 'UNSURE';
}
function trendGlyph(status: CriterionStatusValue): string {
  if (status === 'green') return '█';
  if (status === 'amber') return '▆';
  if (status === 'red') return '▄';
  return '▁';
}
function trendCls(status: CriterionStatusValue): string {
  if (status === 'green') return 'green';
  if (status === 'amber') return 'amber';
  if (status === 'red') return 'red';
  return 'unsure';
}

// First-name handle for hero copy. Falls back to "the role" when no persona.
function firstNameOf(p: Persona | null): string {
  const full = (p?.identity['full_name'] ?? p?.identity['name'] ?? '').trim();
  if (full.length === 0) return 'the role';
  const idx = full.indexOf(' ');
  return idx < 0 ? full : full.slice(0, idx);
}
const firstName = firstNameOf(persona);
const heroTitle = persona ? "How I'm doing" : 'How the role is doing';
const heroSub = `Read-only observability. Aggregations across ${firstName}'s writes, escalations, activity logs, and autonomous edits — the firehose, summarised.`;
const criteriaTitle = persona ? 'How I measure myself' : 'How the role measures themselves';
const windowMeta = `4-WEEK WINDOWS · 30-DAY ACTIVITY & AUTONOMY · GENERATED ${updatedAt}`;
---

<BaseLayout title={fullName ? `Health · ${fullName}` : 'Health · Praxis'}>
  <main class="container">
    <RouteHeader current="health" personaName={fullName} updatedAt={updatedAt} />

    <div class="page-body">
      {hasMcpWarnings && (
        <section class="sec mcp-drift">
          <SectionPill
            colour="pink"
            label="MCP CONFIG"
            title="Configuration drift"
            counter={`${mcpWarnings.missingDeclared.length + mcpWarnings.unreachable.length} ${
              mcpWarnings.missingDeclared.length + mcpWarnings.unreachable.length === 1
                ? 'issue'
                : 'issues'
            } · from lib/tools.yaml + PRAXIS_MCPS`}
          />
          <ul class="mcp-drift-list">
            {mcpWarnings.missingDeclared.map((name) => (
              <li class="mcp-drift-row">
                <span class="mcp-drift-kind missing">MISSING</span>
                <code class="mcp-drift-name">mcp:{name}</code>
                <span class="mcp-drift-text">
                  declared in <code>lib/tools.yaml</code> but not in <code>PRAXIS_MCPS</code> — add a service to <code>docker-compose.yml</code> or remove the declaration.
                </span>
              </li>
            ))}
            {mcpWarnings.unreachable.map((server) => (
              <li class="mcp-drift-row">
                <span class="mcp-drift-kind unreachable">
                  {server.status === 'unreachable' ? 'UNREACHABLE' : 'ERROR'}
                </span>
                <code class="mcp-drift-name">{server.name}</code>
                <span class="mcp-drift-text">
                  configured in <code>PRAXIS_MCPS</code> but the dashboard could not reach it{server.message ? ` — ${server.message}` : ''}.
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="vh-hero">
        <div class="hero-left">
          <div class="pill">VITAL SIGNS</div>
          <h1>{heroTitle}</h1>
          <div class="sub">{heroSub}</div>
        </div>
        <div class="windows">{windowMeta}</div>
      </section>

      {healthError && (
        <EmptyState>Failed to load health report: {healthError}</EmptyState>
      )}

      {health && (
        <>
          <section class="vitals">
            <article class="vital-panel">
              <header class="vp-head">
                <span class="vp-pill peach">MEMORY</span>
                <span class="vp-num">{compact(health.memory.total)}</span>
              </header>
              <div class="vp-spark peach">{memorySpark}</div>
              <dl class="vp-break">
                <div class="vp-row"><dt>this week</dt><dd>{memoryThisWeek}</dd></div>
                <div class="vp-row"><dt>last week</dt><dd>{memoryLastWeek}</dd></div>
                <div class="vp-row"><dt>4-week median</dt><dd>{memoryWeeklyMedian.toFixed(memoryWeeklyMedian % 1 === 0 ? 0 : 1)}</dd></div>
                <div class="vp-row"><dt>longest gap</dt><dd>{memoryLongestGap.toFixed(1)}d</dd></div>
              </dl>
            </article>

            <article class="vital-panel">
              <header class="vp-head">
                <span class="vp-pill pink">ESCALATIONS</span>
                <span class="vp-num">{health.escalations.total}</span>
              </header>
              <div class="vp-spark pink">{escSpark}</div>
              <dl class="vp-break">
                <div class="vp-row"><dt>open</dt><dd>{health.escalations.counts_by_status.open}</dd></div>
                <div class="vp-row"><dt>median time-to-triage (28d)</dt><dd>{formatDays(health.escalations.median_time_to_triage_days)}</dd></div>
                <div class="vp-row"><dt>filed last week</dt><dd>{escFiledLastWeek}</dd></div>
                <div class="vp-row"><dt>resolved last week</dt><dd>{escResolvedLastWeek}</dd></div>
              </dl>
            </article>

            <article class="vital-panel">
              <header class="vp-head">
                <span class="vp-pill purple">ACTIVITY</span>
                <span class="vp-num">{compact(activityTotal)}</span>
              </header>
              <div class="vp-spark purple">{activitySpark}</div>
              <dl class="vp-break">
                <div class="vp-row"><dt>decisions</dt><dd>{actionCount('decision')}</dd></div>
                <div class="vp-row"><dt>tool_call</dt><dd>{actionCount('tool_call')}</dd></div>
                <div class="vp-row"><dt>verb_started</dt><dd>{actionCount('verb_started')}</dd></div>
                <div class="vp-row"><dt>verb_completed</dt><dd>{actionCount('verb_completed')}</dd></div>
              </dl>
            </article>

            <article class="vital-panel">
              <header class="vp-head">
                <span class="vp-pill lavender">AUTONOMOUS EDITS</span>
                <span class="vp-num">{compact(autonomyTotal)}</span>
              </header>
              <div class="vp-spark lavender">{autonomySpark}</div>
              {health.autonomy.git_unavailable ? (
                <p class="vp-empty">Git history isn't available for this role.</p>
              ) : (
                <dl class="vp-break">
                  <div class="vp-row"><dt>surfaces touched</dt><dd>{surfacesTouched}</dd></div>
                  <div class="vp-row"><dt>edits to lib/</dt><dd>{editsTouching('lib/')}</dd></div>
                  <div class="vp-row"><dt>edits to memory/</dt><dd>{editsTouching('memory/')}</dd></div>
                  <div class="vp-row"><dt>edits to verbs/</dt><dd>{editsTouching('verbs/')}</dd></div>
                </dl>
              )}
            </article>
          </section>

          <section class="criteria-panel">
            <SectionPill
              colour="lavender"
              label="SUCCESS CRITERIA"
              title={criteriaTitle}
              counter={
                declaredCriteria.length === 0
                  ? 'none declared'
                  : `against ${declaredCriteria.length} declared ${declaredCriteria.length === 1 ? 'criterion' : 'criteria'} · ${assessedCount} assessed`
              }
            />
            {declaredCriteria.length === 0 ? (
              <p class="crit-empty">No success criteria declared in <code>persona.md</code>.</p>
            ) : (
              <ol class="crit-list">
                {criteriaRows.map(({ criterion, latest, trend }) => {
                  const pip = pipFor(latest?.status ?? null);
                  return (
                    <li class="crit">
                      <span class:list={['crit-pip', pip.cls]}>{pip.glyph}</span>
                      <div class="crit-text">
                        {criterion}
                        {latest?.reasoning ? <em>{latest.reasoning}</em> : null}
                      </div>
                      <div class="crit-trend" aria-hidden={trend.length === 0}>
                        {trend.length === 0
                          ? null
                          : trend.map((s) => (
                              <span class:list={['crit-pixel', trendCls(s)]}>{trendGlyph(s)}</span>
                            ))}
                      </div>
                      <span class:list={['crit-badge', pip.cls]}>
                        {statusLabel(latest?.status ?? null)}
                      </span>
                    </li>
                  );
                })}
              </ol>
            )}
          </section>
        </>
      )}
    </div>
  </main>

  <style>
    /* MCP configuration drift panel — only renders when there's at least one
       declared-but-missing or configured-but-unreachable MCP. Each row keeps
       the brief's reading order: kind chip (MISSING in --pink, UNREACHABLE in
       --oxblood) + mono server name + Source Serif 4 remediation prose. */
    .mcp-drift {
      margin-bottom: 2.5rem;
    }
    .mcp-drift-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .mcp-drift-row {
      display: flex;
      gap: 0.7rem;
      align-items: baseline;
      flex-wrap: wrap;
      font-size: 13px;
      line-height: 1.55;
      color: var(--ink);
    }
    .mcp-drift-kind {
      font-family: var(--pixel);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 1px 6px;
      flex-shrink: 0;
      color: var(--surface);
    }
    .mcp-drift-kind.missing {
      background: var(--pink);
      color: var(--ink);
    }
    .mcp-drift-kind.unreachable {
      background: var(--oxblood);
    }
    .mcp-drift-name {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--ink);
      flex-shrink: 0;
    }
    .mcp-drift-text {
      font-family: var(--prose);
      color: var(--ink-soft);
      max-width: 64ch;
    }
    .mcp-drift-text code {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--ink);
    }

    /* === Hero ============================================================ */
    .vh-hero {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule);
    }
    .vh-hero .hero-left .pill {
      font-family: var(--pixel);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--surface);
      background: var(--teal);
      padding: 0.3em 0.7em;
      display: inline-block;
      margin-bottom: 1em;
    }
    .vh-hero .hero-left h1 {
      font-family: var(--display);
      font-weight: 600;
      font-size: 44px;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin-bottom: 0.3em;
      font-variation-settings: 'opsz' 144;
    }
    .vh-hero .hero-left .sub {
      font-family: var(--display);
      font-style: italic;
      font-weight: 500;
      font-size: 18px;
      color: var(--ink-soft);
      max-width: 62ch;
      margin-bottom: 1.4em;
    }
    .vh-hero .windows {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--ink-muted);
      text-transform: uppercase;
    }

    /* === Vital signs 2×2 grid =========================================== */
    .vitals {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.2rem;
      margin-bottom: 3rem;
    }
    /* Each panel = bordered card, white surface, 2rem padding. Reads calm. */
    .vital-panel {
      background: var(--surface);
      border: 1.5px solid var(--ink);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .vp-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }
    .vp-pill {
      font-family: var(--pixel);
      font-size: 10.5px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.3em 0.6em;
      align-self: flex-start;
    }
    .vp-pill.peach {
      background: var(--peach);
      color: var(--ink);
    }
    .vp-pill.pink {
      background: var(--pink);
      color: var(--ink);
    }
    .vp-pill.purple {
      background: var(--purple);
      color: var(--surface);
    }
    .vp-pill.lavender {
      background: var(--lavender);
      color: var(--surface);
    }
    .vp-num {
      font-family: var(--display);
      font-weight: 600;
      font-size: 56px;
      line-height: 1;
      letter-spacing: -0.025em;
      color: var(--ink);
      font-variation-settings: 'opsz' 144;
      font-variant-numeric: tabular-nums;
    }
    .vp-spark {
      font-family: var(--pixel);
      font-size: 28px;
      letter-spacing: 0.08em;
      line-height: 1;
      margin-top: -0.1rem;
    }
    .vp-spark.peach { color: var(--peach); }
    .vp-spark.pink { color: var(--pink); }
    .vp-spark.purple { color: var(--purple); }
    .vp-spark.lavender { color: var(--lavender); }
    .vp-break {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      font-family: var(--mono);
      font-size: 12.5px;
      margin: 0;
    }
    .vp-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
    .vp-row dt {
      color: var(--ink-muted);
