---
import EmptyState from '@/components/EmptyState.astro';
import IdentityStrip from '@/components/IdentityStrip.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import SummaryCard from '@/components/SummaryCard.astro';
import TriageCard from '@/components/TriageCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assembleActivity, type ActivityEntry } from '@/lib/activity-loader';
import { personaNameFrom } from '@/lib/chat/persona-name';
import { countLiveVerbs } from '@/lib/verbs-loader';
import {
  assembleEscalations,
  type EscalationEntry,
  type EscalationsResult,
} from '@/lib/escalations-loader';
import { assembleMemory, type MemoryEntry } from '@/lib/memory-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { listOutputs } from '@/lib/output/loader';
import { OUTPUT_TYPE_ENUM, type OutputSummary, type OutputType } from '@/lib/output/types';
import { listProposedVerbs } from '@/lib/triage';
import {
  daysSince,
  isStale,
  recentActivityBreakdown,
  recentActivityCount,
  recentMemoryBreakdown,
  recentMemoryCount,
} from '@/lib/recent-stats';
import { detectMode, getLogGlob, getRoleHome, nowIso } from '@/lib/role-home';
import simpleGit from 'simple-git';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const logGlob = getLogGlob();

// Section-by-section error handling: one failed loader shouldn't blank the
// page. We surface per-section errors below.
const [personaRes, memoryRes, escalationsRes, activityRes, verbCountRes, recentRoleRes, proposedVerbsRes, outputsRes] = await Promise.allSettled([
  parsePersona(roleHome),
  assembleMemory(roleHome),
  assembleEscalations(roleHome),
  assembleActivity(roleHome, logGlob, 200),
  countLiveVerbs(roleHome),
  collectRoleEdits(roleHome),
  listProposedVerbs(roleHome),
  listOutputs(roleHome),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const memoryEntries: MemoryEntry[] = memoryRes.status === 'fulfilled' ? memoryRes.value : [];
const escalations: EscalationsResult | null =
  escalationsRes.status === 'fulfilled' ? escalationsRes.value : null;
const activity: ActivityEntry[] = activityRes.status === 'fulfilled' ? activityRes.value : [];
const verbCount: number = verbCountRes.status === 'fulfilled' ? verbCountRes.value : 0;
const recentRoleEdits: RoleEditsSummary =
  recentRoleRes.status === 'fulfilled' ? recentRoleRes.value : { count: 0, lastFile: null, lastDays: null };
const proposedVerbCount: number =
  proposedVerbsRes.status === 'fulfilled' ? proposedVerbsRes.value.length : 0;
const outputs: OutputSummary[] =
  outputsRes.status === 'fulfilled' ? outputsRes.value : [];
const outputCountsByType: Record<OutputType, number> = {
  document: 0,
  draft: 0,
  record: 0,
  plan: 0,
  reference: 0,
};
for (const o of outputs) outputCountsByType[o.type] += 1;
const outputTotal = outputs.length;

const updatedAt = nowIso();
const personaName = personaNameFrom(persona);

const now = Date.now();
const openEscalations: EscalationEntry[] = (escalations?.entries ?? []).filter(
  (e) => e.status === 'open',
);
const urgentCount = openEscalations.filter((e) => e.urgency === 'high').length;
const staleCount = openEscalations.filter((e) => isStale(e, now)).length;
const openCount = openEscalations.length;

const memoryBreakdown = recentMemoryBreakdown(memoryEntries, 7, now);
const memoryRecent = recentMemoryCount(memoryEntries, 7, now);
const activityBreakdown = recentActivityBreakdown(activity, 1, now);
const activityToday = recentActivityCount(activity, 1, now);

function memoryBreakdownLines(): string[] {
  const keys = Object.keys(memoryBreakdown).sort();
  if (keys.length === 0) return ['no recent entries'];
  return keys.map((k) => {
    const n = memoryBreakdown[k] ?? 0;
    return `${n} ${k}`;
  });
}
function activityBreakdownLines(): string[] {
  const keys = Object.keys(activityBreakdown).sort();
  if (keys.length === 0) return ['no activity today'];
  return keys.map((k) => {
    const n = activityBreakdown[k] ?? 0;
    return `${n} ${k}`;
  });
}
function roleEditsLines(): string[] {
  if (recentRoleEdits.count === 0) return ['no recent edits'];
  const lines: string[] = [];
  if (recentRoleEdits.lastDays !== null) {
    lines.push(`last: ${recentRoleEdits.lastDays === 0 ? 'today' : `${recentRoleEdits.lastDays} ${recentRoleEdits.lastDays === 1 ? 'day' : 'days'} ago`}`);
  }
  if (recentRoleEdits.lastFile) lines.push(recentRoleEdits.lastFile);
  return lines;
}

interface RoleEditsSummary {
  count: number;
  lastFile: string | null;
  lastDays: number | null;
}

/**
 * Count git commits touching `verbs/` over the last 7 days. Uses simple-git
 * which is already a dep. If the role home isn't a git repo, returns zero.
 */
async function collectRoleEdits(home: string): Promise<RoleEditsSummary> {
  try {
    const git = simpleGit(home);
    const isRepo = await git.checkIsRepo();
    if (!isRepo) return { count: 0, lastFile: null, lastDays: null };
    const log = await git.log({
      '--since': '7 days ago',
      '--name-only': null,
      file: 'verbs',
      maxCount: 50,
    });
    const all = log.all ?? [];
    if (all.length === 0) return { count: 0, lastFile: null, lastDays: null };
    const head = all[0];
    const lastDays = head?.date ? daysSince(head.date) : null;
    // simple-git returns each commit's diff in `diff` only when configured;
    // pulling first changed verb file out of the body would require a
    // second pass. Surface the verbs/ marker filename instead so the user
    // gets a hint without us walking diffs.
    const lastFile = 'verbs/';
    return { count: all.length, lastFile, lastDays };
  } catch {
    return { count: 0, lastFile: null, lastDays: null };
  }
}
---

<BaseLayout title={persona ? `Praxis · ${personaName.full}` : 'Praxis'}>
  <main class="container">
    <RouteHeader
      current="home"
      personaName={persona ? personaName.full : ''}
      escalationOpenCount={openCount}
      triageCount={openCount + proposedVerbCount}
      updatedAt={updatedAt}
    />

    {(openCount + proposedVerbCount > 0) && (
      <a class="triage-strip" href="/triage">
        <span class="triage-strip-icon">→</span>
        <span class="triage-strip-text">
          <strong>{openCount + proposedVerbCount}</strong> {openCount + proposedVerbCount === 1 ? 'item' : 'items'} in triage:
          {openCount > 0 && ` ${openCount} ${openCount === 1 ? 'escalation' : 'escalations'} open`}
          {openCount > 0 && proposedVerbCount > 0 && ' · '}
          {proposedVerbCount > 0 && ` ${proposedVerbCount} proposed ${proposedVerbCount === 1 ? 'verb' : 'verbs'}`}
        </span>
        <span class="triage-strip-action">review →</span>
      </a>
    )}

    <div class="group page-body">
      <div class="group-head">
        <span class="group-title">Waiting on you</span>
        <span class="group-counter">
          {openCount} open
          {urgentCount > 0 && ` · ${urgentCount} urgent`}
          {staleCount > 0 && ` · ${staleCount} stale`}
        </span>
      </div>
      {openEscalations.length === 0 ? (
        <EmptyState>Nothing waiting. Open escalations will surface here.</EmptyState>
      ) : (
        openEscalations.map((e) => (
          <TriageCard
            escalation={e}
            urgent={e.urgency === 'high'}
            stale={isStale(e, now)}
            staleDays={daysSince(e.created, now)}
          />
        ))
      )}
    </div>

    {persona && (
      <IdentityStrip
        persona={persona}
        showCounts={true}
        verbCount={verbCount}
        link={{ href: '/role', label: 'view role →' }}
      />
    )}

    {persona && (
      <div class="chat-cta">
        <div class="chat-cta-body">
          <div class="chat-cta-title">Talk to {personaName.full}</div>
          <div class="chat-cta-meta">
            A conversational lens on {personaName.short}'s interior. Conversations persist as markdown under <code>memory/conversations/</code>.
          </div>
        </div>
        <a class="chat-cta-link" href="/chat">open chat →</a>
      </div>
    )}

    <div class="group">
      <div class="group-head">
        <span class="group-title">Recently</span>
        <span class="group-counter">last 7 days</span>
      </div>
      <div class="summary">
        <SummaryCard
          heading="Notebook"
          num={memoryRecent === 0 ? '0' : `+${memoryRecent}`}
          breakdownLines={memoryBreakdownLines()}
          deepLinkHref="/notebook"
          deepLinkLabel="all entries →"
        />
        <SummaryCard
          heading="Output"
          num={String(outputTotal)}
          breakdownLines={
            outputTotal === 0
              ? ['no output yet']
              : OUTPUT_TYPE_ENUM.filter((t) => outputCountsByType[t] > 0).map(
                  (t) => `${outputCountsByType[t]} ${t}`,
                )
          }
          deepLinkHref="/output"
          deepLinkLabel="view output →"
        />
        <SummaryCard
          heading="Activity (today)"
          num={String(activityToday)}
          breakdownLines={activityBreakdownLines()}
          deepLinkHref="/activity"
          deepLinkLabel="full log →"
        />
        <SummaryCard
          heading="Role edits (by you)"
          num={String(recentRoleEdits.count)}
          breakdownLines={roleEditsLines()}
          deepLinkHref="/role"
          deepLinkLabel="view role →"
        />
      </div>
    </div>
  </main>
</BaseLayout>
