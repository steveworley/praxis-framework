---
import EmptyState from '@/components/EmptyState.astro';
import VerbRow from '@/components/VerbRow.astro';
import IdentityStrip from '@/components/IdentityStrip.astro';
import PersonaPane from '@/components/PersonaPane.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type VerbsResult, listLibFiles, loadVerbs } from '@/lib/verbs-loader';
import {
  type AutonomousEdit,
  type AutonomyConfig,
  loadAutonomy,
  recentAutonomousEdits,
} from '@/lib/autonomy-loader';
import { assembleEscalations } from '@/lib/escalations-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, verbsRes, libRes, escalationsRes, autonomyRes] = await Promise.allSettled([
  parsePersona(roleHome),
  loadVerbs(roleHome),
  listLibFiles(roleHome),
  assembleEscalations(roleHome),
  loadAutonomy(roleHome),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const personaError = personaRes.status === 'rejected' ? String(personaRes.reason) : null;
const verbs: VerbsResult = verbsRes.status === 'fulfilled' ? verbsRes.value : { live: [], proposed: [] };
const libFiles: string[] = libRes.status === 'fulfilled' ? libRes.value : [];
const openCount =
  escalationsRes.status === 'fulfilled' ? escalationsRes.value.countsByStatus.open : 0;

const autonomy: AutonomyConfig | null =
  autonomyRes.status === 'fulfilled' ? autonomyRes.value : null;

let edits: AutonomousEdit[] = [];
if (autonomy && persona) {
  const roleEmail = persona.identity['email'] ?? '';
  const roleNameForGit = persona.identity['full_name'] ?? persona.identity['name'] ?? '';
  const autonomousPaths = autonomy.surfaces.map((s) => s.path);
  const editsRes = await Promise.allSettled([
    recentAutonomousEdits(roleHome, {
      role_email: roleEmail.length > 0 ? roleEmail : undefined,
      role_name: roleNameForGit.length > 0 ? roleNameForGit : undefined,
      limit: 20,
      since_days: 30,
      autonomous_paths: autonomousPaths.length > 0 ? autonomousPaths : undefined,
    }),
  ]);
  if (editsRes[0].status === 'fulfilled') edits = editsRes[0].value;
}

const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
const updatedAt = nowIso();

function summariseSurface(s: AutonomyConfig['surfaces'][number]): string {
  const bits: string[] = [s.mode];
  if (s.max_pending !== undefined) bits.push(`${s.max_pending} max pending`);
  return `${s.path} (${bits.join(', ')})`;
}

const autonomySummary = autonomy && autonomy.surfaces.length > 0
  ? `${autonomy.surfaces.length} ${autonomy.surfaces.length === 1 ? 'surface' : 'surfaces'} opened — ${autonomy.surfaces.map(summariseSurface).join(', ')}`
  : '';

function formatDate(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso.slice(0, 10);
  return d.toISOString().slice(0, 10);
}

function firstLine(message: string): string {
  const idx = message.indexOf('\n');
  return idx >= 0 ? message.slice(0, idx) : message;
}
---

<BaseLayout title={fullName ? `Role · ${fullName}` : 'Role · Praxis'}>
  <main class="container">
    <RouteHeader
      current="role"
      personaName={fullName}
      escalationOpenCount={openCount}
      updatedAt={updatedAt}
    />

    <div style="margin-top: 2rem;">
      {persona ? (
        <IdentityStrip persona={persona} showEmail={true} />
      ) : (
        <EmptyState>
          Failed to parse persona: {personaError ?? 'no persona.md found'}
        </EmptyState>
      )}

      <div class="group">
        <div class="group-head">
          <span class="group-title">Constitution</span>
          <span class="group-counter">authored · persona.md</span>
        </div>
        <div class="persona-block">
          <PersonaPane
            variant="voice"
            heading="Voice"
            source={`${persona?.voice.length ?? 0} ${(persona?.voice.length ?? 0) === 1 ? 'rule' : 'rules'}`}
            empty='Add a "## Voice & Personality" section to persona.md with bulleted "- **trait** -- qualifier" entries (or nested sub-bullets for multi-qualifier traits).'
            items={persona?.voice ?? []}
          />
          <PersonaPane
            variant="constitution"
            heading="Hard inhibitions"
            source={`${persona?.inhibitions.length ?? 0} ${(persona?.inhibitions.length ?? 0) === 1 ? 'rule' : 'rules'}`}
            empty='Add a "## Hard inhibitions" section to persona.md.'
            items={persona?.inhibitions ?? []}
          />
        </div>
      </div>

      <div class="group">
        <div class="group-head">
          <span class="group-title">Verbs</span>
          <span class="group-counter">
            {verbs.live.length} live
            {verbs.proposed.length > 0 && ` · ${verbs.proposed.length} pending review`}
          </span>
        </div>
        {verbs.live.length === 0 && verbs.proposed.length === 0 ? (
          <EmptyState>No verbs authored yet. Add `.md` files under `verbs/`.</EmptyState>
        ) : (
          <div class="verbs-list">
            {verbs.live.map((v) => <VerbRow verb={v} />)}
            {verbs.proposed.map((v) => <VerbRow verb={v} proposed={true} />)}
          </div>
        )}
      </div>

      <div class="group">
        <div class="group-head">
          <span class="group-title">Recent edits</span>
          <span class="group-counter">
            {autonomy ? `${autonomy.surfaces.length} ${autonomy.surfaces.length === 1 ? 'surface' : 'surfaces'} · ${edits.length} ${edits.length === 1 ? 'edit' : 'edits'} (30d)` : 'no autonomy.yaml'}
          </span>
        </div>
        {!autonomy || edits.length === 0 ? (
          <EmptyState>
            No autonomous edits yet. The role's grown surfaces are listed in lib/autonomy.yaml.
          </EmptyState>
        ) : (
          <>
            {autonomySummary && (
              <div class="autonomy-summary">{autonomySummary}</div>
            )}
            <div class="edits-list">
              {edits.map((e) => (
                <div class="edit-row">
                  <span class="sha">{e.short_sha}</span>
                  <span class="date">{formatDate(e.date)}</span>
                  <div class="what">
                    {firstLine(e.message)}
                    {e.files.length > 0 && (
                      <span class="paths">{e.files.join(' · ')}</span>
                    )}
                    <span class="author">{e.author_name} &lt;{e.author_email}&gt;</span>
                  </div>
                </div>
              ))}
            </div>
          </>
        )}
      </div>

      <div class="group">
        <div class="group-head">
          <span class="group-title">Reference data</span>
          <span class="group-counter">authored · lib/</span>
        </div>
        {libFiles.length === 0 ? (
          <EmptyState>No reference data. Add YAML files to `lib/` to anchor the role's facts.</EmptyState>
        ) : (
          <div class="lib-list">
            {libFiles.map((f) => <code>{f}</code>)}
          </div>
        )}
      </div>
    </div>
  </main>
</BaseLayout>
