---
import EmptyState from '@/components/EmptyState.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import SectionPill from '@/components/SectionPill.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type VerbsResult, listLibFiles, loadVerbs } from '@/lib/verbs-loader';
import {
  type AutonomousEdit,
  type AutonomyConfig,
  loadAutonomy,
  recentAutonomousEdits,
} from '@/lib/autonomy-loader';
import {
  loadCapabilities,
  type CapabilitiesReport,
  type VerbOutcomeCounts,
} from '@/lib/capabilities-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import { assembleMemory } from '@/lib/memory-loader';
import { getLatestSelfAssessmentsByCriterion, type CriterionStatusValue } from '@/lib/self-assessment-parser';
import { daysSince, formatAgeLabel, formatIsoDate } from '@/lib/ui/time';
import { firstLine } from '@/lib/ui/text';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, verbsRes, libRes, autonomyRes, memoryRes, capabilitiesRes] = await Promise.allSettled([
  parsePersona(roleHome),
  loadVerbs(roleHome),
  listLibFiles(roleHome),
  loadAutonomy(roleHome),
  assembleMemory(roleHome),
  loadCapabilities(roleHome),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const personaError = personaRes.status === 'rejected' ? String(personaRes.reason) : null;
const verbs: VerbsResult = verbsRes.status === 'fulfilled' ? verbsRes.value : { live: [], proposed: [] };
const libFiles: string[] = libRes.status === 'fulfilled' ? libRes.value : [];
const memoryEntries = memoryRes.status === 'fulfilled' ? memoryRes.value : [];
const capabilities: CapabilitiesReport | null =
  capabilitiesRes.status === 'fulfilled' ? capabilitiesRes.value : null;
const capabilitiesError =
  capabilitiesRes.status === 'rejected' ? String(capabilitiesRes.reason) : null;

const autonomy: AutonomyConfig | null =
  autonomyRes.status === 'fulfilled' ? autonomyRes.value : null;

let edits: AutonomousEdit[] = [];
if (autonomy && persona) {
  const roleEmail = persona.identity['email'] ?? '';
  const roleNameForGit = persona.identity['full_name'] ?? persona.identity['name'] ?? '';
  const autonomousPaths = autonomy.surfaces.map((s) => s.path);
  const editsRes = await Promise.allSettled([
    recentAutonomousEdits(roleHome, {
      role_email: roleEmail.length > 0 ? roleEmail : undefined,
      role_name: roleNameForGit.length > 0 ? roleNameForGit : undefined,
      limit: 20,
      since_days: 30,
      autonomous_paths: autonomousPaths.length > 0 ? autonomousPaths : undefined,
    }),
  ]);
  if (editsRes[0].status === 'fulfilled') edits = editsRes[0].value;
}

const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
/** Working title is the italic sub-heading under the role name in the hero —
 * e.g. "Business Development". Falls back to the legacy `role` field when
 * `working_title` is absent. */
const workingTitle =
  persona?.identity['working_title'] ?? persona?.identity['title'] ?? '';
/** Purpose paragraph below the hero name. Personas emitted by the wizard use
 * the `Role` identity field for the one-sentence purpose; older personas
 * may carry an explicit `purpose` instead. */
const purpose =
  persona?.identity['purpose'] ?? persona?.identity['role'] ?? '';
const updatedAt = nowIso();

/** Compose hero "Facts" panel keys from the persona identity. Each entry is
 * present only when the underlying field is set; absent fields silently drop
 * out of the card so the rendered shape always matches the data. */
interface Fact {
  k: string;
  v: string;
}

function buildFacts(p: Persona | null, verbsCount: number): Fact[] {
  const out: Fact[] = [];
  if (!p) return out;
  const i = p.identity;
  if (i['reports_to']) out.push({ k: 'reports to', v: i['reports_to'] });
  if (i['email']) out.push({ k: 'email', v: i['email'] });
  if (i['location']) out.push({ k: 'location', v: i['location'] });
  const started = i['started'] ?? i['since'] ?? '';
  if (started) out.push({ k: 'started', v: started });
  out.push({ k: 'verbs', v: `${verbsCount} live` });
  return out;
}

const facts = buildFacts(persona, verbs.live.length);

/** Map self-assessment status to its pip glyph + colour class.
 * `unsure` and missing assessments both render as `◌` to keep the visual
 * gap between "we haven't measured this" and "the role isn't sure" honest
 * but minimal — the status word in the right column carries the nuance. */
function statusPip(status: CriterionStatusValue | null): { glyph: string; cls: string; label: string } {
  if (status === 'green') return { glyph: '●', cls: 'green', label: 'green' };
  if (status === 'amber') return { glyph: '◐', cls: 'amber', label: 'amber' };
  if (status === 'red') return { glyph: '○', cls: 'red', label: 'red' };
  if (status === 'unsure') return { glyph: '◌', cls: '', label: 'unsure' };
  return { glyph: '◌', cls: '', label: 'unsure' };
}

const declaredCriteria = persona?.success_criteria ?? [];
const byCriterion = getLatestSelfAssessmentsByCriterion(memoryEntries);
const criteriaWithStatus = declaredCriteria.map((criterion) => {
  const history = byCriterion.get(criterion) ?? [];
  return { criterion, latest: history[0] ?? null };
});
const assessedCount = criteriaWithStatus.filter((c) => c.latest !== null).length;

const voiceCount = persona?.voice.length ?? 0;
const accountabilitiesCount = persona?.accountabilities.length ?? 0;
const capabilitiesCount = persona?.capabilities.length ?? 0;
const inhibitionsCount = persona?.inhibitions.length ?? 0;
const liveVerbsCount = verbs.live.length;
const proposedVerbsCount = verbs.proposed.length;

function summariseSurface(s: AutonomyConfig['surfaces'][number]): string {
  const bits: string[] = [s.mode];
  if (s.max_pending !== undefined) bits.push(`${s.max_pending} max pending`);
  return `${s.path} (${bits.join(', ')})`;
}

const autonomySummary = autonomy && autonomy.surfaces.length > 0
  ? `${autonomy.surfaces.length} ${autonomy.surfaces.length === 1 ? 'surface' : 'surfaces'} opened — ${autonomy.surfaces.map(summariseSurface).join(', ')}`
  : '';

const editsCounter = autonomy
  ? `${autonomy.surfaces.length} ${autonomy.surfaces.length === 1 ? 'surface' : 'surfaces'} · ${edits.length} ${edits.length === 1 ? 'edit' : 'edits'} (30d)`
  : 'no autonomy.yaml';

function verbSlug(file: string): string {
  const base = file.replace(/^.*[\\/]/, '');
  return base.replace(/\.md$/i, '');
}

const now = new Date();

/** Format an ISO timestamp as a relative-age label ("2d ago") for the
 * capabilities deep section. Empty string when the timestamp is null so
 * the row drops the trailing "last …" affordance cleanly. */
function ageLabel(iso: string | null): string {
  if (!iso) return '';
  return formatAgeLabel(daysSince(iso, now));
}

/** Compact "Ns Np Nf Ns" verb-outcome badge — success, partial, failed,
 * skipped. Renders an em-dash when the verb hasn't been invoked. */
function outcomeBadge(o: VerbOutcomeCounts): string {
  const total = o.success + o.partial + o.failed + o.skipped;
  if (total === 0) return '—';
  return `${o.success}s ${o.partial}p ${o.failed}f ${o.skipped}s`;
}
---

<BaseLayout title={fullName ? `Role · ${fullName}` : 'Role · Praxis'}>
  <main class="container">
    <RouteHeader current="role" personaName={fullName} updatedAt={updatedAt} />

    <div class="page-body">
      {!persona ? (
        <div class="empty-pixel">Failed to parse persona: {personaError ?? 'no persona.md found'}</div>
      ) : (
        <>
          <section class="role-hero">
            <div class="hero-left">
              <div class="role-label">⌗ position description</div>
              <div class="name">{fullName}</div>
              {workingTitle && <div class="title">{workingTitle}</div>}
              {purpose && <div class="purpose">{purpose}</div>}
            </div>
            {facts.length > 0 && (
              <div class="hero-right">
                <div class="label">Facts</div>
                {facts.map((f) => (
                  <div class="fact">
                    <span class="k">{f.k}</span>
                    <span class="v">{f.v}</span>
                  </div>
                ))}
              </div>
            )}
          </section>

          <div class="pd-sections">
            <section class="sec">
              <SectionPill
                colour="peach"
                label="VOICE"
                title="How I sound"
                counter={`${voiceCount} ${voiceCount === 1 ? 'trait' : 'traits'}`}
              />
              {voiceCount === 0 ? (
                <div class="empty-pixel">
                  No voice traits declared. Add a "## Voice & Personality" section to <code>persona.md</code> with "- **trait** -- qualifier" bullets.
                </div>
              ) : (
                <div class="voice-chips">
                  {persona.voice.map((v) => (
                    <div class="voice-chip">
                      <div class="trait">{v.trait}</div>
                      {v.qualifiers.length > 0 && (
                        <div class="quals">
                          {v.qualifiers.map((q) => <span>{q}</span>)}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </section>

            <section class="sec">
              <SectionPill
                colour="pink"
                label="ACCOUNTABILITIES"
                title="What I'm responsible for"
                counter={`${accountabilitiesCount} ${accountabilitiesCount === 1 ? 'item' : 'items'}`}
              />
              {accountabilitiesCount === 0 ? (
                <div class="empty-pixel">
                  Nothing declared. Add an "## Accountabilities" section to <code>persona.md</code> with first-person "I'm responsible for…" bullets.
                </div>
              ) : (
                <div class="acc-stack">
                  {persona.accountabilities.map((line, idx) => (
                    <div class="acc-item">
                      <div class="num">{String(idx + 1).padStart(2, '0')}</div>
                      <div class="body">{line}</div>
                    </div>
                  ))}
                </div>
              )}
            </section>

            <section class="sec">
              <SectionPill
                colour="purple"
                label="CAPABILITIES"
                title="What I can do"
                counter={`${capabilitiesCount} ${capabilitiesCount === 1 ? 'item' : 'items'}`}
              />
              {capabilitiesCount === 0 ? (
                <div class="empty-pixel">
                  Nothing declared. Add a "## Capabilities" section to <code>persona.md</code> with first-person "I can …" bullets.
                </div>
              ) : (
                <div class="cap-grid">
                  {persona.capabilities.map((cap) => (
                    <div class="cap-card">{cap}</div>
                  ))}
                </div>
              )}
            </section>

            <section class="sec">
              <SectionPill
                colour="lavender"
                label="SUCCESS CRITERIA"
                title="How I'm measured"
                counter={`${declaredCriteria.length} ${declaredCriteria.length === 1 ? 'criterion' : 'criteria'} · ${assessedCount} assessed`}
              />
              {declaredCriteria.length === 0 ? (
                <div class="empty-pixel">
                  Nothing to measure against yet. Add a "## Success criteria" section to <code>persona.md</code> with observable, falsifiable outcomes.
                </div>
              ) : (
                <div class="sc-list">
                  {criteriaWithStatus.map(({ criterion, latest }) => {
                    const pip = statusPip(latest?.status ?? null);
                    return (
                      <div class="sc-item">
                        <div class:list={['pip', pip.cls]}>{pip.glyph}</div>
                        <div class="text">{criterion}</div>
                        <div class="status">{pip.label}</div>
                      </div>
                    );
                  })}
                </div>
              )}
            </section>

            <section class="sec">
              <SectionPill
                colour="oxblood"
                label="HARD INHIBITIONS"
                title="What I never do"
                counter={`${inhibitionsCount} ${inhibitionsCount === 1 ? 'rule' : 'rules'} · constitutional`}
              />
              {inhibitionsCount === 0 ? (
                <div class="empty-pixel">
                  No constitutional rules declared. Add a "## Hard inhibitions" section to <code>persona.md</code>.
                </div>
              ) : (
                <div class="inhib-block">
                  <ul>
                    {persona.inhibitions.map((line) => <li>{line}</li>)}
                  </ul>
                </div>
              )}
            </section>
          </div>

          <section class="sec deep-capabilities" id="capabilities" style="margin-top: 5rem;">
            <SectionPill
              colour="purple"
              label="CAPABILITY DETAIL"
              title="Tools at hand"
              counter={capabilities
                ? `${capabilities.chatTools.length} chat tools · ${capabilities.mcps.configured ? `${capabilities.mcps.servers.length} MCP ${capabilities.mcps.servers.length === 1 ? 'server' : 'servers'}` : 'no MCP'} · ${capabilities.verbs.length} verbs`
                : 'unavailable'}
            />
            {capabilitiesError ? (
              <EmptyState>Failed to load capabilities: {capabilitiesError}</EmptyState>
            ) : !capabilities ? (
              <EmptyState>No capabilities to show.</EmptyState>
            ) : (
              <>
                <div class="cap-detail-block">
                  <div class="cap-detail-head">
                    <span class="cap-detail-label">Chat tools</span>
                    <span class="cap-detail-count">{capabilities.chatTools.length} native</span>
                  </div>
                  <div class="cap-list">
                    {capabilities.chatTools.map((t) => (
                      <div class="cap-row">
                        <div class="cap-row-head">
                          <code class="cap-name">{t.name}</code>
                          <span class="cap-mode">{t.autonomyMode}</span>
                          <span class="cap-usage">
                            {t.callCount30d === 0 ? (
                              <em class="never">never invoked (30d)</em>
                            ) : (
                              <>
                                <span class="ct">{t.callCount30d}</span>{' '}
                                {t.callCount30d === 1 ? 'call' : 'calls'} (30d)
                              </>
                            )}
                            {t.lastInvoked && (
                              <span class="last"> · last {ageLabel(t.lastInvoked)}</span>
                            )}
                          </span>
                        </div>
                        <div class="cap-desc">{t.description}</div>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="cap-detail-block">
                  <div class="cap-detail-head">
                    <span class="cap-detail-label">MCP servers</span>
                    <span class="cap-detail-count">
                      {capabilities.mcps.configured
                        ? `${capabilities.mcps.servers.length} ${capabilities.mcps.servers.length === 1 ? 'server' : 'servers'}`
                        : 'not configured'}
                    </span>
                  </div>
                  {!capabilities.mcps.configured ? (
                    <EmptyState>{capabilities.mcps.message}</EmptyState>
                  ) : (
                    <div class="cap-list">
                      {capabilities.mcps.servers.map((s) => (
                        <div class="cap-row mcp-server">
                          <div class="cap-row-head">
                            <code class="cap-name">{s.name}</code>
                            <span class={`mcp-status mcp-status-${s.status}`}>{s.status}</span>
                            <span class={`mcp-allow ${s.allowed ? 'mcp-allow-yes' : 'mcp-allow-no'}`}>
                              {s.allowed ? 'allow' : 'deny'}
                            </span>
                            <span class="cap-usage">
                              <span class="mcp-url">{s.url}</span>
                            </span>
                          </div>
                          {s.status !== 'connected' && s.errorMessage && (
                            <div class="cap-desc mcp-error">{s.errorMessage}</div>
                          )}
                          {s.status === 'connected' && s.methods.length === 0 ? (
                            <div class="cap-desc"><em class="never">no methods exposed</em></div>
                          ) : null}
                          {s.methods.length > 0 && (
                            <div class="mcp-methods">
                              {s.methods.map((m) => (
                                <div class="mcp-method">
                                  <div class="cap-row-head">
                                    <code class="cap-name">{m.methodName}</code>
                                    <span class="cap-usage">
                                      {m.callCount30d === 0 ? (
                                        <em class="never">never invoked (30d)</em>
                                      ) : (
                                        <>
                                          <span class="ct">{m.callCount30d}</span>{' '}
                                          {m.callCount30d === 1 ? 'call' : 'calls'} (30d)
                                        </>
                                      )}
                                      {m.lastInvoked && (
                                        <span class="last"> · last {ageLabel(m.lastInvoked)}</span>
                                      )}
                                    </span>
                                  </div>
                                  {m.description && <div class="cap-desc">{m.description}</div>}
                                </div>
                              ))}
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <div class="cap-detail-block">
                  <div class="cap-detail-head">
                    <span class="cap-detail-label">Verbs</span>
                    <span class="cap-detail-count">{capabilities.verbs.length} live</span>
                  </div>
                  {capabilities.verbs.length === 0 ? (
                    <EmptyState>No live verbs yet. <code>.md</code> files under <code>verbs/</code> become the moves I can run.</EmptyState>
                  ) : (
                    <div class="cap-list">
                      {capabilities.verbs.map((v) => (
                        <div class="cap-row">
                          <div class="cap-row-head">
                            <code class="cap-name">{v.slug}</code>
                            <span class="cap-mode">{outcomeBadge(v.outcomes)}</span>
                            <span class="cap-usage">
                              {v.invocationCount30d === 0 ? (
                                <em class="never">never invoked (30d)</em>
                              ) : (
                                <>
                                  <span class="ct">{v.invocationCount30d}</span>{' '}
                                  {v.invocationCount30d === 1 ? 'invocation' : 'invocations'} (30d)
                                </>
                              )}
                              {v.lastInvoked && (
                                <span class="last"> · last {ageLabel(v.lastInvoked)}</span>
                              )}
                            </span>
                          </div>
                          <div class="cap-desc">{v.description}</div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <div class="cap-detail-block">
                  <div class="cap-detail-head">
                    <span class="cap-detail-label">Reference data</span>
                    <span class="cap-detail-count">
                      {capabilities.refData.length}{' '}
                      {capabilities.refData.length === 1 ? 'file' : 'files'} · lib/
                    </span>
                  </div>
                  {capabilities.refData.length === 0 ? (
                    <EmptyState>Nothing under <code>lib/</code> yet. YAML files there anchor the facts I read from.</EmptyState>
                  ) : (
                    <div class="cap-list">
                      {capabilities.refData.map((r) => (
                        <div class="cap-row">
                          <div class="cap-row-head">
                            <code class="cap-name">lib/{r.filename}</code>
                            <span class="cap-mode">{r.autonomyMode ?? 'unopened'}</span>
                            <span class="cap-usage">
                              {r.lastEditIso ? (
                                <>last edit {ageLabel(r.lastEditIso)}</>
                              ) : (
                                <em class="never">no role edits</em>
                              )}
                            </span>
                          </div>
                          {r.modeHint && <div class="cap-desc">{r.modeHint}</div>}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </>
            )}
          </section>

          <section class="sec" style="margin-top: 5rem;">
            <SectionPill
              colour="teal"
              label="VERBS"
              title="My playbooks"
              counter={liveVerbsCount === 0 && proposedVerbsCount === 0
                ? 'none authored'
                : `${liveVerbsCount} live${proposedVerbsCount > 0 ? ` · ${proposedVerbsCount} pending review` : ''}`}
            />
            {liveVerbsCount === 0 && proposedVerbsCount === 0 ? (
              <div class="empty-pixel">No playbooks yet. `.md` files in <code>verbs/</code> become the moves I can run.</div>
            ) : (
              <>
                {verbs.live.map((v) => (
                  <a class="verb-row-new" href={`/verbs/${verbSlug(v.file)}`}>
                    <span class="file">{v.file}</span>
                    <span class="label">{v.label}</span>
                    <span class="tag">{v.tag}</span>
                  </a>
                ))}
                {verbs.proposed.map((v) => (
                  <div class="verb-row-new proposed">
                    <span class="file">{v.file}</span>
                    <span class="label">{v.label}</span>
                    <span class="tag">PROPOSED</span>
                  </div>
                ))}
              </>
            )}
          </section>

          <section class="sec">
            <SectionPill
              colour="peach"
              label="RECENT EDITS"
              title="What's grown autonomously"
              counter={editsCounter}
            />
            {!autonomy || edits.length === 0 ? (
              <div class="empty-pixel">
                No autonomous edits yet. The surfaces I can grow into are listed in <code>lib/autonomy.yaml</code>.
              </div>
            ) : (
              <>
                {autonomySummary && <div class="autonomy-summary">{autonomySummary}</div>}
                <div class="edits-list">
                  {edits.map((e) => (
                    <div class="edit-row">
                      <span class="sha">{e.short_sha}</span>
                      <span class="date">{formatIsoDate(e.date)}</span>
                      <div class="what">
                        {firstLine(e.message)}
                        {e.files.length > 0 && (
                          <span class="paths">{e.files.join(' · ')}</span>
                        )}
                        <span class="author">{e.author_name} &lt;{e.author_email}&gt;</span>
                      </div>
                    </div>
                  ))}
                </div>
              </>
            )}
          </section>

          <section class="sec">
            <SectionPill
              colour="pink"
              label="REFERENCE DATA"
              title="The world I read from"
              counter="authored · lib/"
            />
            {libFiles.length === 0 ? (
              <div class="empty-pixel">
                Nothing under <code>lib/</code> yet. YAML files there anchor the facts I read from.
              </div>
            ) : (
              <div class="ref-list">
                {libFiles.map((f) => <code>{f}</code>)}
              </div>
            )}
          </section>
        </>
      )}
    </div>
  </main>

  <style>
    /* Capability detail — the runtime tools the role can actually invoke.
       Lives under #capabilities on /role, merged in from the now-redirected
       /capabilities surface. Each sub-block (chat tools, MCP servers, verbs,
       reference data) is introduced by a mono sub-heading rather than its own
       SectionPill so the section reads as one coherent block under the
       purple "CAPABILITY DETAIL" pill. */
    .deep-capabilities .cap-detail-block + .cap-detail-block {
      margin-top: 1.6rem;
    }
    .cap-detail-head {
      display: flex;
      align-items: baseline;
      gap: 0.7rem;
      margin-bottom: 0.55rem;
      padding-bottom: 0.35rem;
      border-bottom: 1px dashed var(--rule);
    }
    .cap-detail-label {
      font-family: var(--mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ink);
    }
    .cap-detail-count {
      margin-left: auto;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--ink-muted);
    }
    .cap-list {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .cap-row {
      padding: 0.55rem 0.7rem;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: 3px;
      font-size: 12.5px;
    }
    .cap-row-head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .cap-name {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--ink);
    }
    .cap-mode {
      font-family: var(--mono);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-faint);
    }
    .cap-usage {
      margin-left: auto;
      font-size: 12px;
      color: var(--ink-muted);
    }
    .cap-usage .ct {
      color: var(--ink);
      font-weight: 600;
    }
    .cap-usage .last {
      color: var(--ink-faint);
    }
    .cap-usage .never {
      font-style: italic;
      color: var(--ink-faint);
    }
    .cap-desc {
      margin-top: 0.3rem;
      font-size: 12px;
      color: var(--ink-soft);
      line-height: 1.45;
      font-family: var(--prose);
    }
    .mcp-status {
      font-family: var(--mono);
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.05rem 0.4rem;
      border-radius: 2px;
