---
import StatsStrip from '@/components/notebook/StatsStrip.astro';
import OutputEntry from '@/components/output/OutputEntry.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import FilterChips, {
  type ChipOption,
} from '@/components/shared/FilterChips.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { personaNameFrom } from '@/lib/chat/persona-name';
import { listOutputs } from '@/lib/output/loader';
import {
  OUTPUT_TYPE_ENUM,
  type OutputSummary,
  type OutputType,
} from '@/lib/output/types';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import { buildChipHref } from '@/lib/ui/filter-href';
import { daysSince } from '@/lib/ui/time';

/**
 * /output — journal-shaped overview of the role's work product. Replaces the
 * 5-primitive-card grid with a hero + filter rows + gutter-rail entries that
 * link to the focused reader. Filter rows live in `?type=&age=` query params
 * for shareability; the page applies them server-side.
 */

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, outputsRes] = await Promise.allSettled([
  parsePersona(roleHome),
  listOutputs(roleHome),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const personaName = personaNameFrom(persona);
const outputs: OutputSummary[] = outputsRes.status === 'fulfilled' ? outputsRes.value : [];
const loadError = outputsRes.status === 'rejected' ? String(outputsRes.reason) : null;

const updatedAt = nowIso();

const typeCounts: Record<string, number> = {};
for (const o of outputs) typeCounts[o.type] = (typeCounts[o.type] ?? 0) + 1;

const thisWeek = outputs.filter((o) => {
  const d = daysSince(o.updated);
  return d !== null && d <= 7;
}).length;

const drafts = outputs.filter((o) => o.type === 'draft').length;
const archived = outputs.filter((o) => o.status === 'archived').length;

// Filter parsing — accept any value but normalise to the known keyset.
const KNOWN_TYPES = new Set(['all', ...(OUTPUT_TYPE_ENUM as readonly string[])]);
const KNOWN_AGES = new Set(['any', 'week', 'month', 'stale']);
const rawType = Astro.url.searchParams.get('type') ?? 'all';
const rawAge = Astro.url.searchParams.get('age') ?? 'any';
const activeType = KNOWN_TYPES.has(rawType) ? rawType : 'all';
const activeAge = KNOWN_AGES.has(rawAge) ? rawAge : 'any';

function ageMatches(o: OutputSummary, axis: string): boolean {
  if (axis === 'any') return true;
  const d = daysSince(o.updated);
  if (d === null) return false;
  if (axis === 'week') return d <= 7;
  if (axis === 'month') return d <= 30;
  if (axis === 'stale') return d >= 60;
  return true;
}

const filtered = outputs.filter((o) => {
  if (activeType !== 'all' && o.type !== activeType) return false;
  if (!ageMatches(o, activeAge)) return false;
  return true;
});

const OUT_DEFAULTS = { type: 'all', age: 'any' };
const outCurrent = { type: activeType, age: activeAge };

function typeChips(): ChipOption[] {
  const opts: Array<Omit<ChipOption, 'href'>> = [
    { value: 'all', label: 'all', count: outputs.length },
    ...OUTPUT_TYPE_ENUM.map((t) => ({
      value: t as OutputType,
      label: t as string,
      count: typeCounts[t] ?? 0,
    })),
  ];
  return opts.map((o) => ({
    ...o,
    href: buildChipHref({
      pathname: '/output',
      current: outCurrent,
      group: 'type',
      value: o.value,
      defaults: OUT_DEFAULTS,
    }),
  }));
}

function ageChips(): ChipOption[] {
  const ageCounts = { week: 0, month: 0, stale: 0 };
  for (const o of outputs) {
    const d = daysSince(o.updated);
    if (d === null) continue;
    if (d <= 7) ageCounts.week += 1;
    if (d <= 30) ageCounts.month += 1;
    if (d >= 60) ageCounts.stale += 1;
  }
  const opts: Array<Omit<ChipOption, 'href'>> = [
    { value: 'any', label: 'any age' },
    { value: 'week', label: '≤7d', count: ageCounts.week },
    { value: 'month', label: '≤30d', count: ageCounts.month },
    { value: 'stale', label: '60d+ stale', count: ageCounts.stale },
  ];
  return opts.map((o) => ({
    ...o,
    href: buildChipHref({
      pathname: '/output',
      current: outCurrent,
      group: 'age',
      value: o.value,
      defaults: OUT_DEFAULTS,
    }),
  }));
}

const title = persona ? `What ${personaName.short} has produced` : "What I've produced";
const sub = persona
  ? `${personaName.short}'s work product — documents, drafts, records, plans, references — newest first.`
  : "The role's work product — documents, drafts, records, plans, references — newest first.";
---

<BaseLayout title={persona ? `Output · ${personaName.full}` : 'Output · Praxis'}>
  <main class="container">
    <RouteHeader
      current="output"
      personaName={persona ? personaName.full : ''}
      updatedAt={updatedAt}
    />

    <section class="nb-hero">
      <div class="hero-left">
        <div class="pill purple">OUTPUT</div>
        <h1>{title}</h1>
        <div class="sub">{sub}</div>
      </div>
      <StatsStrip
        colour="purple"
        stats={[
          { label: 'this week', value: thisWeek > 0 ? `+${thisWeek}` : '0', accent: true },
          { label: 'total', value: outputs.length },
          { label: 'drafts', value: drafts },
          { label: 'archived', value: archived },
        ]}
      />
    </section>

    {loadError ? (
      <div class="nb-empty">Failed to load output: {loadError}</div>
    ) : outputs.length === 0 ? (
      <div class="nb-empty">
        No output yet. Drafts, notes, plans, records — they'll all show up here as {personaName.short || 'the role'} writes.
      </div>
    ) : (
      <>
        <section class="nb-filters">
          <FilterChips label="type" current={activeType} options={typeChips()} />
          <FilterChips label="age" current={activeAge} options={ageChips()} />
        </section>

        {filtered.length === 0 ? (
          <div class="nb-empty">
            Nothing matches these filters.{' '}
            <a href="/output" class="clear-filters">clear filters →</a>
          </div>
        ) : (
          <section class="entries">
            {filtered.map((o) => <OutputEntry output={o} />)}
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>

<style>
  .nb-hero .hero-left .pill.purple {
    background: var(--purple);
    color: var(--surface);
  }
</style>
