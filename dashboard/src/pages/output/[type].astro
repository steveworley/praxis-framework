---
import StatsStrip from '@/components/notebook/StatsStrip.astro';
import OutputEntry from '@/components/output/OutputEntry.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import FilterChips, {
  type ChipOption,
} from '@/components/shared/FilterChips.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { personaNameFrom } from '@/lib/chat/persona-name';
import { listOutputs } from '@/lib/output/loader';
import {
  OUTPUT_TYPE_ENUM,
  STATUS_ENUM,
  type OutputStatus,
  type OutputSummary,
  type OutputType,
} from '@/lib/output/types';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import { buildChipHref } from '@/lib/ui/filter-href';
import { daysSince } from '@/lib/ui/time';

/**
 * /output/[type] — type-scoped listing in the journal-shaped shell. The hero
 * + filter rows mirror /output/index, with the type chip locked to the route
 * param so the operator's mental model stays "I'm in the type's view".
 * Status and entity_type filters live alongside as additional query keys.
 */

export const prerender = false;

const typeParam = String(Astro.params['type'] ?? '');
if (!(OUTPUT_TYPE_ENUM as readonly string[]).includes(typeParam)) {
  return new Response('Unknown output type', { status: 404 });
}
const type = typeParam as OutputType;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const statusFilter = Astro.url.searchParams.get('status');
const entityTypeFilter = Astro.url.searchParams.get('entity_type');

const listOpts: Parameters<typeof listOutputs>[1] = { type };
if (statusFilter && (STATUS_ENUM as readonly string[]).includes(statusFilter)) {
  listOpts.status = statusFilter as OutputStatus;
}
if (type === 'record' && entityTypeFilter) listOpts.entityType = entityTypeFilter;

const [personaRes, entriesRes, allOfTypeRes] = await Promise.allSettled([
  parsePersona(roleHome),
  listOutputs(roleHome, listOpts),
  listOutputs(roleHome, { type }),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const personaName = personaNameFrom(persona);
const entries: OutputSummary[] = entriesRes.status === 'fulfilled' ? entriesRes.value : [];
const allOfType: OutputSummary[] = allOfTypeRes.status === 'fulfilled' ? allOfTypeRes.value : [];

const statusCounts: Record<string, number> = {};
for (const e of allOfType) {
  statusCounts[e.status] = (statusCounts[e.status] ?? 0) + 1;
}

const updatedAt = nowIso();

// Stats — focused on the type's own slice.
const thisWeek = allOfType.filter((o) => {
  const d = daysSince(o.updated);
  return d !== null && d <= 7;
}).length;

const TYPE_BLURBS: Record<OutputType, string> = {
  document: 'Long-form prose: briefs, notes, analyses.',
  draft: 'Outgoing communication waiting to be sent.',
  record: 'Entity-tied observations: reads, calls, meetings.',
  plan: 'Multi-step intent with a checklist.',
  reference: 'Reusable knowledge: heuristics, recipes, calibrations.',
};

const TYPE_DEFAULTS = { status: 'all', entity_type: 'all' };
const typeCurrent = {
  status: statusFilter ?? 'all',
  entity_type: entityTypeFilter ?? 'all',
};

function statusChips(): ChipOption[] {
  const opts: Array<Omit<ChipOption, 'href'>> = [
    { value: 'all', label: 'all', count: allOfType.length },
    ...STATUS_ENUM.filter((s) => (statusCounts[s] ?? 0) > 0).map((s) => ({
      value: s,
      label: s as string,
      count: statusCounts[s] ?? 0,
    })),
  ];
  return opts.map((o) => ({
    ...o,
    href: buildChipHref({
      pathname: `/output/${type}`,
      current: typeCurrent,
      group: 'status',
      value: o.value,
      defaults: TYPE_DEFAULTS,
    }),
  }));
}

function entityChips(): ChipOption[] {
  const counts: Record<string, number> = {};
  for (const e of allOfType) {
    const et = typeof e.extras['entity_type'] === 'string' ? e.extras['entity_type'] : '';
    if (!et) continue;
    counts[et] = (counts[et] ?? 0) + 1;
  }
  const opts: Array<Omit<ChipOption, 'href'>> = [
    { value: 'all', label: 'all', count: allOfType.length },
    ...Object.entries(counts)
      .map(([k, c]) => ({ value: k, label: k, count: c }))
      .sort((a, b) => a.value.localeCompare(b.value)),
  ];
  return opts.map((o) => ({
    ...o,
    href: buildChipHref({
      pathname: `/output/${type}`,
      current: typeCurrent,
      group: 'entity_type',
      value: o.value,
      defaults: TYPE_DEFAULTS,
    }),
  }));
}

// Type-row chips — let the operator hop between types from inside any
// type-scoped view. The currently selected route maps to the type chip.
function typeChips(): ChipOption[] {
  return [
    { value: 'all', label: 'all', href: '/output' },
    ...OUTPUT_TYPE_ENUM.map((t) => ({
      value: t as string,
      label: t as string,
      href: `/output/${t}`,
    })),
  ];
}

const title = persona ? `${personaName.short}'s ${type}s` : `What I've produced — ${type}s`;
---

<BaseLayout title={`${type} · Output · Praxis`}>
  <main class="container">
    <RouteHeader
      current="output"
      personaName={persona ? personaName.full : ''}
      updatedAt={updatedAt}
    />

    <section class="nb-hero">
      <div class="hero-left">
        <div class="pill purple">OUTPUT · {type.toUpperCase()}</div>
        <h1>{title}</h1>
        <div class="sub">{TYPE_BLURBS[type]}</div>
      </div>
      <StatsStrip
        colour="purple"
        stats={[
          { label: 'this week', value: thisWeek > 0 ? `+${thisWeek}` : '0', accent: true },
          { label: `total ${type}`, value: allOfType.length },
          { label: 'showing', value: entries.length },
        ]}
      />
    </section>

    <section class="nb-filters">
      <FilterChips label="type" current={type} options={typeChips()} />
      <FilterChips label="status" current={statusFilter ?? 'all'} options={statusChips()} />
      {type === 'record' && (
        <FilterChips
          label="entity"
          current={entityTypeFilter ?? 'all'}
          options={entityChips()}
        />
      )}
    </section>

    {entries.length === 0 ? (
      statusFilter || entityTypeFilter ? (
        <div class="nb-empty">
          Nothing matches these filters.{' '}
          <a href={`/output/${type}`} class="clear-filters">clear filters →</a>
        </div>
      ) : (
        <div class="nb-empty">
          No {type} entries yet. As {personaName.short || 'the role'} writes, they'll appear here.
        </div>
      )
    ) : (
      <section class="entries">
        {entries.map((o) => <OutputEntry output={o} />)}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .nb-hero .hero-left .pill.purple {
    background: var(--purple);
    color: var(--surface);
  }
</style>
