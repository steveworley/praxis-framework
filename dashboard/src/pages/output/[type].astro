---
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { personaNameFrom } from '@/lib/chat/persona-name';
import { listOutputs } from '@/lib/output/loader';
import {
  OUTPUT_TYPE_ENUM,
  STATUS_ENUM,
  type OutputStatus,
  type OutputSummary,
  type OutputType,
} from '@/lib/output/types';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';

/**
 * /output/[type] — table-style listing for one type. Filters: status, and
 * (for records) entity_type/entity_id picked from the existing data.
 */

export const prerender = false;

const typeParam = String(Astro.params['type'] ?? '');
if (!(OUTPUT_TYPE_ENUM as readonly string[]).includes(typeParam)) {
  return new Response('Unknown output type', { status: 404 });
}
const type = typeParam as OutputType;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const url = new URL(Astro.request.url);
const statusFilter = url.searchParams.get('status');
const entityTypeFilter = url.searchParams.get('entity_type');
const entityIdFilter = url.searchParams.get('entity_id');

const listOpts: Parameters<typeof listOutputs>[1] = { type };
if (statusFilter && (STATUS_ENUM as readonly string[]).includes(statusFilter)) {
  listOpts.status = statusFilter as OutputStatus;
}
if (type === 'record' && entityTypeFilter) listOpts.entityType = entityTypeFilter;
if (type === 'record' && entityIdFilter) listOpts.entityId = entityIdFilter;

const [personaRes, entriesRes, allOfTypeRes] = await Promise.allSettled([
  parsePersona(roleHome),
  listOutputs(roleHome, listOpts),
  listOutputs(roleHome, { type }),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const personaName = personaNameFrom(persona);
const entries: OutputSummary[] = entriesRes.status === 'fulfilled' ? entriesRes.value : [];
const allOfType: OutputSummary[] = allOfTypeRes.status === 'fulfilled' ? allOfTypeRes.value : [];

// Status filter chips: build from `allOfType` so counts are stable as the
// operator narrows by entity. Active state from `listOpts.status`.
const statusCounts: Record<string, number> = {};
for (const e of allOfType) {
  statusCounts[e.status] = (statusCounts[e.status] ?? 0) + 1;
}
const statusChips: Array<{ key: string; label: string; count: number; active: boolean }> = [
  { key: 'all', label: 'all', count: allOfType.length, active: !statusFilter },
  ...STATUS_ENUM.filter((s) => (statusCounts[s] ?? 0) > 0).map((s) => ({
    key: s,
    label: s,
    count: statusCounts[s] ?? 0,
    active: statusFilter === s,
  })),
];

// Entity dimension for records.
let entityTypes: Array<{ key: string; count: number }> = [];
if (type === 'record') {
  const m: Record<string, number> = {};
  for (const e of allOfType) {
    const et = typeof e.extras['entity_type'] === 'string' ? e.extras['entity_type'] : '';
    if (!et) continue;
    m[et] = (m[et] ?? 0) + 1;
  }
  entityTypes = Object.entries(m)
    .map(([key, count]) => ({ key, count }))
    .sort((a, b) => a.key.localeCompare(b.key));
}

function detailHref(o: OutputSummary): string {
  if (o.type === 'record') {
    const et = o.extras['entity_type'];
    const eid = o.extras['entity_id'];
    return `/output/record/${et}/${eid}/${o.slug}`;
  }
  return `/output/${o.type}/${o.slug}`;
}

function chipHref(status: string | null): string {
  const u = new URL(Astro.request.url);
  if (status === null || status === 'all') u.searchParams.delete('status');
  else u.searchParams.set('status', status);
  return `${u.pathname}?${u.searchParams.toString()}`.replace(/\?$/, '');
}

function entityHref(et: string | null): string {
  const u = new URL(Astro.request.url);
  if (et === null) {
    u.searchParams.delete('entity_type');
    u.searchParams.delete('entity_id');
  } else {
    u.searchParams.set('entity_type', et);
    u.searchParams.delete('entity_id');
  }
  return `${u.pathname}?${u.searchParams.toString()}`.replace(/\?$/, '');
}

const updatedAt = nowIso();
---

<BaseLayout title={`${type} · Output · Praxis`}>
  <main class="container">
    <RouteHeader
      current="output"
      personaName={persona ? personaName.full : ''}
      updatedAt={updatedAt}
    />

    <div class="type-list">
      <nav class="breadcrumb">
        <a href="/output">output</a>
        <span class="crumb-sep">/</span>
        <span>{type}</span>
      </nav>

      <div class="group-head">
        <span class="group-title">{type}</span>
        <span class="group-counter">
          {entries.length} of {allOfType.length}
        </span>
      </div>

      <div class="chip-row">
        {statusChips.map((c) => (
          <a
            class:list={['chip', c.active && 'active']}
            href={chipHref(c.key)}
          >
            {c.label}<span class="ct">{c.count}</span>
          </a>
        ))}
      </div>

      {type === 'record' && entityTypes.length > 0 && (
        <div class="chip-row">
          <span class="chip-label">entity type:</span>
          <a
            class:list={['chip', !entityTypeFilter && 'active']}
            href={entityHref(null)}
          >all</a>
          {entityTypes.map((et) => (
            <a
              class:list={['chip', entityTypeFilter === et.key && 'active']}
              href={entityHref(et.key)}
            >
              {et.key}<span class="ct">{et.count}</span>
            </a>
          ))}
        </div>
      )}

      {entries.length === 0 ? (
        <div class="empty">
          No {type} entries{statusFilter || entityTypeFilter ? ' matching this filter' : ''}.
        </div>
      ) : (
        <ul class="entries">
          {entries.map((o) => (
            <li class="entry">
              <a href={detailHref(o)} class="entry-link">
                <div class="entry-title-row">
                  <span class="entry-title">{o.title}</span>
                  <span class:list={['out-pill', `st-${o.status}`]}>{o.status}</span>
                </div>
                <div class="entry-meta">
                  <code>{o.path}</code>
                  <span class="dot">·</span>
                  <span>updated {o.updated}</span>
                  {type === 'record' && o.extras['entity_type'] && (
                    <>
                      <span class="dot">·</span>
                      <span>{o.extras['entity_type']} · {o.extras['entity_id']}</span>
                    </>
                  )}
                  {type === 'draft' && typeof o.extras['recipient'] === 'string' && (
                    <>
                      <span class="dot">·</span>
                      <span>to {o.extras['recipient']}</span>
                    </>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>

  <style>
    .type-list {
      margin-top: 1.2rem;
    }
    .breadcrumb {
      font-family: ui-monospace, monospace;
      font-size: 12px;
      color: var(--ink-muted);
      margin-bottom: 0.6rem;
    }
    .breadcrumb a {
      color: var(--ink-soft);
      text-decoration: none;
    }
    .breadcrumb a:hover {
      text-decoration: underline;
    }
    .crumb-sep {
      margin: 0 0.5rem;
      color: var(--ink-faint);
    }
    .group-title {
      text-transform: capitalize;
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 0.8rem 0 1rem;
      align-items: baseline;
    }
    .chip-label {
      font-size: 11.5px;
      color: var(--ink-muted);
      font-family: ui-monospace, monospace;
      margin-right: 0.3rem;
    }
    .chip {
      display: inline-flex;
      align-items: baseline;
      gap: 0.4rem;
      padding: 0.2rem 0.65rem;
      border: 1px solid var(--rule);
      border-radius: 12px;
      text-decoration: none;
      color: var(--ink-soft);
      font-size: 12.5px;
      background: var(--surface);
    }
    .chip:hover {
      border-color: var(--rule-strong);
      color: var(--ink);
    }
    .chip.active {
      background: var(--ink);
      color: var(--surface);
      border-color: var(--ink);
    }
    .chip .ct {
      font-family: ui-monospace, monospace;
      font-size: 11px;
      opacity: 0.7;
    }

    .entries {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0;
    }
    .entry {
      border-top: 1px solid var(--rule);
    }
    .entry:last-child {
      border-bottom: 1px solid var(--rule);
    }
    .entry-link {
      display: block;
      padding: 0.85rem 0;
      text-decoration: none;
      color: inherit;
    }
    .entry-link:hover {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      background: var(--surface-mute);
    }
    .entry-title-row {
      display: flex;
      gap: 0.7rem;
      align-items: baseline;
      flex-wrap: wrap;
      margin-bottom: 0.25rem;
    }
    .entry-title {
      font-size: 14.5px;
      font-weight: 500;
      color: var(--ink);
    }
    .entry-meta {
      font-family: ui-monospace, monospace;
      font-size: 11.5px;
      color: var(--ink-muted);
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .entry-meta code {
      background: none;
      padding: 0;
      color: var(--ink-faint);
      font-size: 11px;
    }
    .entry-meta .dot {
      color: var(--ink-faint);
    }

    .out-pill {
      display: inline-block;
      font-family: ui-monospace, monospace;
      font-size: 10.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 1px 6px;
      border-radius: 2px;
      background: var(--surface-mute);
      color: var(--ink-muted);
    }
    .out-pill.st-review {
      background: #fbeed4;
      color: var(--warn, #946400);
    }
    .out-pill.st-ready {
      background: #e8eef8;
      color: var(--info, #3559a8);
    }
    .out-pill.st-sent {
      background: #e2efe2;
      color: #2e6c2e;
    }
    .out-pill.st-done {
      background: #d9e6dc;
      color: #1f5234;
    }
    .out-pill.st-archived {
      background: var(--surface-deep);
      color: var(--ink-faint);
    }
  </style>
</BaseLayout>
