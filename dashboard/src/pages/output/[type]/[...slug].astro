---
import EmptyState from '@/components/EmptyState.astro';
import DocumentView from '@/components/output/DocumentView.astro';
import DraftView from '@/components/output/DraftView.astro';
import PlanView from '@/components/output/PlanView.astro';
import RecordView from '@/components/output/RecordView.astro';
import ReferenceView from '@/components/output/ReferenceView.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { personaNameFrom } from '@/lib/chat/persona-name';
import { renderMarkdown } from '@/lib/markdown';
import {
  OutputNotFoundError,
  OutputValidationError,
  loadOutput,
} from '@/lib/output/loader';
import { OUTPUT_TYPE_ENUM, type OutputType } from '@/lib/output/types';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';

/**
 * /output/[type]/[...slug] — focused-reader detail page. Loads the file via
 * the loader, dispatches to the per-type renderer based on `meta.type`. For
 * records, the rest-param slug carries the `<entity_type>/<entity_id>/
 * <slug>` path; for other types it's just the slug.
 *
 * Layout vs. the old detail page: no hero, no stats strip, no filters — this
 * is a reading surface. A small back link sits above the rendered article;
 * the per-type renderer supplies the title and prose body. The Fraunces +
 * Source Serif 4 treatment matches notebook entries because the data is
 * the same shape (markdown + frontmatter).
 */

export const prerender = false;

const typeParam = String(Astro.params['type'] ?? '');
if (!(OUTPUT_TYPE_ENUM as readonly string[]).includes(typeParam)) {
  return new Response('Unknown output type', { status: 404 });
}
const type = typeParam as OutputType;
const slugParam = String(Astro.params['slug'] ?? '');

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

let detail;
let error: string | null = null;
let notFound = false;
try {
  detail = await loadOutput(roleHome, type, slugParam);
} catch (e: unknown) {
  if (e instanceof OutputNotFoundError) {
    notFound = true;
  } else if (e instanceof OutputValidationError) {
    error = e.message;
  } else {
    error = e instanceof Error ? e.message : String(e);
  }
}

const personaRes = await parsePersona(roleHome).catch(() => null);
const persona: Persona | null = personaRes ?? null;
const personaName = personaNameFrom(persona);
const updatedAt = nowIso();

const bodyHtml = detail ? renderMarkdown(detail.body) : '';

const pageTitle = detail ? `${detail.meta.title} · Output` : `Output · Praxis`;
---

<BaseLayout title={pageTitle}>
  <main class="container">
    <RouteHeader
      current="output"
      personaName={persona ? personaName.full : ''}
      updatedAt={updatedAt}
    />

    <div class="out-back">
      <a href={`/output/${type}`}>← {type}</a>
    </div>

    {notFound && <EmptyState>Output not found at this path.</EmptyState>}
    {error && <EmptyState>Could not load output: {error}</EmptyState>}

    {detail && (
      <div data-praxis-visuals>
        {type === 'document' && <DocumentView meta={detail.meta} bodyHtml={bodyHtml} />}
        {type === 'draft' && <DraftView meta={detail.meta} bodyHtml={bodyHtml} />}
        {type === 'record' && <RecordView meta={detail.meta} bodyHtml={bodyHtml} />}
        {type === 'plan' && <PlanView meta={detail.meta} body={detail.body} bodyHtml={bodyHtml} />}
        {type === 'reference' && <ReferenceView meta={detail.meta} bodyHtml={bodyHtml} />}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .out-back {
    margin-top: 1.6rem;
    margin-bottom: 0.6rem;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-muted);
  }
  .out-back a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .out-back a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>

<script>
  import { initVisuals } from '@/scripts/visuals.ts';
  initVisuals();
</script>
