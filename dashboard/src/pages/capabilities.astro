---
import EmptyState from '@/components/EmptyState.astro';
import RouteHeader from '@/components/RouteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  loadCapabilities,
  type CapabilitiesReport,
  type VerbOutcomeCounts,
} from '@/lib/capabilities-loader';
import { assembleEscalations } from '@/lib/escalations-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getRoleHome, nowIso } from '@/lib/role-home';
import { daysSince, formatAgeLabel } from '@/lib/ui/time';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const [personaRes, capabilitiesRes, escalationsRes] = await Promise.allSettled([
  parsePersona(roleHome),
  loadCapabilities(roleHome),
  assembleEscalations(roleHome),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const capabilities: CapabilitiesReport | null =
  capabilitiesRes.status === 'fulfilled' ? capabilitiesRes.value : null;
const capabilitiesError =
  capabilitiesRes.status === 'rejected' ? String(capabilitiesRes.reason) : null;
const openCount =
  escalationsRes.status === 'fulfilled' ? escalationsRes.value.countsByStatus.open : 0;

const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
const updatedAt = nowIso();

const now = new Date();

function ageLabel(iso: string | null): string {
  if (!iso) return '';
  return formatAgeLabel(daysSince(iso, now));
}

/** "4s 1p 0f 0s" or "—" when every bucket is zero. */
function outcomeBadge(o: VerbOutcomeCounts): string {
  const total = o.success + o.partial + o.failed + o.skipped;
  if (total === 0) return '—';
  return `${o.success}s ${o.partial}p ${o.failed}f ${o.skipped}s`;
}
---

<BaseLayout title={fullName ? `Capabilities · ${fullName}` : 'Capabilities · Praxis'}>
  <main class="container">
    <RouteHeader
      current="capabilities"
      personaName={fullName}
      escalationOpenCount={openCount}
      updatedAt={updatedAt}
    />

    <div class="page-body">
      {capabilitiesError ? (
        <EmptyState>Failed to load capabilities: {capabilitiesError}</EmptyState>
      ) : !capabilities ? (
        <EmptyState>No capabilities to show.</EmptyState>
      ) : (
        <>
          <div class="group">
            <div class="group-head">
              <span class="group-title">Chat tools</span>
              <span class="group-counter">{capabilities.chatTools.length} native</span>
            </div>
            <div class="cap-list">
              {capabilities.chatTools.map((t) => (
                <div class="cap-row">
                  <div class="cap-row-head">
                    <code class="cap-name">{t.name}</code>
                    <span class="cap-mode">{t.autonomyMode}</span>
                    <span class="cap-usage">
                      {t.callCount30d === 0 ? (
                        <em class="never">never invoked (30d)</em>
                      ) : (
                        <>
                          <span class="ct">{t.callCount30d}</span>{' '}
                          {t.callCount30d === 1 ? 'call' : 'calls'} (30d)
                        </>
                      )}
                      {t.lastInvoked && (
                        <span class="last"> · last {ageLabel(t.lastInvoked)}</span>
                      )}
                    </span>
                  </div>
                  <div class="cap-desc">{t.description}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="group">
            <div class="group-head">
              <span class="group-title">MCP servers</span>
              <span class="group-counter">
                {capabilities.mcps.configured
                  ? `${capabilities.mcps.servers.length} ${capabilities.mcps.servers.length === 1 ? 'server' : 'servers'}`
                  : 'not configured'}
              </span>
            </div>
            {!capabilities.mcps.configured ? (
              <EmptyState>{capabilities.mcps.message}</EmptyState>
            ) : (
              <div class="cap-list">
                {capabilities.mcps.servers.map((s) => (
                  <div class="cap-row mcp-server">
                    <div class="cap-row-head">
                      <code class="cap-name">{s.name}</code>
                      <span class={`mcp-status mcp-status-${s.status}`}>{s.status}</span>
                      <span class={`mcp-allow ${s.allowed ? 'mcp-allow-yes' : 'mcp-allow-no'}`}>
                        {s.allowed ? 'allow' : 'deny'}
                      </span>
                      <span class="cap-usage">
                        <span class="mcp-url">{s.url}</span>
                      </span>
                    </div>
                    {s.status !== 'connected' && s.errorMessage && (
                      <div class="cap-desc mcp-error">{s.errorMessage}</div>
                    )}
                    {s.status === 'connected' && s.methods.length === 0 ? (
                      <div class="cap-desc"><em class="never">no methods exposed</em></div>
                    ) : null}
                    {s.methods.length > 0 && (
                      <div class="mcp-methods">
                        {s.methods.map((m) => (
                          <div class="mcp-method">
                            <div class="cap-row-head">
                              <code class="cap-name">{m.methodName}</code>
                              <span class="cap-usage">
                                {m.callCount30d === 0 ? (
                                  <em class="never">never invoked (30d)</em>
                                ) : (
                                  <>
                                    <span class="ct">{m.callCount30d}</span>{' '}
                                    {m.callCount30d === 1 ? 'call' : 'calls'} (30d)
                                  </>
                                )}
                                {m.lastInvoked && (
                                  <span class="last"> · last {ageLabel(m.lastInvoked)}</span>
                                )}
                              </span>
                            </div>
                            {m.description && <div class="cap-desc">{m.description}</div>}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="group">
            <div class="group-head">
              <span class="group-title">Verbs</span>
              <span class="group-counter">
                {capabilities.verbs.length} live
              </span>
            </div>
            {capabilities.verbs.length === 0 ? (
              <EmptyState>No live verbs. Add `.md` files under `verbs/` to give the role playbooks.</EmptyState>
            ) : (
              <div class="cap-list">
                {capabilities.verbs.map((v) => (
                  <div class="cap-row">
                    <div class="cap-row-head">
                      <code class="cap-name">{v.slug}</code>
                      <span class="cap-mode">{outcomeBadge(v.outcomes)}</span>
                      <span class="cap-usage">
                        {v.invocationCount30d === 0 ? (
                          <em class="never">never invoked (30d)</em>
                        ) : (
                          <>
                            <span class="ct">{v.invocationCount30d}</span>{' '}
                            {v.invocationCount30d === 1 ? 'invocation' : 'invocations'} (30d)
                          </>
                        )}
                        {v.lastInvoked && (
                          <span class="last"> · last {ageLabel(v.lastInvoked)}</span>
                        )}
                      </span>
                    </div>
                    <div class="cap-desc">{v.description}</div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="group">
            <div class="group-head">
              <span class="group-title">Reference data</span>
              <span class="group-counter">
                {capabilities.refData.length}{' '}
                {capabilities.refData.length === 1 ? 'file' : 'files'} · lib/
              </span>
            </div>
            {capabilities.refData.length === 0 ? (
              <EmptyState>No reference data. Add YAML files to `lib/` to anchor the role's facts.</EmptyState>
            ) : (
              <div class="cap-list">
                {capabilities.refData.map((r) => (
                  <div class="cap-row">
                    <div class="cap-row-head">
                      <code class="cap-name">lib/{r.filename}</code>
                      <span class="cap-mode">{r.autonomyMode ?? 'unopened'}</span>
                      <span class="cap-usage">
                        {r.lastEditIso ? (
                          <>last edit {ageLabel(r.lastEditIso)}</>
                        ) : (
                          <em class="never">no role edits</em>
                        )}
                      </span>
                    </div>
                    {r.modeHint && <div class="cap-desc">{r.modeHint}</div>}
                  </div>
                ))}
              </div>
            )}
          </div>
        </>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .cap-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cap-row {
    padding: 0.55rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 3px;
    font-size: 12.5px;
  }
  .cap-row-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cap-name {
    font-family: ui-monospace, monospace;
    font-size: 12.5px;
    color: var(--ink);
  }
  .cap-mode {
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  .cap-usage {
    margin-left: auto;
    font-size: 12px;
    color: var(--ink-muted);
  }
  .cap-usage .ct {
    color: var(--ink);
    font-weight: 600;
  }
  .cap-usage .last {
    color: var(--ink-faint);
  }
  .cap-usage .never {
    font-style: italic;
    color: var(--ink-faint);
  }
  .cap-desc {
    margin-top: 0.3rem;
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .mcp-status {
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.05rem 0.4rem;
    border-radius: 2px;
    border: 1px solid var(--rule);
  }
  .mcp-status-connected {
    color: var(--ink);
    border-color: var(--rule);
  }
  .mcp-status-unreachable,
  .mcp-status-error {
    color: var(--ink-muted);
    font-style: italic;
  }
  .mcp-allow {
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.05rem 0.4rem;
    border-radius: 2px;
    border: 1px solid var(--rule);
  }
  .mcp-allow-yes {
    color: var(--ink);
  }
  .mcp-allow-no {
    color: var(--ink-faint);
    font-style: italic;
  }
  .mcp-url {
    font-family: ui-monospace, monospace;
    color: var(--ink-faint);
    font-size: 11.5px;
  }
  .mcp-error {
    font-style: italic;
    color: var(--ink-muted);
  }
  .mcp-methods {
    margin-top: 0.5rem;
    margin-left: 0.9rem;
    padding-left: 0.7rem;
    border-left: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .mcp-method {
    font-size: 12px;
  }
</style>
