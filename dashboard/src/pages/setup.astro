---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SetupWizard from '@/components/wizard/SetupWizard.astro';
import { detectMode, getRoleHome } from '@/lib/role-home';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
const alreadySeeded = mode === 'role';
---

<BaseLayout title="Set up role — Praxis">
  <main class="container">
    <div class="app-head">
      <div>
        <span class="app-brand">PRAXIS<span class="name">setup</span></span>
      </div>
      <div class="app-head-meta"><code>{roleHome}</code></div>
    </div>
    {alreadySeeded ? (
      <div class="wizard">
        <div class="wizard-card">
          <h1>This role is already set up</h1>
          <p>
            <code>persona.md</code> exists at this role's home, so the wizard has nothing to do.
            Open the dashboard to see the populated role.
          </p>
          <div class="wizard-actions">
            <span></span>
            <a class="btn btn-primary" href="/">Go to dashboard</a>
          </div>
        </div>
      </div>
    ) : (
      <SetupWizard />
    )}
  </main>
</BaseLayout>
