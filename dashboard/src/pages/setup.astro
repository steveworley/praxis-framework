---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SetupWizard from '@/components/wizard/SetupWizard.astro';
import { detectMode, getRoleHome } from '@/lib/role-home';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
const alreadySeeded = mode === 'role';
---

<BaseLayout title="Set up role — Praxis">
  <main class="container setup-container">
    <div class="setup-brand-strip">
      <a class="px-logo" aria-label="PRAXIS" href="/">
        <span>P</span><span>R</span><span>A</span><span>X</span><span>I</span><span>S</span>
      </a>
      <span class="sep">·</span>
      <span class="role-tag">SETUP</span>
      <span class="meta">
        <span class="setup-path-line"
          >setting up role at <code>{roleHome}</code></span
        >
      </span>
    </div>

    {
      alreadySeeded ? (
        <section class="setup-seeded">
          <div class="setup-seeded-marker">⌗ already growing</div>
          <h1 class="setup-seeded-title">This role is already growing.</h1>
          <p class="setup-seeded-prose">
            <code>persona.md</code> already exists at this role's home, so the
            wizard has nothing more to do. The role is live — you can see how
            they sound, what they're responsible for, and what they're
            currently raising for review.
          </p>
          <div class="setup-seeded-actions">
            <a class="setup-cta setup-cta-pink" href="/">
              Go see them <span class="setup-cta-arrow">→</span>
            </a>
          </div>
        </section>
      ) : (
        <SetupWizard />
      )
    }
  </main>
</BaseLayout>
