---
import ActivityFeed from '@/components/ActivityFeed.astro';
import EscalationFeed from '@/components/EscalationFeed.astro';
import InhibitionsCard from '@/components/InhibitionsCard.astro';
import MemoryFeed from '@/components/MemoryFeed.astro';
import PersonaHero from '@/components/PersonaHero.astro';
import VoiceCard from '@/components/VoiceCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assembleActivity, type ActivityEntry } from '@/lib/activity-loader';
import { assembleEscalations, type EscalationsResult } from '@/lib/escalations-loader';
import { assembleMemory, type MemoryEntry } from '@/lib/memory-loader';
import { parsePersona, type Persona } from '@/lib/persona-parser';
import { detectMode, getLogGlob, getRoleHome, nowIso } from '@/lib/role-home';

export const prerender = false;

const roleHome = getRoleHome();
const mode = detectMode(roleHome);
if (mode === 'seed') {
  return Astro.redirect('/setup');
}

const logGlob = getLogGlob();

// Section-by-section error handling: one failed loader shouldn't blank the
// page. We surface per-section errors below.
const [personaRes, memoryRes, escalationsRes, activityRes] = await Promise.allSettled([
  parsePersona(roleHome),
  assembleMemory(roleHome),
  assembleEscalations(roleHome),
  assembleActivity(roleHome, logGlob, 200),
]);

const persona: Persona | null = personaRes.status === 'fulfilled' ? personaRes.value : null;
const personaError = personaRes.status === 'rejected' ? String(personaRes.reason) : null;
const memoryEntries: MemoryEntry[] | null = memoryRes.status === 'fulfilled' ? memoryRes.value : null;
const memoryError = memoryRes.status === 'rejected' ? String(memoryRes.reason) : null;
const escalations: EscalationsResult | null = escalationsRes.status === 'fulfilled' ? escalationsRes.value : null;
const escalationsError = escalationsRes.status === 'rejected' ? String(escalationsRes.reason) : null;
const activity: ActivityEntry[] | null = activityRes.status === 'fulfilled' ? activityRes.value : null;
const activityError = activityRes.status === 'rejected' ? String(activityRes.reason) : null;

const updatedAt = nowIso();
const fullName = persona?.identity['full_name'] ?? persona?.identity['name'] ?? '';
---

<BaseLayout title={fullName ? `Interior — ${fullName}` : 'Interior — Praxis'}>
  <header class="header">
    <div>
      <span class="header-title">
        Interior {fullName && <em>· {fullName}</em>}
      </span>
    </div>
    <div class="header-right">
      <span class="meta-text">Updated {updatedAt}</span>
      <button type="button" class="refresh-btn" onclick="window.location.reload()">Refresh</button>
    </div>
  </header>

  <main class="container">
    {persona ? (
      <PersonaHero persona={persona} />
    ) : (
      <div class="hero">
        <div class="hero-name">—</div>
        <div class="hero-tagline">Failed to parse persona: {personaError ?? 'no agents/persona.md found'}</div>
      </div>
    )}

    <div class="section">
      <div class="section-title">What this role anchors on</div>
      <div class="anchors-grid">
        <VoiceCard voice={persona?.voice ?? []} />
        <InhibitionsCard inhibitions={persona?.inhibitions ?? []} />
      </div>
    </div>

    <EscalationFeed result={escalations} error={escalationsError} />
    <MemoryFeed entries={memoryEntries} error={memoryError} />
    <ActivityFeed entries={activity} error={activityError} />
  </main>

  <script is:inline>
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      // Filter button clicks (escalation + memory feeds).
      const filterBtn = target.closest('[data-filter]');
      if (filterBtn instanceof HTMLElement) {
        const group = filterBtn.closest('[data-filter-group]');
        if (group instanceof HTMLElement) {
          const groupName = group.dataset.filterGroup;
          const filter = filterBtn.dataset.filter;
          if (!groupName || !filter) return;
          group.querySelectorAll('[data-filter]').forEach((b) => b.classList.remove('active'));
          filterBtn.classList.add('active');
          const feed = document.querySelector(`[data-filter-feed="${groupName}"]`);
          if (!(feed instanceof HTMLElement)) return;
          const cards = feed.children;
          for (const card of cards) {
            if (!(card instanceof HTMLElement)) continue;
            const matchKey = groupName === 'escalation' ? card.dataset.status : card.dataset.category;
            card.style.display = filter === 'all' || matchKey === filter ? '' : 'none';
          }
          return;
        }
      }

      // Proposed-skill draft toggle.
      const toggle = target.closest('[data-pd-target]');
      if (toggle instanceof HTMLElement) {
        const id = toggle.dataset.pdTarget;
        if (!id) return;
        const draft = document.getElementById(id);
        if (draft) draft.hidden = !draft.hidden;
      }
    });
  </script>
</BaseLayout>
