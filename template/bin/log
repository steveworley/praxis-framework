#!/usr/bin/env python3
"""Append a structured JSONL entry to today's campaign log.

Wraps the `python3 -c "import json; ..."` pattern Sam used to write inline
every time she logged an action. Use this from any Bash invocation:

    bin/log --campaign=test-2026 --agent=draft-emails --action=email_drafted \\
            --prospect=acme --details='Drafted opener'

    bin/log --campaign=manual-leads --agent=monitor-channels \\
            --action=channel_intake channel=notifications-searchai message_ts=1234.5

Required: --campaign, --agent, --action.
Optional flags: --prospect, --details, --subject, --echo.
Free-form: trailing key=value pairs get merged into the entry.

Path: {repo_root}/campaigns/{campaign}/logs/{YYYY-MM-DD}.jsonl, where the
repo root is $SAMS_HOME if set, otherwise the nearest ancestor of cwd that
contains a `campaigns/` directory. Timestamp is local time with timezone.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path


def find_repo_root(start: Path) -> Path:
    """Walk up from `start` until we find a directory containing campaigns/."""
    cur = start.resolve()
    while True:
        if (cur / "campaigns").is_dir():
            return cur
        if cur.parent == cur:
            raise SystemExit(
                "Could not locate a `campaigns/` directory walking up from "
                f"{start}. Run from inside the role's repo, or set SAMS_HOME."
            )
        cur = cur.parent


def parse_extra(pairs: list[str]) -> dict[str, str]:
    """Parse trailing `key=value` arguments into a dict."""
    out: dict[str, str] = {}
    for p in pairs:
        if "=" not in p:
            raise SystemExit(f"Extra arg must be key=value (got: {p!r})")
        k, v = p.split("=", 1)
        if not k:
            raise SystemExit(f"Extra arg has empty key: {p!r}")
        out[k] = v
    return out


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="bin/log",
        description="Append a JSONL entry to today's campaign log.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  bin/log --campaign=test-2026 --agent=draft-emails "
            "--action=email_drafted --prospect=acme --details='Drafted opener'\n"
            "  bin/log --campaign=manual-leads --agent=monitor-channels "
            "--action=channel_intake channel=notifications-searchai message_ts=1234.5"
        ),
    )
    parser.add_argument("--campaign", required=True, help="campaign id (e.g. manual-leads)")
    parser.add_argument("--agent", required=True, help="agent name (e.g. draft-emails)")
    parser.add_argument("--action", required=True, help="action verb (e.g. email_drafted)")
    parser.add_argument("--prospect", default=None, help="prospect id (optional)")
    parser.add_argument("--details", default=None, help="short narrative (optional)")
    parser.add_argument("--subject", default=None, help="email subject (optional)")
    parser.add_argument("--echo", action="store_true", help="print the JSON line that was written")
    parser.add_argument("extra", nargs="*", help="extra key=value pairs to merge into the entry")
    args = parser.parse_args()

    extras = parse_extra(args.extra)

    sams_home = os.environ.get("SAMS_HOME")
    if sams_home:
        root = Path(sams_home).expanduser().resolve()
        if not (root / "campaigns").is_dir():
            raise SystemExit(f"SAMS_HOME does not contain a campaigns/ dir: {root}")
    else:
        root = find_repo_root(Path.cwd())

    campaign_dir = root / "campaigns" / args.campaign
    if not campaign_dir.is_dir():
        raise SystemExit(
            f"Campaign directory does not exist: {campaign_dir}. "
            "Create it before logging, or check the campaign id."
        )

    logs_dir = campaign_dir / "logs"
    logs_dir.mkdir(exist_ok=True)

    now = datetime.now().astimezone()
    today = now.date().isoformat()
    log_path = logs_dir / f"{today}.jsonl"

    # Ordered: timestamp first, then conventional fields, then extras.
    record: dict[str, object] = {"timestamp": now.isoformat(timespec="seconds")}
    flag_fields: dict[str, str | None] = {
        "agent": args.agent,
        "action": args.action,
        "prospect_id": args.prospect,
        "campaign_id": args.campaign,
        "details": args.details,
        "subject": args.subject,
    }
    for k, v in flag_fields.items():
        if v is not None:
            record[k] = v
    for k, v in extras.items():
        if k in record:
            print(f"warning: extra '{k}' shadowed by flag value", file=sys.stderr)
            continue
        record[k] = v

    line = json.dumps(record, ensure_ascii=False)
    with log_path.open("a", encoding="utf-8") as f:
        f.write(line + "\n")

    if args.echo:
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
