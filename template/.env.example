# Anthropic API key for the dashboard's /chat surface.
# Generate at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — MCP servers wired into /chat. Format:
#   name=http://service:port[,name=http://service:port]
# Each entry must match a service in docker-compose.yml.
# PRAXIS_MCPS=

# Optional — maximum model/tool round trips in one chat turn. Default 10.
# Raise it for verbs that chain other verbs (e.g. a daily brief). Positive
# integers only; invalid values fall back to 10, values above 100 clamp to 100.
# PRAXIS_MAX_TOOL_ITERATIONS=10
